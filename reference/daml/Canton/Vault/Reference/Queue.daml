-- | What the queued vaults share: pinned factories, allocation checks, struck prices and reports.
module Canton.Vault.Reference.Queue where

import DA.List (dedup, sort, unique)
import DA.Map qualified as Map
import DA.Optional (isSome)
import DA.TextMap qualified as TextMap
import DA.Time (isLedgerTimeGE)

import Canton.Vault.V1 (requestPricingKey)
import Canton.Vault.EventLog.V1
import Canton.Vault.Reference.Log

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.AllocationV2 qualified as V2
import Splice.Api.Token.AllocationInstructionV2 qualified as V2
import Splice.Api.Token.AllocationRequestV2 qualified as AR
import Splice.TokenStandard.Utils

-- | The settlement id every allocation for a request to the vault carries, beside a contract id naming the request.
requestSettlementId : Text -> Text
requestSettlementId vaultId = vaultId <> "/requests"

-- | The transfer leg id for one leg of one request: its requester, their label, and which leg it is.
requestLegId : Party -> Text -> Text -> Text
requestLegId requester label leg =
  partyToText requester <> "/" <> label <> "/" <> leg

-- | The registrar's account a redemption escrows its shares to, holding them until they are burned or returned.
redemptionAccount : Party -> V2.Account
redemptionAccount registrar = V2.Account with owner = Some registrar; provider = None; id = "redemptions"

-- | When the queued vaults strike a request's rate: once its period has closed.
requestPolicies : Metadata
requestPolicies = Metadata with values = TextMap.fromList [(requestPricingKey, "period-close")]

data Factories = Factories with
    allocationFactory : ContractId V2.AllocationFactory
    settlementFactory : ContractId V2.SettlementFactory
  deriving (Show, Eq, Serializable)

-- | A request's settlement reference: its allocations name it, so none can settle another request.
template RequestAnchor
  with
    vaultId : Text
    vaultRegistrar : Party
    executors : [Party]
    requester : Party
    receiver : Party
      -- ^ Sees the anchor, so declining the request can end it.
  where
    signatory vaultRegistrar
    observer requester, receiver, executors

-- | The allocations a queued request needs, published for wallets as the token standard's allocation request.
template RequestAllocations
  with
    vaultId : Text
    vaultRegistrar : Party
    executors : [Party]
    requester : Party
    receiver : Party
    label : Text
    amount : Decimal
      -- ^ The underlying deposited, or the shares redeemed.
    minOut : Optional Decimal
    epoch : Int
      -- ^ The period the request was made in, which is its id.
    anchor : ContractId RequestAnchor
    settlement : V2.SettlementInfo
    escrow : V2.AllocationSpecification
      -- ^ The requester's escrow, exactly as it must be allocated.
    authorization : V2.AllocationSpecification
      -- ^ The receiver's authorization, exactly as it must be allocated.
    requestedAt : Time
    fundBy : Time
      -- ^ The end of the request's period: allocations are bound before it, so none is made knowing the price.
  where
    signatory vaultRegistrar
    observer requester, receiver, executors

    choice RequestAllocations_Expire : ()
      -- ^ Drop a request whose allocations were not bound in its period.
      controller vaultRegistrar
      do
        over <- isLedgerTimeGE fundBy
        require "the request's period has ended" over
        endUnfunded this [vaultRegistrar] CR_Expired

    interface instance AR.AllocationRequest for RequestAllocations where
      view = AR.AllocationRequestView with
        originalRequestCid = None
        settlement
        allocations = [escrow, authorization]
        requestedAt
        settleAt = Some fundBy
        availableActions = Map.fromList [(AR.ARA_Accept, parties), (AR.ARA_Reject, parties)]
        meta = emptyMetadata
          where parties = dedup [[requester], [receiver]]
      allocationRequest_acceptImpl _self _arg = pure AR.AllocationRequest_AcceptResult with meta = emptyMetadata
      allocationRequest_rejectImpl self arg = do
        require "the requester or the receiver declines" (arg.actors `elem` [[requester], [receiver]])
        archive (fromInterfaceContractId @RequestAllocations self)
        endUnfunded this arg.actors CR_Cancelled
        pure AR.AllocationRequest_RejectResult with meta = emptyMetadata
      allocationRequest_withdrawImpl self arg = do
        require "the executors withdraw" (sort arg.actors == sort executors)
        archive (fromInterfaceContractId @RequestAllocations self)
        endUnfunded this arg.actors CR_Rejected
        pure AR.AllocationRequest_WithdrawResult with meta = emptyMetadata
      allocationRequest_acceptExtraObservers _arg = []
      allocationRequest_rejectExtraObservers _arg = []
      allocationRequest_withdrawExtraObservers _arg = []

-- | Ends a request no allocation was bound to, reporting why; nothing was queued, so nothing leaves the queue.
endUnfunded : RequestAllocations -> [Party] -> CloseReason -> Update ()
endUnfunded r actors reason = do
  archive r.anchor
  report r.vaultRegistrar r.vaultId [Report with
    owner = r.escrow.authorizer; receiver = r.authorization.authorizer; actors; meta = emptyMetadata
    event = RequestClosed with request = RequestRef r.epoch r.label; amount = 0.0; reason]

-- | Refuses an allocation that is not exactly the one requested, under the request's own settlement.
requireRequested : Text -> Party -> V2.SettlementInfo -> V2.AllocationSpecification -> ContractId V2.Allocation -> Update ()
requireRequested what admin settlement spec cid = do
  allocation <- fetchSigned what admin cid
  require' (what <> ".settlement", allocation.settlement) isEqualR ("requested settlement", settlement)
  require' (what, allocation.allocation) isEqualR ("requested", spec)

fetchSigned : Text -> Party -> ContractId V2.Allocation -> Update V2.AllocationView
fetchSigned what admin cid = do
  allocation <- fetch cid
  require (what <> " is signed by its registry") (signedBy admin allocation)
  pure (view allocation)

-- | Whether the registry's admin signed the allocation, so its view can be believed.
signedBy : Party -> V2.Allocation -> Bool
signedBy admin allocation = admin `elem` signatory allocation

-- | Refuses a batch whose requests share a label or an allocation, which would collide when settled.
requireDistinct : [(Party, Text)] -> [ContractId V2.Allocation] -> Update ()
requireDistinct labels allocations = do
  require "each request in the batch has its own label" (unique labels)
  require "each request in the batch has its own allocations" (unique allocations)

requireFactoriesOf : Party -> Party -> Factories -> Update ()
requireFactoriesOf actor admin factories = do
  allocationView <- exercise factories.allocationFactory V2.AllocationFactory_PublicFetch with actors = [actor]
  require' ("allocation factory admin", allocationView.admin) isEqualR ("registry admin", admin)
  settlementView <- exercise factories.settlementFactory V2.SettlementFactory_PublicFetch with actors = [actor]
  require' ("settlement factory admin", settlementView.admin) isEqualR ("registry admin", admin)

finalized : ContractId V2.Allocation -> [V2.TransferLegSide] -> V2.FinalizedAllocation
finalized allocationCid extra = V2.FinalizedAllocation with
  allocationCid
  extraTransferLegSides = extra
  nextIterationFunding = None

-- | Allocates the vault's side of every leg in a batch, which settles at once.
allocateSides : Factories -> ExtraArgs -> V2.SettlementInfo -> Time -> Party -> V2.Account -> [Party] -> [ContractId V2.Holding] -> [V2.TransferLegSide] -> Update (ContractId V2.Allocation)
allocateSides factories extraArgs settlement requestedAt admin authorizer actors inputHoldingCids sides =
  fst <$> allocateSidesWithChange factories extraArgs settlement requestedAt admin authorizer actors inputHoldingCids sides

allocateSidesWithChange : Factories -> ExtraArgs -> V2.SettlementInfo -> Time -> Party -> V2.Account -> [Party] -> [ContractId V2.Holding] -> [V2.TransferLegSide] -> Update (ContractId V2.Allocation, [ContractId V2.Holding])
allocateSidesWithChange factories extraArgs settlement requestedAt admin authorizer actors inputHoldingCids sides = do
  result <- exercise factories.allocationFactory V2.AllocationFactory_Allocate with
    settlement
    allocation = V2.AllocationSpecification with
      admin
      authorizer
      transferLegSides = sides
      settlementDeadline = None
      nextIterationFunding = None
      committed = False
      meta = emptyMetadata
    requestedAt
    inputHoldingCids
    extraArgs
    actors
  case result.output of
    V2.AllocationInstructionResult_Completed with allocationCid ->
      pure (allocationCid, concatMap snd (TextMap.toList result.authorizerChangeCids))
    _ -> fail "the vault's own allocation did not complete"

-- | The reference's metadata key for the executors' own words on why they rejected a request.
rejectionKey : Text
rejectionKey = "cantonVaultV1/rejection"

-- | Why a request was dropped: by its requester, by an executor, or by the registrar once it expired.
droppedBy : Party -> [Party] -> Party -> CloseReason
droppedBy requester executors actor
  | actor == requester = CR_Cancelled
  | actor `elem` executors = CR_Rejected
  | otherwise = CR_Expired

getContractIds : Text -> ChoiceContext -> Update [ContractId t]
getContractIds key context = case TextMap.lookup key context.values of
  Some (AV_List cids) -> forA cids $ \v -> case v of
    AV_ContractId cid -> pure (fromAnyContractId cid)
    _ -> fail $ "Failed to decode a contract id under '" <> key <> "': " <> show v
  None -> pure []
  v -> fail $ "Failed to decode context value for '" <> key <> "': " <> show v

-- | The price struck when a period opened, kept so requests from the period before can still be filled at it.
template PeriodPrice
  with
    vaultId : Text
    vaultRegistrar : Party
    executors : [Party]
    epoch : Int
      -- ^ The period this price opened.
    totalShares : Decimal
    totalAssets : Decimal
    allotments : [(Int, Decimal)]
      -- ^ The share of each earlier period's requests the period this price opened could fill.
  where
    signatory vaultRegistrar
    observer executors

-- | The opening totals of the first period after a request's that could fill it: one that allotted its period a share,
-- or the one right after for a vault that fills every request whole. Those stored for an earlier one, or the current.
firstFillableFor : Bool -> Int -> Int -> ((Decimal, Decimal), [(Int, Decimal)]) -> [PeriodPrice] -> Update (Decimal, Decimal)
firstFillableFor whole requestEpoch = firstFillableFrom whole requestEpoch (requestEpoch + 1)

firstFillableFrom : Bool -> Int -> Int -> Int -> ((Decimal, Decimal), [(Int, Decimal)]) -> [PeriodPrice] -> Update (Decimal, Decimal)
firstFillableFrom whole requestEpoch e currentEpoch current prices
  | e > currentEpoch = fail ("no period has allotted requests of period " <> show requestEpoch)
  | otherwise = do
      (totals, allotted) <- if e == currentEpoch then pure current else
        case [p | p <- prices, p.epoch == e] of
          p :: _ -> pure ((p.totalShares, p.totalAssets), p.allotments)
          [] -> fail ("no price struck for period " <> show e)
      if whole || isSome (lookup requestEpoch allotted) then pure totals
        else firstFillableFrom whole requestEpoch (e + 1) currentEpoch current prices

-- | Opening totals of the period after a request's: those stored for an earlier one, or the current ones.
struckFor : Int -> Int -> (Decimal, Decimal) -> [PeriodPrice] -> Update (Decimal, Decimal)
struckFor requestEpoch currentEpoch current prices
  | requestEpoch + 1 == currentEpoch = pure current
  | otherwise = case [p | p <- prices, p.epoch == requestEpoch + 1] of
      p :: _ -> pure (p.totalShares, p.totalAssets)
      [] -> fail ("no price struck for period " <> show (requestEpoch + 1))


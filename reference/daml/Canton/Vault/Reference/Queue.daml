-- | What the queued vaults share: pinned factories, allocation checks, struck prices and reports.
module Canton.Vault.Reference.Queue where

import DA.Foldable (forA_)
import DA.List (dedup, unique)
import DA.TextMap qualified as TextMap
import DA.Time (RelTime, addRelTime)

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.AllocationV2 qualified as V2
import Splice.Api.Token.AllocationInstructionV2 qualified as V2
import Splice.TokenStandard.Utils

-- | A registry's allocation and settlement factories.
data Factories = Factories with
    allocationFactory : ContractId V2.AllocationFactory
    settlementFactory : ContractId V2.SettlementFactory
  deriving (Show, Eq, Serializable)

-- | Refuses an allocation that is not committed for at least the vault's window from now.
requireCommittedFor : Text -> RelTime -> V2.AllocationSpecification -> Update ()
requireCommittedFor what window allocation = do
  now <- getTime
  require (what <> " is committed") allocation.committed
  case allocation.settlementDeadline of
    Some deadline -> require (what <> " is committed for the vault's window") (deadline >= addRelTime now window)
    None -> fail (what <> " needs a settlement deadline")

-- | Fetches an allocation, refusing one its registry's admin did not sign.
fetchSigned : Text -> Party -> ContractId V2.Allocation -> Update V2.AllocationView
fetchSigned what admin cid = do
  allocation <- fetch cid
  require (what <> " is signed by its registry") (signedBy admin allocation)
  pure (view allocation)

-- | Whether the registry's admin signed the allocation, so its view can be believed.
signedBy : Party -> V2.Allocation -> Bool
signedBy admin allocation = admin `elem` signatory allocation

-- | Refuses a batch whose requests share a label or an allocation, which would collide when settled.
requireDistinct : [(Party, Text)] -> [ContractId V2.Allocation] -> Update ()
requireDistinct labels allocations = do
  require "each request in the batch has its own label" (unique labels)
  require "each request in the batch has its own allocations" (unique allocations)

-- | The allocation's settlement deadline, which `requireCommittedFor` has checked it names.
deadlineOf : V2.AllocationSpecification -> Update Time
deadlineOf allocation = case allocation.settlementDeadline of
  Some deadline -> pure deadline
  None -> fail "allocation needs a settlement deadline"

requireFactoriesOf : Party -> Party -> Factories -> Update ()
requireFactoriesOf actor admin factories = do
  allocationView <- exercise factories.allocationFactory V2.AllocationFactory_PublicFetch with actors = [actor]
  require' ("allocation factory admin", allocationView.admin) isEqualR ("registry admin", admin)
  settlementView <- exercise factories.settlementFactory V2.SettlementFactory_PublicFetch with actors = [actor]
  require' ("settlement factory admin", settlementView.admin) isEqualR ("registry admin", admin)

legKey : V2.TransferLegSide -> (Text, V2.TransferSide, V2.Account, Decimal, Text)
legKey leg = (leg.transferLegId, leg.side, leg.otherside, leg.amount, leg.instrumentId)

finalized : ContractId V2.Allocation -> [V2.TransferLegSide] -> V2.FinalizedAllocation
finalized allocationCid extra = V2.FinalizedAllocation with
  allocationCid
  extraTransferLegSides = extra
  nextIterationFunding = None

-- | Allocates the vault's side of every leg in a batch, which settles at once.
allocateSides : Factories -> ExtraArgs -> V2.SettlementInfo -> Party -> V2.Account -> [Party] -> [ContractId V2.Holding] -> [V2.TransferLegSide] -> Update (ContractId V2.Allocation)
allocateSides factories extraArgs settlement admin authorizer actors inputHoldingCids sides = do
  now <- getTime
  result <- exercise factories.allocationFactory V2.AllocationFactory_Allocate with
    settlement
    allocation = V2.AllocationSpecification with
      admin
      authorizer
      transferLegSides = sides
      settlementDeadline = None
      nextIterationFunding = None
      committed = False
      meta = emptyMetadata
    requestedAt = now
    inputHoldingCids
    extraArgs
    actors
  case result.output of
    V2.AllocationInstructionResult_Completed with allocationCid -> pure allocationCid
    _ -> fail "the vault's own allocation did not complete"

-- | The contract ids listed under the key in a choice context.
getContractIds : Text -> ChoiceContext -> Update [ContractId t]
getContractIds key context = case TextMap.lookup key context.values of
  Some (AV_List cids) -> forA cids $ \v -> case v of
    AV_ContractId cid -> pure (fromAnyContractId cid)
    _ -> fail $ "Failed to decode a contract id under '" <> key <> "': " <> show v
  None -> pure []
  v -> fail $ "Failed to decode context value for '" <> key <> "': " <> show v

-- | The price struck when a period opened, kept so requests from the period before can still be filled at it.
template PeriodPrice
  with
    vaultId : Text
    vaultRegistrar : Party
    executors : [Party]
    epoch : Int
      -- ^ The period this price opened.
    totalShares : Decimal
    totalAssets : Decimal
  where
    signatory vaultRegistrar
    observer executors

-- | One queued request's outcome, as reported to its requester and receiver.
data QueuedEvent = QueuedEvent with
    vaultId : Text
    requester : Party
    receiver : Party
    label : Text
    requestId : Int
      -- ^ The period the request was made in.
    requested : Decimal
      -- ^ The underlying deposited, or the shares redeemed.
    outcome : Outcome
  deriving (Eq, Show, Serializable)

data Outcome
  = Fulfilled with
      received : Decimal
        -- ^ The shares issued, or the underlying paid.
  | Rejected with
      reason : Text
        -- ^ Why the request could not settle.
  deriving (Eq, Show, Serializable)

-- | Reports queued requests' outcomes in the transaction they happen in, as the token standard's `EventLog` does.
-- Created and archived within that transaction, so nothing stays on the ledger.
template QueueLog
  with
    vaultRegistrar : Party
  where
    signatory vaultRegistrar

    nonconsuming choice QueueLog_Report : ()
      -- ^ Show the event to its observers.
      with
        event : QueuedEvent
        observers : [Party]
      observer observers
      controller vaultRegistrar
      do pure ()

reportQueued : Party -> [QueuedEvent] -> Update ()
reportQueued registrar events = do
  log <- create QueueLog with vaultRegistrar = registrar
  forA_ events $ \event -> exercise log QueueLog_Report with event; observers = dedup [event.requester, event.receiver]
  archive log

-- | Opening totals of the period after a request's: those stored for an earlier one, or the current ones.
struckFor : Int -> Int -> (Decimal, Decimal) -> [PeriodPrice] -> Update (Decimal, Decimal)
struckFor requestEpoch currentEpoch current prices
  | requestEpoch + 1 == currentEpoch = pure current
  | otherwise = case [p | p <- prices, p.epoch == requestEpoch + 1] of
      p :: _ -> pure (p.totalShares, p.totalAssets)
      [] -> fail ("no price struck for period " <> show (requestEpoch + 1))


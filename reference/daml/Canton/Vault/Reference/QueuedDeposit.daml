-- | A reference vault whose deposits are queued and redemptions instant.
module Canton.Vault.Reference.QueuedDeposit where

import DA.Foldable (forA_)
import DA.List (dedup)
import DA.Optional (isNone)
import DA.TextMap qualified as TextMap
import DA.Time (RelTime)

import Canton.Vault.V1
import Canton.Vault.AsyncDeposit.V1
import Canton.Vault.Reference.Math
import Canton.Vault.Reference.V1
import Canton.Vault.Reference.Queue

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.AllocationV2 qualified as V2
import Splice.Api.Token.AllocationInstructionV2 qualified as V2
import Splice.Api.Token.TransferInstructionV2 qualified as V2
import Splice.TokenStandard.Utils

underlyingAllocationsKey : Text
underlyingAllocationsKey = "cantonVaultV1/underlyingAllocations"

template ReferenceQueuedDepositVault
  with
    vaultId : Text
    vaultRegistrar : Party
    custodian : Party
    underlyingInstrument : V2.InstrumentId
    shareInstrument : V2.InstrumentId
    totalShares : Decimal
      -- ^ The shares in issue as of `rateValidFrom`.
    totalAssets : Decimal
      -- ^ The pool as of `rateValidFrom`, before the virtual offset.
    accrual : Optional Accrual
    depositFeeBps : Int
    redeemFeeBps : Int
    rateValidFrom : Time
    rateValidUntil : Time
    executors : [Party]
      -- ^ The parties who fulfil deposit requests together; any one of them may drop a request.
    settlementDeadlineWindow : RelTime
      -- ^ The least time a request's allocations must be committed for.
    paused : Bool
      -- ^ Whether requests and fulfilments are refused; redemptions still run.
    underlyingTransferFactory : ContractId V2.TransferFactory
      -- ^ The underlying registry's transfer factory, the only one redemptions pay out through.
    underlyingFactories : Factories
      -- ^ The underlying registry's factories, the only ones fulfilment uses for it.
    shareFactories : Factories
      -- ^ The share registry's factories, the only ones fulfilment uses for it.
  where
    signatory vaultRegistrar, custodian
    observer executors

    ensure totalShares >= 0.0 && totalAssets >= 0.0
        && rateValidUntil > rateValidFrom
        && shareInstrument == V2.InstrumentId with admin = vaultRegistrar; id = vaultId
        && depositFeeBps >= 0 && depositFeeBps <= 10000
        && redeemFeeBps >= 0 && redeemFeeBps <= 10000
        && executors /= []

    -- Pricing, redemption and the period accounting are the instant vault's.
    interface instance Vault for ReferenceQueuedDepositVault where
      view = view (instantOf this)
      convertToShares = convertToShares (instantOf this)
      convertToAssets = convertToAssets (instantOf this)
      maxDeposit _party _extraArgs = pure 0.0
      maxMint _party _extraArgs = pure 0.0
      maxWithdraw = maxWithdraw (instantOf this)
      maxRedeem = maxRedeem (instantOf this)
      previewDeposit _assets = fail "deposits are queued: use Vault_RequestDeposit"
      previewMint _shares = fail "deposits are queued: use Vault_RequestDeposit"
      previewWithdraw = previewWithdraw (instantOf this)
      previewRedeem = previewRedeem (instantOf this)

      vault_depositExtraObservers _arg = []
      vault_mintExtraObservers _arg = []
      vault_withdrawExtraObservers _arg = []
      vault_redeemExtraObservers _arg = []

      vault_depositImpl _self _arg = fail "deposits are queued: use Vault_RequestDeposit"
      vault_mintImpl _self _arg = fail "deposits are queued: use Vault_RequestDeposit"
      vault_withdrawImpl = vault_withdrawImpl (instantOf this)
      vault_redeemImpl = vault_redeemImpl (instantOf this)

    interface instance VaultAsyncDeposit for ReferenceQueuedDepositVault where
      view = AsyncView with
        executors
        settlementDeadlineWindow
        meta = emptyMetadata

      -- Every request has id 0, so a party's pending amount is all their escrows together.
      pendingDepositRequest requestId party extraArgs = do
        allocationCids <- dedup <$> getAllocations underlyingAllocationsKey extraArgs.context
        amounts <- forA allocationCids $ \cid -> do
          allocation <- fetch cid
          let escrow = view allocation
          pure $ if requestId == 0 && signedBy underlyingInstrument.admin allocation
                      && escrow.settlement == settlementFor this
                      && escrow.allocation.authorizer.owner == Some party
            then sum [ leg.amount | leg <- escrow.allocation.transferLegSides
                     , leg.side == V2.SenderSide, leg.otherside == basicAccount custodian
                     , leg.instrumentId == underlyingInstrument.id ]
            else 0.0
        pure (sum amounts)

      vault_requestDepositExtraObservers _arg = []

      vault_requestDepositImpl _self arg = do
        requirePeriodOpen (instantOf' this)
        require "vault is not paused" (not paused)
        assets' <- currentAssets (instantOf' this)
        require "the deposit is worth shares at the current rate"
          (assetsToShares totalShares assets' (deductFeeBps depositFeeBps arg.assets) > 0.0)
        let settlement = settlementFor this

        funded <- fetchSigned "escrow" underlyingInstrument.admin arg.underlyingAllocation
        let requester = funded.allocation.authorizer
        checkActors arg.actors [regularAccountParties requester]
        require' ("escrow.settlement", funded.settlement) isEqualR ("settlement", settlement)
        require "escrow is not iterated" (isNone funded.allocation.nextIterationFunding)
        require' ("escrow legs", map legKey funded.allocation.transferLegSides) isEqualR
          ("request legs", [ ( requestLegId (regularAccountOwner requester) arg.label "underlying"
                             , V2.SenderSide, basicAccount custodian, arg.assets, underlyingInstrument.id ) ])
        requireCommittedFor "escrow" settlementDeadlineWindow funded.allocation

        receiving <- fetchSigned "share authorization" vaultRegistrar arg.shareAllocation
        require' ("share authorization.settlement", receiving.settlement) isEqualR ("settlement", settlement)
        require' ("share authorization.authorizer.owner", receiving.allocation.authorizer.owner) isEqualR
          ("receiver", Some arg.receiver)
        -- The share amount is set at fulfilment, which adds the receiving leg.
        require "share authorization names no legs" (receiving.allocation.transferLegSides == [])
        require "share authorization allows the executors to add a leg"
          (receiving.allocation.nextIterationFunding == Some TextMap.empty)
        requireCommittedFor "share authorization" settlementDeadlineWindow receiving.allocation
        escrowDeadline <- deadlineOf funded.allocation
        authorizationDeadline <- deadlineOf receiving.allocation

        _ <- create QueuedDepositRequest with
          vaultId; vaultRegistrar; executors
          requester = regularAccountOwner requester
          receiver = arg.receiver
          label = arg.label
          assets = arg.assets
          underlyingAllocation = arg.underlyingAllocation
          shareAllocation = arg.shareAllocation
          expiresAt = min escrowDeadline authorizationDeadline
        pure 0

    nonconsuming choice ReferenceQueuedDepositVault_Fulfil : ()
      -- ^ Fulfil requests at the current rate, in one transaction.
      with
        requestCids : [ContractId QueuedDepositRequest]
          -- ^ The requests to fulfil, each binding its escrow to its receiver's authorization. Each
          -- adds a leg to each registry's batch; every registry accepts batches of up to 25 legs.
        underlyingExtraArgs : ExtraArgs
          -- ^ The underlying registry's context for allocating and settling.
        shareExtraArgs : ExtraArgs
          -- ^ The share registry's context for allocating and settling.
      controller executors
      do
        requirePeriodOpen (instantOf' this)
        require "vault is not paused" (not paused)
        require "fulfils at least one request" (requestCids /= [])
        requests <- forA requestCids $ \cid -> do
          request <- fetch cid
          require' ("request.vaultRegistrar", request.vaultRegistrar) isEqualR ("vaultRegistrar", vaultRegistrar)
          archive cid
          pure request
        requireDistinct [(r.requester, r.label) | r <- requests]
          (concat [[r.underlyingAllocation, r.shareAllocation] | r <- requests])
        assets' <- currentAssets (instantOf' this)
        -- Each leg uses the account its allocation names, which may have a provider.
        accounts <- forA requests $ \r -> do
          funded <- view <$> fetch r.underlyingAllocation
          receiving <- view <$> fetch r.shareAllocation
          pure (funded.allocation.authorizer, receiving.allocation.authorizer)
        let settlement = settlementFor this
            priced = [ (r, from, to, assetsToShares totalShares assets' (deductFeeBps depositFeeBps r.assets))
                     | (r, (from, to)) <- zip requests accounts ]
            underlyingLeg (r, from, _, _) = V2.TransferLeg with
              transferLegId = requestLegId r.requester r.label "underlying"
              sender = from
              receiver = basicAccount custodian
              amount = r.assets
              instrumentId = underlyingInstrument.id
              meta = emptyMetadata
            shareLeg (r, _, to, s) = V2.TransferLeg with
              transferLegId = requestLegId r.requester r.label "shares"
              sender = mintAccount
              receiver = to
              amount = s
              instrumentId = shareInstrument.id
              meta = emptyMetadata
        forA_ priced $ \(_, _, _, s) -> require "each request mints a positive number of shares" (s > 0.0)

        -- The vault's own sides: the custodian receives, the mint account sends.
        custodianSide <- allocateSides underlyingFactories underlyingExtraArgs settlement underlyingInstrument.admin
          (basicAccount custodian) [custodian] [] [receiverSide (underlyingLeg p) | p <- priced]
        mintSide <- allocateSides shareFactories shareExtraArgs settlement vaultRegistrar
          mintAccount [vaultRegistrar] [] [senderSide (shareLeg p) | p <- priced]

        _ <- exercise underlyingFactories.settlementFactory V2.SettlementFactory_SettleBatch with
          settlement
          transferLegs = map underlyingLeg priced
          allocations = finalized custodianSide [] :: [finalized r.underlyingAllocation [] | (r, _, _, _) <- priced]
          actors = executors
          extraArgs = underlyingExtraArgs
        _ <- exercise shareFactories.settlementFactory V2.SettlementFactory_SettleBatch with
          settlement
          transferLegs = map shareLeg priced
          allocations = finalized mintSide []
            :: [finalized r.shareAllocation [receiverSide (shareLeg p)] | p@(r, _, _, _) <- priced]
          actors = executors
          extraArgs = shareExtraArgs

        recordFlow (instantOf' this) (sum (map (.assets) requests)) (sum [s | (_, _, _, s) <- priced])
        forA_ priced $ \(r, _, _, s) ->
          recordFulfilment this r.requester r.receiver r.label r.assets s

    choice ReferenceQueuedDepositVault_SetPaused : ContractId ReferenceQueuedDepositVault
      -- ^ Pause or resume requests and fulfilments.
      with
        pause : Bool
      controller vaultRegistrar
      do create this with paused = pause

    choice ReferenceQueuedDepositVault_SetFactories : ContractId ReferenceQueuedDepositVault
      -- ^ Pin other factories, when a registry replaces its own.
      with
        transferFactory : ContractId V2.TransferFactory
        underlying : Factories
        shares : Factories
      controller vaultRegistrar
      do
        -- Catches pinning another registry's factories by mistake.
        transferView <- exercise transferFactory V2.TransferFactory_PublicFetch with actors = [vaultRegistrar]
        require' ("transfer factory admin", transferView.admin) isEqualR ("underlying admin", underlyingInstrument.admin)
        requireFactoriesOf vaultRegistrar underlyingInstrument.admin underlying
        requireFactoriesOf vaultRegistrar vaultRegistrar shares
        create this with
          underlyingTransferFactory = transferFactory
          underlyingFactories = underlying
          shareFactories = shares

    choice ReferenceQueuedDepositVault_ClosePeriod : ContractId ClosedQueuedPeriod
      -- ^ End the period; redemptions, requests and fulfilments against this vault fail from here on.
      controller vaultRegistrar
      do create ClosedQueuedPeriod with vault = this

-- | A queued vault's period that takes no more actions, so its flows are final when it is opened again.
template ClosedQueuedPeriod
  with
    vault : ReferenceQueuedDepositVault
  where
    signatory vault.vaultRegistrar, vault.custodian

    choice ClosedQueuedPeriod_Open : ContractId ReferenceQueuedDepositVault
      -- ^ Open the next period, folding in the flows not yet counted and measuring the pool.
      with
        flowCids : [ContractId PeriodFlow]
        poolHoldingCids : [ContractId V2.Holding]
        validUntil : Time
      controller vault.vaultRegistrar
      do
        (shares, assets, now) <- rollTotals (instantOf' vault) flowCids poolHoldingCids validUntil
        create vault with
          totalShares = shares
          totalAssets = assets
          rateValidFrom = now
          rateValidUntil = validUntil

    choice ClosedQueuedPeriod_Reopen : ContractId ReferenceQueuedDepositVault
      -- ^ Undo the close when the next period cannot be opened, restoring the vault as it was.
      controller vault.vaultRegistrar
      do create vault

-- | A queued deposit, binding its escrow to its receiver's authorization until it is fulfilled.
template QueuedDepositRequest
  with
    vaultId : Text
    vaultRegistrar : Party
    executors : [Party]
    requester : Party
    receiver : Party
    label : Text
    assets : Decimal
    underlyingAllocation : ContractId V2.Allocation
      -- ^ The requester's funded escrow.
    shareAllocation : ContractId V2.Allocation
      -- ^ The receiver's authorization to be issued shares.
    expiresAt : Time
      -- ^ The earlier of its allocations' deadlines, after which it cannot be fulfilled.
  where
    signatory vaultRegistrar
    observer requester, receiver, executors

    choice QueuedDepositRequest_Archive : ()
      -- ^ Drop a request: the requester or an executor at any time, the registrar once it has expired.
      with
        actor : Party
      controller actor
      do
        now <- getTime
        require "the requester or an executor drops a request, or the registrar once it has expired"
          (actor `elem` (requester :: executors) || actor == vaultRegistrar && now >= expiresAt)

-- | A record of one fulfilled deposit, kept for its requester and receiver.
template QueuedDepositEvent
  with
    vaultId : Text
    vaultRegistrar : Party
    requester : Party
    receiver : Party
    label : Text
    assets : Decimal
    shares : Decimal
      -- ^ The shares issued.
    periodStart : Time
  where
    signatory vaultRegistrar
    observer requester, receiver

    choice QueuedDepositEvent_Archive : ()
      -- ^ Drop the record, by a party it is kept for or by the registrar.
      with
        actor : Party
      controller actor
      do require' ("actor", actor) isMemberR ("record keepers", [vaultRegistrar, requester, receiver])

-- | The same vault as an instant one, for everything but deposits.
instantOf' : ReferenceQueuedDepositVault -> ReferenceVault
instantOf' v = ReferenceVault with
  vaultId = v.vaultId
  vaultRegistrar = v.vaultRegistrar
  custodian = v.custodian
  underlyingInstrument = v.underlyingInstrument
  shareInstrument = v.shareInstrument
  totalShares = v.totalShares
  totalAssets = v.totalAssets
  accrual = v.accrual
  depositFeeBps = v.depositFeeBps
  redeemFeeBps = v.redeemFeeBps
  rateValidFrom = v.rateValidFrom
  rateValidUntil = v.rateValidUntil
  depositCap = None
  paused = v.paused
  underlyingTransferFactory = v.underlyingTransferFactory

instantOf : ReferenceQueuedDepositVault -> Vault
instantOf = toInterface . instantOf'

settlementFor : ReferenceQueuedDepositVault -> V2.SettlementInfo
settlementFor v = V2.SettlementInfo with
  executors = v.executors
  id = requestSettlementId v.vaultId
  cid = None
  meta = emptyMetadata

recordFulfilment : ReferenceQueuedDepositVault -> Party -> Party -> Text -> Decimal -> Decimal -> Update ()
recordFulfilment v requester receiver label assets shares = do
  _ <- create QueuedDepositEvent with
    vaultId = v.vaultId
    vaultRegistrar = v.vaultRegistrar
    requester
    receiver
    label
    assets
    shares
    periodStart = v.rateValidFrom
  pure ()

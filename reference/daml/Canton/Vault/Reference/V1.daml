-- | A reference vault: one underlying, a computed rate fixed per period, instant settlement.
module Canton.Vault.Reference.V1 where

import DA.List (dedup, head)
import DA.Optional (fromOptional)
import DA.TextMap qualified as TextMap

import Canton.Vault.V1
import Canton.Vault.Reference.Math
import Canton.Vault.Reference.Share

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.TransferInstructionV2 qualified as V2
import Splice.TokenStandard.Utils

-- The caller names each leg's holdings; neither vault nor registry can look them up.
shareHoldingsKey : Text
shareHoldingsKey = "cantonVaultV1/shareHoldings"

underlyingHoldingsKey : Text
underlyingHoldingsKey = "cantonVaultV1/underlyingHoldings"

getShareHoldings : ChoiceContext -> Update [ContractId ShareHolding]
getShareHoldings = getHoldingCids shareHoldingsKey

getUnderlyingHoldings : ChoiceContext -> Update [ContractId V2.Holding]
getUnderlyingHoldings = getHoldingCids underlyingHoldingsKey

getHoldingCids : Text -> ChoiceContext -> Update [ContractId a]
getHoldingCids key context =
  case TextMap.lookup key context.values of
    Some (AV_List cids) -> forA cids $ \v -> case v of
      AV_ContractId cid -> pure (fromAnyContractId cid)
      _ -> fail $ "Failed to decode a holding id under '" <> key <> "': " <> show v
    None -> pure []
    v -> fail $ "Failed to decode context value for '" <> key <> "': " <> show v

-- | What one action moved, folded in by the registrar at the period roll.
template PeriodFlow
  with
    vaultId : Text
    vaultRegistrar : Party
    periodStart : Time
    assetsDelta : Decimal
    sharesDelta : Decimal
  where
    signatory vaultRegistrar

-- | A record of one action, kept for the parties who took it.
template VaultEvent
  with
    vaultId : Text
    vaultRegistrar : Party
    action : VaultAction
    actors : [Party]
    receiver : Party
    assets : Decimal
    shares : Decimal
    periodStart : Time
  where
    signatory vaultRegistrar
    observer actors, receiver

data VaultAction = Deposited | Minted | Withdrew | Redeemed
  deriving (Eq, Show, Serializable)

-- | A period that takes no more actions, so its flows are final when it is opened again.
template ClosedPeriod
  with
    vault : ReferenceVault
  where
    signatory vault.vaultRegistrar, vault.custodian

    choice ClosedPeriod_Open : ContractId ReferenceVault
      -- ^ Open the next period, folding in the closed one's flows and measuring the pool.
      with
        flowCids : [ContractId PeriodFlow]
        poolHoldingCids : [ContractId V2.Holding]
        validUntil : Time
      controller vault.vaultRegistrar
      do
        (shares, assets, now) <- rollTotals vault flowCids poolHoldingCids validUntil
        create vault with
          totalShares = shares
          totalAssets = assets
          rateValidFrom = now
          rateValidUntil = validUntil

    choice ClosedPeriod_Reopen : ContractId ReferenceVault
      -- ^ Undo the close when the next period cannot be opened, restoring the vault as it was.
      controller vault.vaultRegistrar
      do create vault

-- | A full fee leaves nothing to mint, as it leaves nothing to deposit.
requireMintable : ReferenceVault -> Update ()
requireMintable v = require "the deposit fee leaves something to mint" (v.depositFeeBps < 10000)

-- | A full fee leaves nothing to withdraw, as it leaves nothing to redeem.
requireWithdrawable : ReferenceVault -> Update ()
requireWithdrawable v = require "the redemption fee leaves something to withdraw" (v.redeemFeeBps < 10000)

template ReferenceVault
  with
    vaultId : Text
    vaultRegistrar : Party
    custodian : Party
    underlyingInstrument : V2.InstrumentId
    shareInstrument : V2.InstrumentId
    totalShares : Decimal
      -- ^ The shares in issue as of `rateValidFrom`.
    totalAssets : Decimal
      -- ^ The pool as of `rateValidFrom`, before the virtual offset.
    accrual : Optional Accrual
    depositFeeBps : Int
    redeemFeeBps : Int
    rateValidFrom : Time
    rateValidUntil : Time
    depositCap : Optional Decimal
      -- ^ The most one deposit may bring in; `None` for no limit.
    paused : Bool
      -- ^ Whether deposits and mints are refused; withdrawals and redemptions still run.
    underlyingTransferFactory : ContractId V2.TransferFactory
      -- ^ The registry's transfer factory, the only one the vault transfers through.
  where
    signatory vaultRegistrar, custodian

    ensure totalShares >= 0.0 && totalAssets >= 0.0
        && rateValidUntil > rateValidFrom
        -- One share instrument per vault, so two vaults never issue the same shares.
        && shareInstrument == V2.InstrumentId with admin = vaultRegistrar; id = vaultId
        && depositFeeBps >= 0 && depositFeeBps <= 10000
        && redeemFeeBps >= 0 && redeemFeeBps <= 10000

    interface instance Vault for ReferenceVault where
      view = VaultView with
        vaultId
        vaultRegistrar
        custodian
        underlyingInstrument
        shareInstrument
        totalShares = totalShares + virtualOffset
        totalAssets = totalAssets + virtualOffset
        rate = ComputedRate with
          asOf = rateValidFrom
          accrual
          depositFeeBps
          redeemFeeBps
        rateValidFrom
        rateValidUntil
        meta = emptyMetadata

      convertToShares assets = do
        assets' <- currentAssets this
        pure (assetsToShares totalShares assets' assets)

      convertToAssets shares = do
        assets' <- currentAssets this
        pure (sharesToAssets totalShares assets' shares)

      maxDeposit _party _extraArgs = pure (if paused then 0.0 else fromOptional uncapped depositCap)

      -- The most shares whose cost, fee included, fits under the cap.
      maxMint _party _extraArgs = case depositCap of
        _ | paused || depositFeeBps >= 10000 -> pure 0.0
        None -> pure uncapped
        Some cap -> do
          assets' <- currentAssets this
          let cost shares = grossUpFeeBps depositFeeBps (sharesToAssetsUp totalShares assets' shares)
          pure (fitDown (\s -> cost s <= cap) (assetsToShares totalShares assets' (deductFeeBps depositFeeBps cap)))

      -- The most assets whose shares, fee included, the party holds.
      maxWithdraw party extraArgs = do
        assets' <- currentAssets this
        held <- heldShares this extraArgs party
        let burned assets = assetsToSharesUp totalShares assets' (grossUpFeeBps redeemFeeBps assets)
        pure (fitDown (\a -> burned a <= held) (deductFeeBps redeemFeeBps (sharesToAssets totalShares assets' held)))

      maxRedeem party extraArgs = heldShares this extraArgs party

      previewDeposit assets = do
        assets' <- currentAssets this
        pure (assetsToShares totalShares assets' (deductFeeBps depositFeeBps assets))

      previewMint shares = do
        requireMintable this
        assets' <- currentAssets this
        pure (grossUpFeeBps depositFeeBps (sharesToAssetsUp totalShares assets' shares))

      previewWithdraw assets = do
        requireWithdrawable this
        assets' <- currentAssets this
        pure (assetsToSharesUp totalShares assets' (grossUpFeeBps redeemFeeBps assets))

      previewRedeem shares = do
        assets' <- currentAssets this
        pure (deductFeeBps redeemFeeBps (sharesToAssets totalShares assets' shares))

      vault_depositExtraObservers _arg = []
      vault_mintExtraObservers _arg = []
      vault_withdrawExtraObservers _arg = []
      vault_redeemExtraObservers _arg = []

      vault_depositImpl _self arg = do
        sender <- fundingAccount arg.actors arg.extraArgs
        requireReceiverAuthorizes arg.receiver arg.actors
        requirePeriodOpen this
        require "vault is not paused" (not paused)
        require "deposit within cap" (arg.assets <= fromOptional uncapped depositCap)
        assets' <- currentAssets this
        let net = deductFeeBps depositFeeBps arg.assets
            shares = assetsToShares totalShares assets' net
        require "deposit mints a positive number of shares" (shares > 0.0)
        checkMinSharesOut arg.minSharesOut shares
        require "rounding favours the vault" (sharesToAssets totalShares assets' shares <= net)
        pullUnderlying this arg.extraArgs sender arg.assets
        holdingCid <- mintShares shareInstrument (basicAccount arg.receiver) shares
        recordFlow this arg.assets shares
        recordEvent this Deposited arg.actors arg.receiver arg.assets shares
        pure VaultActionResult with
          vaultCid = None
          assets = arg.assets
          shares
          holdingCids = [toInterfaceContractId holdingCid]
          meta = emptyMetadata

      vault_mintImpl _self arg = do
        sender <- fundingAccount arg.actors arg.extraArgs
        requireReceiverAuthorizes arg.receiver arg.actors
        requirePeriodOpen this
        require "vault is not paused" (not paused)
        require "mint is positive" (arg.shares > 0.0)
        requireMintable this
        assets' <- currentAssets this
        let assets = grossUpFeeBps depositFeeBps (sharesToAssetsUp totalShares assets' arg.shares)
        require "mint within cap" (assets <= fromOptional uncapped depositCap)
        checkMaxAssetsIn arg.maxAssetsIn assets
        pullUnderlying this arg.extraArgs sender assets
        holdingCid <- mintShares shareInstrument (basicAccount arg.receiver) arg.shares
        recordFlow this assets arg.shares
        recordEvent this Minted arg.actors arg.receiver assets arg.shares
        pure VaultActionResult with
          vaultCid = None
          assets
          shares = arg.shares
          holdingCids = [toInterfaceContractId holdingCid]
          meta = emptyMetadata

      vault_withdrawImpl _self arg = do
        checkActors arg.actors [[arg.owner]]
        requirePeriodOpen this
        require "withdrawal is positive" (arg.assets > 0.0)
        requireWithdrawable this
        assets' <- currentAssets this
        let shares = assetsToSharesUp totalShares assets' (grossUpFeeBps redeemFeeBps arg.assets)
        checkMaxSharesIn arg.maxSharesIn shares
        burnFrom this arg.extraArgs arg.owner shares
        holdingCids <- pushUnderlying this arg.extraArgs arg.actors arg.receiver arg.assets
        recordFlow this (negate arg.assets) (negate shares)
        recordEvent this Withdrew arg.actors arg.receiver arg.assets shares
        pure VaultActionResult with
          vaultCid = None
          assets = arg.assets
          shares
          holdingCids
          meta = emptyMetadata

      vault_redeemImpl _self arg = do
        checkActors arg.actors [[arg.owner]]
        requirePeriodOpen this
        require "redemption is positive" (arg.shares > 0.0)
        assets' <- currentAssets this
        let assets = deductFeeBps redeemFeeBps (sharesToAssets totalShares assets' arg.shares)
        require "redemption returns a positive amount" (assets > 0.0)
        checkMinAssetsOut arg.minAssetsOut assets
        require "rounding favours the vault" (assetsToShares totalShares assets' assets <= arg.shares)
        burnFrom this arg.extraArgs arg.owner arg.shares
        holdingCids <- pushUnderlying this arg.extraArgs arg.actors arg.receiver assets
        recordFlow this (negate assets) (negate arg.shares)
        recordEvent this Redeemed arg.actors arg.receiver assets arg.shares
        pure VaultActionResult with
          vaultCid = None
          assets
          shares = arg.shares
          holdingCids
          meta = emptyMetadata

    choice ReferenceVault_ClosePeriod : ContractId ClosedPeriod
      -- ^ End the period; actions against this vault fail from here on.
      controller vaultRegistrar
      do create ClosedPeriod with vault = this

    choice ReferenceVault_SetTransferFactory : ContractId ReferenceVault
      -- ^ Pin another transfer factory, when the registry replaces its own.
      with
        factory : ContractId V2.TransferFactory
      controller vaultRegistrar
      do
        -- Catches pinning another registry's factory by mistake.
        factoryView <- exercise factory V2.TransferFactory_PublicFetch with actors = [vaultRegistrar]
        require' ("transfer factory admin", factoryView.admin)
          isEqualR ("underlying instrument admin", underlyingInstrument.admin)
        create this with underlyingTransferFactory = factory

    choice ReferenceVault_SetPaused : ContractId ReferenceVault
      -- ^ Pause or resume deposits and mints.
      with
        pause : Bool
      controller vaultRegistrar
      do create this with paused = pause

    nonconsuming choice ReferenceVault_PoolTotal : Decimal
      -- ^ The pool summed from the holdings named, for checking the books between periods.
      with
        caller : Party
        poolHoldingCids : [ContractId V2.Holding]
      controller caller
      do sumPool this poolHoldingCids

    nonconsuming choice ReferenceVault_Fetch : ReferenceVault
      -- ^ The vault itself, for a party that is not its stakeholder.
      with
        caller : Party
      controller caller
      do pure this

-- Helpers
-----------

recordEvent : ReferenceVault -> VaultAction -> [Party] -> Party -> Decimal -> Decimal -> Update ()
recordEvent vault action actors receiver assets shares = do
  _ <- create VaultEvent with
    vaultId = vault.vaultId
    vaultRegistrar = vault.vaultRegistrar
    action
    actors
    receiver
    assets
    shares
    periodStart = vault.rateValidFrom
  pure ()

-- | The totals for the next period: this one's flows folded in, the pool measured.
rollTotals : ReferenceVault -> [ContractId PeriodFlow] -> [ContractId V2.Holding] -> Time -> Update (Decimal, Decimal, Time)
rollTotals vault flowCids poolHoldingCids validUntil = do
  now <- getTime
  require "period ends in the future" (validUntil > now)
  flows <- forA flowCids $ \cid -> do
    flow <- fetch cid
    require' ("flow.vaultId", flow.vaultId) isEqualR ("vaultId", vault.vaultId)
    require' ("flow.periodStart", flow.periodStart) isEqualR ("rateValidFrom", vault.rateValidFrom)
    archive cid
    pure flow
  assets <- sumPool vault poolHoldingCids
  let shares = vault.totalShares + sum (map (.sharesDelta) flows)
  require "shares stay non-negative" (shares >= 0.0)
  pure (shares, assets, now)

recordFlow : ReferenceVault -> Decimal -> Decimal -> Update ()
recordFlow vault assetsDelta sharesDelta = do
  _ <- create PeriodFlow with
    vaultId = vault.vaultId
    vaultRegistrar = vault.vaultRegistrar
    periodStart = vault.rateValidFrom
    assetsDelta
    sharesDelta
  pure ()

-- | Sums the pool from holdings the custodian owns, so none can be invented.
sumPool : ReferenceVault -> [ContractId V2.Holding] -> Update Decimal
sumPool vault holdingCids = do
  require "pool holdings are distinct" (length (dedup holdingCids) == length holdingCids)
  amounts <- forA holdingCids $ \cid -> do
    holding <- view <$> fetch cid
    require' ("holding.instrumentId", holding.instrumentId)
      isEqualR ("underlyingInstrument", vault.underlyingInstrument)
    require' ("holding.account", holding.account)
      isEqualR ("custodian account", basicAccount vault.custodian)
    require "pool holding is unlocked" (holding.lock == None)
    pure holding.amount
  pure (sum amounts)

-- | Shares the party holds among the holdings they named; unnamed ones do not count.
heldShares : ReferenceVault -> ExtraArgs -> Party -> Update Decimal
heldShares vault extraArgs party = do
  holdingCids <- getShareHoldings extraArgs.context
  require "share holdings are distinct" (length (dedup holdingCids) == length holdingCids)
  amounts <- forA holdingCids $ \cid -> do
    holding <- (.holding) <$> fetch cid
    require' ("holding.instrumentId", holding.instrumentId)
      isEqualR ("shareInstrument", vault.shareInstrument)
    require' ("holding.account", holding.account)
      isEqualR ("party account", basicAccount party)
    require "share holding is unlocked" (holding.lock == None)
    pure holding.amount
  pure (sum amounts)

currentAssets : ReferenceVault -> Update Decimal
currentAssets vault = do
  now <- getTime
  pure (accrue vault.accrual vault.totalAssets vault.rateValidFrom now)

-- | A clear failure for a receiver outside the actors, who could not sign their shares.
requireReceiverAuthorizes : Party -> [Party] -> Update ()
requireReceiverAuthorizes receiver actors =
  require' ("receiver", receiver) isMemberR ("actors", actors)

-- | Refuses to transact against a rate period that has ended.
requirePeriodOpen : ReferenceVault -> Update ()
requirePeriodOpen vault = do
  now <- getTime
  require "rate period is still open" (now < vault.rateValidUntil)

-- | The deposit's funding account; the actors must be exactly its parties.
fundingAccount : [Party] -> ExtraArgs -> Update V2.Account
fundingAccount actors extraArgs = do
  require "deposit names an actor" (actors /= [])
  let account = accountFromMeta (head actors) "sender" extraArgs.meta
  checkActors actors [regularAccountParties account]
  pure account

checkMinSharesOut : Optional Decimal -> Decimal -> Update ()
checkMinSharesOut limit shares = case limit of
  Some minOut | shares < minOut -> fail vaultSlippageExceeded
  _ -> pure ()

checkMaxAssetsIn : Optional Decimal -> Decimal -> Update ()
checkMaxAssetsIn limit assets = case limit of
  Some maxIn | assets > maxIn -> fail vaultSlippageExceeded
  _ -> pure ()

checkMaxSharesIn : Optional Decimal -> Decimal -> Update ()
checkMaxSharesIn limit shares = case limit of
  Some maxIn | shares > maxIn -> fail vaultSlippageExceeded
  _ -> pure ()

checkMinAssetsOut : Optional Decimal -> Decimal -> Update ()
checkMinAssetsOut limit assets = case limit of
  Some minOut | assets < minOut -> fail vaultSlippageExceeded
  _ -> pure ()

-- | Only the depositor authorizes; a receiver's consent comes from the custodian's preapproval.
pullUnderlying : ReferenceVault -> ExtraArgs -> V2.Account -> Decimal -> Update ()
pullUnderlying vault extraArgs from amount = do
  inputHoldingCids <- getUnderlyingHoldings extraArgs.context
  _ <- transferUnderlying vault extraArgs (regularAccountParties from) from (basicAccount vault.custodian) amount inputHoldingCids
  pure ()

-- A payout the registry leaves pending is accepted by the receiver, if they are acting in this choice.
pushUnderlying : ReferenceVault -> ExtraArgs -> [Party] -> Party -> Decimal -> Update [ContractId V2.Holding]
pushUnderlying vault extraArgs callerActors to amount = do
  named <- getUnderlyingHoldings extraArgs.context
  inputHoldingCids <- coveringHoldings amount named
  output <- transferOutput vault extraArgs [vault.custodian] (basicAccount vault.custodian) (basicAccount to) amount inputHoldingCids
  case output of
    V2.TransferInstructionResult_Pending with transferInstructionCid | to `elem` callerActors -> do
      accepted <- exercise transferInstructionCid V2.TransferInstruction_Accept with actors = [to]; extraArgs
      completed accepted.output
    _ -> completed output

-- | The leading holdings that cover the payout, so one payout cannot consume the whole pool.
coveringHoldings : Decimal -> [ContractId V2.Holding] -> Update [ContractId V2.Holding]
coveringHoldings _ [] = pure []
coveringHoldings remaining (cid :: rest) =
  if remaining <= 0.0
    then pure []
    else do
      holding <- view <$> fetch cid
      (cid ::) <$> coveringHoldings (remaining - holding.amount) rest

transferUnderlying : ReferenceVault -> ExtraArgs -> [Party] -> V2.Account -> V2.Account -> Decimal -> [ContractId V2.Holding] -> Update [ContractId V2.Holding]
transferUnderlying vault extraArgs actors sender receiver amount inputHoldingCids =
  transferOutput vault extraArgs actors sender receiver amount inputHoldingCids >>= completed

completed : V2.TransferInstructionResult_Output -> Update [ContractId V2.Holding]
completed output = case output of
  V2.TransferInstructionResult_Completed with receiverHoldingCids -> pure receiverHoldingCids
  _ -> fail "the registry left the underlying transfer pending, so nothing was minted or burned"

transferOutput : ReferenceVault -> ExtraArgs -> [Party] -> V2.Account -> V2.Account -> Decimal -> [ContractId V2.Holding] -> Update V2.TransferInstructionResult_Output
transferOutput vault extraArgs actors sender receiver amount inputHoldingCids = do
  now <- getTime
  result <- exercise vault.underlyingTransferFactory V2.TransferFactory_Transfer with
    transfer = V2.Transfer with
      sender
      receiver
      amount
      instrumentId = vault.underlyingInstrument
      requestedAt = now
      executeBefore = vault.rateValidUntil
      inputHoldingCids
      meta = emptyMetadata
    actors
    extraArgs
  pure result.output

burnFrom : ReferenceVault -> ExtraArgs -> Party -> Decimal -> Update ()
burnFrom vault extraArgs owner amount = do
  holdingCids <- getShareHoldings extraArgs.context
  burnAcross vault.shareInstrument (basicAccount owner) amount holdingCids

burnAcross : V2.InstrumentId -> V2.Account -> Decimal -> [ContractId ShareHolding] -> Update ()
burnAcross _instrumentId _account remaining [] =
  require "share holdings cover the amount burned" (remaining <= 0.0)
burnAcross instrumentId account remaining (cid :: rest) =
  if remaining <= 0.0
    then pure ()
    else do
      holding <- fetch cid
      let take = min remaining holding.holding.amount
      _ <- burnShares instrumentId account take cid
      burnAcross instrumentId account (remaining - take) rest

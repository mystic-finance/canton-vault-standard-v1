-- | A reference vault whose deposits are instant and redemptions queued.
module Canton.Vault.Reference.QueuedRedeem where

import DA.Action (unless, void, when)
import DA.Foldable (forA_)
import DA.List (dedup, unique)
import DA.Optional (fromOptional, isNone, isSome)
import DA.TextMap qualified as TextMap
import DA.Time (RelTime, addRelTime, isLedgerTimeGE, isLedgerTimeLT)

import Canton.Vault.V1
import Canton.Vault.AsyncRedeem.V1
import Canton.Vault.Reference.Math
import Canton.Vault.Reference.V1
import Canton.Vault.Reference.Queue

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.AllocationV2 qualified as V2
import Splice.Api.Token.TransferInstructionV2 qualified as V2
import Splice.TokenStandard.Utils

redeemRequestsKey : Text
redeemRequestsKey = "cantonVaultV1/redeemRequests"

template ReferenceQueuedRedeemVault
  with
    vaultId : Text
    vaultRegistrar : Party
    custodian : Party
    underlyingInstrument : V2.InstrumentId
    shareInstrument : V2.InstrumentId
    totalShares : Decimal
      -- ^ The shares in issue as of `rateValidFrom`.
    totalAssets : Decimal
      -- ^ The vault's value as of `rateValidFrom`, before the virtual offset.
    pricing : Pricing
      -- ^ Where each roll takes the price from, fixed for the vault's life.
    accrual : Optional Accrual
    depositFeeBps : Int
    redeemFeeBps : Int
    rateValidFrom : Time
    rateValidUntil : Time
    epoch : Int
      -- ^ The current period's number, counting rolls; a request made in it carries it as its id.
    depositCap : Optional Decimal
      -- ^ The most one deposit may bring in; `None` for no limit.
    executors : [Party]
      -- ^ The parties who fulfil redemption requests together; any one of them may drop a request.
    settlementDeadlineWindow : RelTime
      -- ^ The least time a request's allocations must be committed for.
    paused : Bool
      -- ^ Whether deposits and mints are refused; redemptions still run.
    underlyingTransferFactory : ContractId V2.TransferFactory
      -- ^ The underlying registry's transfer factory, the only one deposits pay in through.
    underlyingFactories : Factories
      -- ^ The underlying registry's factories, the only ones fulfilment uses for it.
    shareFactories : Factories
      -- ^ The share registry's factories, the only ones fulfilment uses for it.
    priceLimits : PriceLimits
      -- ^ How far a roll may move the price on the registrar's word alone.
    allotments : [(Int, Decimal)]
      -- ^ The share of each earlier period's unfilled requests this period fills, for a vault priced by its oracle.
  where
    signatory vaultRegistrar, custodian
    observer executors

    ensure totalShares >= 0.0 && totalAssets >= 0.0
        && rateValidUntil > rateValidFrom
        && shareInstrument == V2.InstrumentId with admin = vaultRegistrar; id = vaultId
        && depositFeeBps >= 0 && depositFeeBps <= 10000
        && redeemFeeBps >= 0 && redeemFeeBps <= 10000
        && executors /= []
        && validPriceLimits priceLimits
        && validPricing vaultRegistrar pricing
        && validAllotments pricing epoch allotments

    -- Pricing, deposits and the period accounting are the instant vault's.
    interface instance Vault for ReferenceQueuedRedeemVault where
      view = view (instantOf this)
      convertToShares = convertToShares (instantOf this)
      convertToAssets = convertToAssets (instantOf this)
      maxDeposit = maxDeposit (instantOf this)
      maxMint = maxMint (instantOf this)
      maxWithdraw _party _extraArgs = pure 0.0
      maxRedeem _party _extraArgs = pure 0.0
      previewDeposit = previewDeposit (instantOf this)
      previewMint = previewMint (instantOf this)
      previewWithdraw _assets = fail "redemptions are queued: use Vault_RequestRedeem"
      previewRedeem _shares = fail "redemptions are queued: use Vault_RequestRedeem"

      vault_depositExtraObservers _arg = []
      vault_mintExtraObservers _arg = []
      vault_withdrawExtraObservers _arg = []
      vault_redeemExtraObservers _arg = []

      vault_depositImpl = vault_depositImpl (instantOf this)
      vault_mintImpl = vault_mintImpl (instantOf this)
      vault_withdrawImpl _self _arg = fail "redemptions are queued: use Vault_RequestRedeem"
      vault_redeemImpl _self _arg = fail "redemptions are queued: use Vault_RequestRedeem"

    interface instance VaultAsyncRedeem for ReferenceQueuedRedeemVault where
      view = AsyncView with
        executors
        settlementDeadlineWindow
        meta = emptyMetadata

      -- A request's id is the period it was made in.
      pendingRedeemRequest requestId party extraArgs = do
        requestCids : [ContractId QueuedRedeemRequest] <- dedup <$> getContractIds redeemRequestsKey extraArgs.context
        amounts <- forA requestCids $ \cid -> do
          r <- fetch cid
          live <- if isSome r.filledIn then pure True else isLedgerTimeLT r.expiresAt
          pure $ if r.vaultRegistrar == vaultRegistrar && r.vaultId == vaultId && r.owner == party
                      && r.epoch == requestId && live
            then r.shares else 0.0
        pure (sum amounts)

      vault_requestRedeemExtraObservers _arg = []

      vault_requestRedeemImpl _self arg = do
        requirePeriodOpen (instantOf' this)
        assets' <- currentAssets (instantOf' this)
        require "the redemption pays out at the current rate"
          (deductFeeBps redeemFeeBps (sharesToAssets totalShares assets' arg.shares) > 0.0)
        let settlement = settlementFor this
            escrowDeadline = addRelTime rateValidUntil settlementDeadlineWindow

        -- The vault builds the escrow, so its leg and deadline are the ones it settles and no other request has it.
        from <- fundingAccount arg.actors arg.extraArgs
        let owner = regularAccountOwner from
        escrow <- allocateEscrow shareFactories arg.extraArgs settlement rateValidFrom escrowDeadline
          vaultRegistrar from arg.inputHoldingCids V2.TransferLegSide with
            transferLegId = requestLegId owner arg.label "shares"
            side = V2.SenderSide
            otherside = redemptionAccount vaultRegistrar
            amount = arg.shares
            instrumentId = shareInstrument.id
            meta = emptyMetadata

        -- Only the owner's receipt can be read here; fulfilment checks every receipt again.
        when (arg.receiver == owner) $
          void (checkReceipt this arg.receiver escrowDeadline arg.underlyingAllocation)

        _ <- create QueuedRedeemRequest with
          vaultId; vaultRegistrar; executors
          owner
          receiver = arg.receiver
          label = arg.label
          shares = arg.shares
          shareAllocation = escrow
          underlyingAllocation = arg.underlyingAllocation
          expiresAt = escrowDeadline
          epoch
          minAssetsOut = arg.minAssetsOut
          filledIn = None
        pure epoch

    nonconsuming choice ReferenceQueuedRedeemVault_Fulfil : ()
      -- ^ Fill requests made in earlier periods, in one transaction; one that fails fails them all. Each fills its
      -- allotment at the price struck when the period after its own opened, or the current one if less.
      with
        requestCids : [ContractId QueuedRedeemRequest]
          -- ^ The requests to fill; each adds a leg to each registry's batch, and every registry accepts 25.
        priceCids : [ContractId PeriodPrice]
          -- ^ The prices struck in periods before the current one, for requests filled late.
        poolHoldingCids : [ContractId V2.Holding]
          -- ^ The custodian's holdings to pay from; only those the payout needs are used.
        heldHoldingCids : [ContractId V2.Holding]
          -- ^ The redemption account's holdings, for requests filled in part before; only those needed are used.
        underlyingExtraArgs : ExtraArgs
          -- ^ The underlying registry's context for allocating and settling.
        shareExtraArgs : ExtraArgs
          -- ^ The share registry's context for allocating and settling.
      controller executors
      do
        requirePeriodOpen (instantOf' this)
        require "fulfils at least one request" (requestCids /= [])
        requests <- forA requestCids $ \cid -> do
          request <- fetch cid
          require' ("request.vaultRegistrar", request.vaultRegistrar) isEqualR ("vaultRegistrar", vaultRegistrar)
          archive cid
          pure request
        requireDistinct [(r.owner, r.label) | r <- requests]
          ([r.shareAllocation | r <- requests, isNone r.filledIn] <> map (.underlyingAllocation) requests)
        forA_ requests $ \r -> do
          require "a request is filled after the period it was made in" (r.epoch < epoch)
          require "a request is filled at most once a period" (r.filledIn /= Some epoch)
        prices <- forA priceCids $ \cid -> do
          price <- fetch cid
          require' ("price.vaultRegistrar", price.vaultRegistrar) isEqualR ("vaultRegistrar", vaultRegistrar)
          require' ("price.vaultId", price.vaultId) isEqualR ("vaultId", vaultId)
          pure price
        let held = redemptionAccount vaultRegistrar
        -- Each leg uses the account its allocation names, which may have a provider.
        fills <- forA requests $ \r -> do
          sender <- if isNone r.filledIn then (.allocation.authorizer) . view <$> fetch r.shareAllocation else pure held
          receiving <- checkReceipt this r.receiver r.expiresAt r.underlyingAllocation
          fraction <- fillFraction this r.epoch
          let filled = if fraction == 1.0 then r.shares else mulDivDown r.shares fraction 1.0
          require "each request fills a positive number of shares" (filled > 0.0)
          (struckShares, struckAssets) <- struckFor r.epoch epoch (totalShares, totalAssets) prices
          let paid = min (sharesToAssets struckShares struckAssets filled) (sharesToAssets totalShares totalAssets filled)
              assets = deductFeeBps redeemFeeBps paid
          case r.minAssetsOut of
            Some limit | assets < mulDivUp limit filled r.shares -> fail (vaultSlippageExceeded <> ": request " <> r.label)
            _ -> pure ()
          pure Fill with request = r; sender; receiving; filled; assets
        let settlement = settlementFor this
            escrowLeg f = V2.TransferLeg with
              transferLegId = requestLegId f.request.owner f.request.label "shares"
              sender = f.sender
              receiver = held
              amount = f.request.shares
              instrumentId = shareInstrument.id
              meta = emptyMetadata
            burnLeg f = V2.TransferLeg with
              transferLegId = requestLegId f.request.owner f.request.label ("burn/" <> show epoch)
              sender = held
              receiver = burnAccount
              amount = f.filled
              instrumentId = shareInstrument.id
              meta = emptyMetadata
            payoutLeg f = V2.TransferLeg with
              transferLegId = requestLegId f.request.owner f.request.label "underlying"
              sender = basicAccount custodian
              receiver = f.receiving
              amount = f.assets
              instrumentId = underlyingInstrument.id
              meta = emptyMetadata
            fresh = [f | f <- fills, isNone f.request.filledIn]
            payout = sum (map (.assets) fills)
            burned = sum (map (.filled) fills)
            partial f = f.filled < f.request.shares
        forA_ fills $ \f -> require "each request pays out a positive amount" (f.assets > 0.0)
        pool <- coveringHoldings payout poolHoldingCids

        received <- if null fresh then pure [] else do
          heldSide <- allocateSides shareFactories shareExtraArgs settlement rateValidFrom vaultRegistrar
            held [vaultRegistrar] [] [receiverSide (escrowLeg f) | f <- fresh]
          result <- exercise shareFactories.settlementFactory V2.SettlementFactory_SettleBatch with
            settlement
            transferLegs = map escrowLeg fresh
            allocations = finalized heldSide [] :: [finalized f.request.shareAllocation [] | f <- fresh]
            actors = executors
            extraArgs = shareExtraArgs
          pure (receivedHoldings shareInstrument.id result)
        burnInputs <- coveringHoldings burned (received <> heldHoldingCids)
        burnSide <- allocateSides shareFactories shareExtraArgs settlement rateValidFrom vaultRegistrar
          held [vaultRegistrar] burnInputs [senderSide (burnLeg f) | f <- fills]
        burnedSide <- allocateSides shareFactories shareExtraArgs settlement rateValidFrom vaultRegistrar
          burnAccount [vaultRegistrar] [] [receiverSide (burnLeg f) | f <- fills]
        _ <- exercise shareFactories.settlementFactory V2.SettlementFactory_SettleBatch with
          settlement
          transferLegs = map burnLeg fills
          allocations = [finalized burnSide [], finalized burnedSide []]
          actors = executors
          extraArgs = shareExtraArgs

        custodianSide <- allocateSides underlyingFactories underlyingExtraArgs settlement rateValidFrom underlyingInstrument.admin
          (basicAccount custodian) [custodian] pool [senderSide (payoutLeg f) | f <- fills]
        settled <- exercise underlyingFactories.settlementFactory V2.SettlementFactory_SettleBatch with
          settlement
          transferLegs = map payoutLeg fills
          -- A receipt stays open for the rest of a request filled in part.
          allocations = finalized custodianSide []
            :: [ (finalized f.request.underlyingAllocation [receiverSide (payoutLeg f)])
                   with nextIterationFunding = if partial f then Some TextMap.empty else None
               | f <- fills ]
          actors = executors
          extraArgs = underlyingExtraArgs

        forA_ (zip fills (drop 1 settled.allocationSettleResults)) $ \(f, result) -> when (partial f) do
          next <- case result.output of
            V2.AllocationResult_Settled {nextIterationAllocationCid = Some cid} -> pure cid
            _ -> fail "the receipt authorization stays open for the rest of the request"
          void $ create f.request with
            shares = f.request.shares - f.filled
            underlyingAllocation = next
            minAssetsOut = fmap (\m -> mulDivDown m (f.request.shares - f.filled) f.request.shares) f.request.minAssetsOut
            filledIn = Some epoch
        recordFlow (instantOf' this) (negate payout) (negate burned)
        reportQueued vaultRegistrar
          [ eventOf f.request (if partial f then PartlyFilled with received = f.assets; filled = f.filled
                               else Fulfilled with received = f.assets)
          | f <- fills ]

    nonconsuming choice ReferenceQueuedRedeemVault_Reject : ()
      -- ^ End requests that cannot settle, returning each escrow and recording why. A request that
      -- fails fails its whole batch, so executors dry-run a batch, settle the rest and reject it.
      with
        requestCids : [ContractId QueuedRedeemRequest]
        reason : Text
          -- ^ Why the requests cannot settle, kept on each rejection record.
        shareExtraArgs : ExtraArgs
          -- ^ The share registry's context for cancelling the escrows.
      controller executors
      do
        events <- forA requestCids $ \cid -> do
          request <- fetch cid
          require' ("request.vaultRegistrar", request.vaultRegistrar) isEqualR ("vaultRegistrar", vaultRegistrar)
          require "a request filled in part is returned by its owner's reclaim" (isNone request.filledIn)
          archive cid
          _ <- exercise request.shareAllocation V2.Allocation_Cancel with actors = executors; extraArgs = shareExtraArgs
          pure (eventOf request (Rejected with reason))
        reportQueued vaultRegistrar events

    choice ReferenceQueuedRedeemVault_SetPriceLimits : ContractId ReferenceQueuedRedeemVault
      -- ^ Change the price limits, which the custodian must agree to.
      with
        limits : PriceLimits
      controller vaultRegistrar, custodian
      do create this with priceLimits = limits

    choice ReferenceQueuedRedeemVault_SetPaused : ContractId ReferenceQueuedRedeemVault
      -- ^ Pause or resume deposits and mints.
      with
        pause : Bool
      controller vaultRegistrar
      do create this with paused = pause

    choice ReferenceQueuedRedeemVault_SetFactories : ContractId ReferenceQueuedRedeemVault
      -- ^ Pin other factories, when a registry replaces its own.
      with
        transferFactory : ContractId V2.TransferFactory
        underlying : Factories
        shares : Factories
      controller vaultRegistrar
      do
        -- Catches pinning another registry's factories by mistake.
        transferView <- exercise transferFactory V2.TransferFactory_PublicFetch with actors = [vaultRegistrar]
        require' ("transfer factory admin", transferView.admin) isEqualR ("underlying admin", underlyingInstrument.admin)
        requireFactoriesOf vaultRegistrar underlyingInstrument.admin underlying
        requireFactoriesOf vaultRegistrar vaultRegistrar shares
        create this with
          underlyingTransferFactory = transferFactory
          underlyingFactories = underlying
          shareFactories = shares

    choice ReferenceQueuedRedeemVault_ClosePeriod : ContractId ClosedQueuedRedeemPeriod
      -- ^ End the period; deposits, requests and fulfilments against this vault fail from here on.
      controller vaultRegistrar
      do create ClosedQueuedRedeemPeriod with vault = this

-- | A queued-redemption vault's period that takes no more actions, so its flows are final when it is opened again.
template ClosedQueuedRedeemPeriod
  with
    vault : ReferenceQueuedRedeemVault
  where
    signatory vault.vaultRegistrar, vault.custodian

    choice ClosedQueuedRedeemPeriod_Open : ContractId ReferenceQueuedRedeemVault
      -- ^ Open the next period, folding in the flows not yet counted and pricing it from the evidence.
      with
        flowCids : [ContractId PeriodFlow]
        evidence : PriceEvidence
        validUntil : Time
        allotments : [(Int, Decimal)]
          -- ^ The share of each earlier period's unfilled requests the new period fills, the oldest first.
      controller vault.vaultRegistrar
      do
        (shares, assets, pricing, now) <- rollTotals (instantOf' vault) flowCids evidence validUntil
        requirePriceWithinLimits vault.priceLimits (instantOf' vault) shares assets
        openNext vault shares assets pricing allotments now validUntil

    choice ClosedQueuedRedeemPeriod_OpenBeyondLimits : ContractId ReferenceQueuedRedeemVault
      -- ^ Open the next period at a price outside the vault's limits, on the custodian's word as well.
      with
        flowCids : [ContractId PeriodFlow]
        evidence : PriceEvidence
        validUntil : Time
        allotments : [(Int, Decimal)]
      controller vault.vaultRegistrar, vault.custodian
      do
        (shares, assets, pricing, now) <- rollTotals (instantOf' vault) flowCids evidence validUntil
        openNext vault shares assets pricing allotments now validUntil

    choice ClosedQueuedRedeemPeriod_Reopen : ContractId ReferenceQueuedRedeemVault
      -- ^ Undo the close when the next period cannot be opened, restoring the vault as it was.
      controller vault.vaultRegistrar
      do create vault

-- | A queued redemption, binding its escrow to its receiver's authorization until it is fulfilled.
template QueuedRedeemRequest
  with
    vaultId : Text
    vaultRegistrar : Party
    executors : [Party]
    owner : Party
    receiver : Party
    label : Text
    shares : Decimal
    shareAllocation : ContractId V2.Allocation
      -- ^ The owner's escrowed shares.
    underlyingAllocation : ContractId V2.Allocation
      -- ^ The receiver's authorization to be paid.
    expiresAt : Time
      -- ^ The escrow's deadline, after which it cannot be fulfilled.
    epoch : Int
      -- ^ The period the request was made in, which is its id.
    minAssetsOut : Optional Decimal
      -- ^ The least underlying the receiver accepts; fulfilment below it fails.
    filledIn : Optional Int
      -- ^ The period the request was last filled in part, after which the redemption account holds the rest.
  where
    signatory vaultRegistrar
    observer owner, receiver, executors

    choice QueuedRedeemRequest_Archive : ()
      -- ^ Drop a request: the owner or an executor at any time, the registrar once it has expired.
      with
        actor : Party
      controller actor
      do
        require "a request filled in part is closed by fulfilment or its owner's reclaim" (isNone filledIn)
        unless (actor `elem` (owner :: executors)) do
          expired <- isLedgerTimeGE expiresAt
          require "the owner or an executor drops a request, or the registrar once it has expired"
            (actor == vaultRegistrar && expired)

    choice QueuedRedeemRequest_Reclaim : ()
      -- ^ Return the shares not yet filled of a request filled in part to its owner, ending the request.
      with
        vaultCid : ContractId ReferenceQueuedRedeemVault
        heldHoldingCids : [ContractId V2.Holding]
          -- ^ The redemption account's holdings to return from; only those needed are used.
        shareExtraArgs : ExtraArgs
          -- ^ The share registry's context for allocating and settling.
      controller owner
      do
        require "only a request filled in part is reclaimed" (isSome filledIn)
        vault <- fetch vaultCid
        require' ("vault.vaultId", vault.vaultId) isEqualR ("vaultId", vaultId)
        require' ("vault.vaultRegistrar", vault.vaultRegistrar) isEqualR ("vaultRegistrar", vaultRegistrar)
        let held = redemptionAccount vaultRegistrar
            settlement = V2.SettlementInfo with
              executors = [vaultRegistrar]; id = vaultId <> "/returns"; cid = None; meta = emptyMetadata
            leg = V2.TransferLeg with
              transferLegId = requestLegId owner label "return"
              sender = held
              receiver = basicAccount owner
              amount = shares
              instrumentId = vault.shareInstrument.id
              meta = emptyMetadata
        inputs <- coveringHoldings shares heldHoldingCids
        from <- allocateSides vault.shareFactories shareExtraArgs settlement vault.rateValidFrom vaultRegistrar
          held [vaultRegistrar] inputs [senderSide leg]
        to <- allocateSides vault.shareFactories shareExtraArgs settlement vault.rateValidFrom vaultRegistrar
          (basicAccount owner) [owner] [] [receiverSide leg]
        _ <- exercise vault.shareFactories.settlementFactory V2.SettlementFactory_SettleBatch with
          settlement
          transferLegs = [leg]
          allocations = [finalized from [], finalized to []]
          actors = [vaultRegistrar]
          extraArgs = shareExtraArgs
        reportQueued vaultRegistrar [eventOf this Reclaimed]

-- | The same vault as an instant one, for everything but redemptions.
instantOf' : ReferenceQueuedRedeemVault -> ReferenceVault
instantOf' v = ReferenceVault with
  vaultId = v.vaultId
  vaultRegistrar = v.vaultRegistrar
  custodian = v.custodian
  underlyingInstrument = v.underlyingInstrument
  shareInstrument = v.shareInstrument
  totalShares = v.totalShares
  totalAssets = v.totalAssets
  pricing = v.pricing
  accrual = v.accrual
  depositFeeBps = v.depositFeeBps
  redeemFeeBps = v.redeemFeeBps
  rateValidFrom = v.rateValidFrom
  rateValidUntil = v.rateValidUntil
  depositCap = v.depositCap
  paused = v.paused
  underlyingTransferFactory = v.underlyingTransferFactory
  priceLimits = v.priceLimits

instantOf : ReferenceQueuedRedeemVault -> Vault
instantOf = toInterface . instantOf'

settlementFor : ReferenceQueuedRedeemVault -> V2.SettlementInfo
settlementFor v = V2.SettlementInfo with
  executors = v.executors
  id = requestSettlementId v.vaultId
  cid = None
  meta = emptyMetadata

-- | Refuses a receipt authorization that is not the receiver's committed, leg-less one for the vault's settlement,
-- lasting as long as the escrow, which covered the vault's window when requested. Returns the account it pays.
checkReceipt : ReferenceQueuedRedeemVault -> Party -> Time -> ContractId V2.Allocation -> Update V2.Account
checkReceipt v receiver escrowDeadline cid = do
  receiving <- fetchSigned "receipt authorization" v.underlyingInstrument.admin cid
  require' ("receipt authorization.settlement", receiving.settlement) isEqualR ("settlement", settlementFor v)
  require' ("receipt authorization.authorizer.owner", receiving.allocation.authorizer.owner) isEqualR
    ("receiver", Some receiver)
  -- The payout is set at fulfilment, which adds the receiving leg.
  require "receipt authorization names no legs" (receiving.allocation.transferLegSides == [])
  require "receipt authorization allows the executors to add a leg"
    (receiving.allocation.nextIterationFunding == Some TextMap.empty)
  require "receipt authorization is committed" receiving.allocation.committed
  authorizationDeadline <- deadlineOf receiving.allocation
  require "the receipt authorization lasts as long as the escrow" (authorizationDeadline >= escrowDeadline)
  pure receiving.allocation.authorizer

-- | Opens the next period at the totals measured, keeping the price it strikes.
openNext : ReferenceQueuedRedeemVault -> Decimal -> Decimal -> Pricing -> [(Int, Decimal)] -> Time -> Time -> Update (ContractId ReferenceQueuedRedeemVault)
openNext v shares assets pricing allotments now validUntil = do
  let next = v.epoch + 1
  _ <- create PeriodPrice with
    vaultId = v.vaultId
    vaultRegistrar = v.vaultRegistrar
    executors = v.executors
    epoch = next
    totalShares = shares
    totalAssets = assets
  create v with
    totalShares = shares
    totalAssets = assets
    pricing
    allotments
    rateValidFrom = now
    rateValidUntil = validUntil
    epoch = next

-- | One request's part of a fulfilment.
data Fill = Fill with
    request : QueuedRedeemRequest
    sender : V2.Account
      -- ^ The account the escrow sends from, or the redemption account once it holds the shares.
    receiving : V2.Account
    filled : Decimal
      -- ^ The shares filled now.
    assets : Decimal
      -- ^ The underlying paid for them.

-- | The share of a period's requests the current period fills; a vault priced from its pool fills them whole.
fillFraction : ReferenceQueuedRedeemVault -> Int -> Update Decimal
fillFraction v requestEpoch = case v.pricing of
  PoolPricing -> pure 1.0
  OraclePricing {} -> case lookup requestEpoch v.allotments of
    Some fraction -> pure fraction
    None -> fail ("no allotment this period for requests of period " <> show requestEpoch)

-- | Allotments name earlier periods once each, with a share above nothing and at most all.
validAllotments : Pricing -> Int -> [(Int, Decimal)] -> Bool
validAllotments pricing epoch allotments = case pricing of
  PoolPricing -> null allotments
  OraclePricing {} -> unique (map fst allotments)
    && all (\(e, fraction) -> e < epoch && fraction > 0.0 && fraction <= 1.0) allotments

-- | The holdings of the instrument the first allocation's authorizer received in a settlement.
receivedHoldings : Text -> V2.SettlementFactory_SettleBatchResult -> [ContractId V2.Holding]
receivedHoldings instrumentId result = case result.allocationSettleResults of
  first :: _ -> fromOptional [] (TextMap.lookup instrumentId first.authorizerHoldingCids)
  [] -> []

eventOf : QueuedRedeemRequest -> Outcome -> QueuedEvent
eventOf r outcome = QueuedEvent with
  vaultId = r.vaultId
  requester = r.owner
  receiver = r.receiver
  label = r.label
  requestId = r.epoch
  requested = r.shares
  outcome

-- | Types and interfaces for tokenized vaults, built on CIP-56/112.
--
-- A vault accepts deposits of a single underlying instrument and issues share
-- holdings against them. Shares are ordinary token standard holdings.
--
-- Every vault implements `Vault`. Queued deposits and redemptions are in their
-- own packages, as are the event log and delegated access, and the types they
-- share are defined here.
module Canton.Vault.V1 where

import DA.Time (RelTime)

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2

--
-- Types
---------

-- | Per-second yield model used to accrue a vault's total assets.
--
-- Assets accrued from `Rate.asOf` to time `t` are, in Daml `Decimal`
-- arithmetic evaluated as written, `totalAssets * (1.0 + ratePerSecond * dt)`
-- for `AccrualSimple` and `totalAssets * exp (ratePerSecond * dt)` for
-- `AccrualCompounding`, where `exp` is `DA.Math.exp` and `dt` is the
-- microseconds from `asOf` to `t` divided by `1000000.0`. When `dt` is not
-- positive, assets do not accrue.
data Accrual
  = AccrualSimple with
      ratePerSecond : Decimal
        -- ^ The simple-linear rate (APR): assets grow by this fraction of
        -- their value at `asOf` for every elapsed second.
  | AccrualCompounding with
      ratePerSecond : Decimal
        -- ^ The continuously-compounding rate (APY).
  deriving (Show, Eq, Serializable)

-- | A price from outside the ledger that a vault's value depends on.
data PriceInput = PriceInput with
    authority : Party
      -- ^ The party that published the price.
    subject : Text
      -- ^ What it prices: an instrument, a position, or the vault as a whole.
    effectiveAt : Time
      -- ^ The time the price was taken.
    attestationId : Text
      -- ^ The authority's identifier for the price.
  deriving (Show, Eq, Serializable)

-- | Share price: `VaultView.totalAssets` plus `virtualAssets` over
-- `VaultView.totalShares` plus `virtualShares`, fixed for the period on the
-- view except as the accrual moves it.
data Rate = Rate with
    asOf : Time
      -- ^ The time the totals this rate prices were taken.
    accrual : Optional Accrual
      -- ^ The model by which assets accrue after `asOf`, if any. The vault and
      -- off-ledger readers MUST both accrue `VaultView.totalAssets` by it, and
      -- not `virtualAssets`.
    inputs : [PriceInput]
      -- ^ The prices from outside the ledger the totals depend on. Empty when
      -- they are derived entirely from on-ledger state.
  deriving (Show, Eq, Serializable)

-- | Everything a wallet needs to quote a vault and decide whether to transact.
--
-- Wallets cannot call the read methods, so this view is the whole off-ledger
-- surface. Implementations serve it as a `created_event_blob` from an endpoint
-- published in the CNS metadata of `vaultRegistrar`, and wallets attach it as
-- an explicit disclosure.
data VaultView = VaultView with
    vaultId : Text
      -- ^ The identifier of the vault, unique per registrar and stable across
      -- archives, so wallets key on it rather than on a contract id.
    vaultRegistrar : Party
      -- ^ The admin of the share instrument, and the party that operates the
      -- vault.
    custodian : Account
      -- ^ The account holding the vault's assets. A contract cannot own
      -- holdings, so a vault names an account for them; it MUST have an owner,
      -- and that owner MUST be a signatory of the vault.
    underlyingInstrument : InstrumentId
      -- ^ The instrument the vault accepts. There is exactly one per vault.
    shareInstrument : InstrumentId
      -- ^ The instrument the vault issues, administered by `vaultRegistrar`.
    totalShares : Decimal
      -- ^ The shares in issue as of `rateValidFrom`: a snapshot, not a live
      -- total.
    totalAssets : Decimal
      -- ^ The value of the vault's assets in the underlying as of
      -- `rateValidFrom`, counting only assets that belong to this vault.
    virtualShares : Decimal
      -- ^ The shares the vault counts on top of `totalShares` when it prices,
      -- so that the first deposit cannot set the price; zero for none.
    virtualAssets : Decimal
      -- ^ The assets the vault counts on top of `totalAssets` when it prices;
      -- zero for none.
    rate : Rate
      -- ^ The share price, fixed for the period below. A rate with an accrual
      -- still moves within the period, but its parameters do not.
    depositFeeBps : Int
      -- ^ The fee on `Vault_Deposit`, in basis points of the assets paid in.
    mintFeeBps : Int
      -- ^ The fee on `Vault_Mint`, in basis points of the assets paid in.
    withdrawFeeBps : Int
      -- ^ The fee on `Vault_Withdraw`, in basis points of what the shares are
      -- worth.
    redeemFeeBps : Int
      -- ^ The fee on `Vault_Redeem`, in basis points of what the shares are
      -- worth.
    rateValidFrom : Time
      -- ^ The start of the period this rate applies to.
    rateValidUntil : Time
      -- ^ The end of the period. Actions MUST fail at or after this time,
      -- until the vault publishes a new rate.
    meta : Metadata
      -- ^ Additional metadata specific to the vault, used for extensibility,
      -- and, for a vault open only to some parties, the evidence it accepts
      -- under `eligibilityKey`.
  deriving (Show, Eq, Serializable)

-- | The key for eligibility: in the `VaultView` metadata, the evidence a vault
-- open only to some parties accepts, such as a credential from an issuer it
-- names or an access contract of its own, as free text; in `extraArgs`, the
-- contracts presented as the receiver's evidence. A vault open to every party
-- omits it.
eligibilityKey : Text
eligibilityKey = "canton-vault/eligibility"

-- | The result of an instant deposit, mint, withdrawal or redemption.
data VaultActionResult = VaultActionResult with
    vaultCid : Optional (ContractId Vault)
      -- ^ The vault's new contract, set only when the implementation rewrote
      -- the vault.
    assets : Decimal
      -- ^ The units of the underlying that moved.
    shares : Decimal
      -- ^ The shares minted or burned.
    holdingCids : [ContractId Holding]
      -- ^ The holdings created for the receiver, if the registry represents
      -- them on-ledger.
    meta : Metadata
      -- ^ Additional metadata specific to the result of the action, used for
      -- extensibility; e.g., fees charged.
  deriving (Show, Eq, Serializable)

-- | The text a vault fails with when an action or a fill would breach the
-- caller's slippage limit or the requester's minimum.
vaultSlippageExceeded : Text
vaultSlippageExceeded = "VAULT_SLIPPAGE_EXCEEDED"

--
-- Queued requests
-------------------

-- | Identifies a queued deposit or redemption, together with its requester's
-- account.
--
-- The vault chooses its ids, for deposits and redemptions separately: a
-- deposit and a redemption sharing an id are unrelated. Requests sharing an id
-- other than `0` are fungible: the vault MUST fill them together, at the same
-- rate, leaving none queued that it could fill at that rate, and when it fills
-- them in part, in the same proportion. `0` promises no such
-- grouping: requests under it are told apart only by their requester, and what
-- is pending under it is all the requester has queued. A vault MUST give every
-- request in a direction the id `0`, or none of them. When and how a request is
-- priced is the vault's own, and it says so on its `AsyncView`.
type RequestId = Int

-- | What a wallet needs to decide whether to queue a request with a vault.
--
-- Served alongside the `VaultView`, as the view of each queued-request
-- interface the vault implements; a vault may set them differently for
-- deposits and redemptions.
data AsyncView = AsyncView with
    executors : [Party]
      -- ^ The parties who settle and cancel requests: the executors of the
      -- token standard settlement every request's allocations carry.
    settlementDeadlineWindow : RelTime
      -- ^ The longest a request's escrow stays committed after the end of its
      -- period: the time the executors have to fill it. Until the deadline
      -- only the executors can settle or cancel it; after it, the requester can
      -- withdraw it.
    meta : Metadata
      -- ^ The vault's request pricing, under `requestPricingKey`, and any
      -- extensions specific to the vault.
  deriving (Show, Eq, Serializable)

-- | The `AsyncView` metadata key saying when a request's rate is struck. Free
-- text; recommended values are `"period-close"` and `"fulfilment"`. A vault
-- MUST set it, and MUST NOT strike a request's rate when the request is made.
requestPricingKey : Text
requestPricingKey = "canton-vault/request-pricing"

--
-- Vault
---------

-- | An interface for depositing into and redeeming from a vault, covering its
-- share accounting, limits and instant actions. Every conformant vault
-- implements it, including vaults whose deposits or redemptions are queued.
--
-- The read methods run on-ledger, and MUST agree with the published view: a
-- reader computing from the view gets the figures they return. Every quantity
-- MUST round in the vault's favour, in the direction given per method below,
-- and a deposit or mint that would issue zero shares MUST fail.
--
-- From the view, with `S` its `totalShares` plus `virtualShares` and `A` its
-- `totalAssets` accrued to the evaluation time plus `virtualAssets`, the read
-- methods MUST return, each product and quotient exact before it is rounded to
-- 10 decimals in the direction named:
--
-- * `convertToShares a = down (a * S / A)`, `convertToAssets s = down (s * A / S)`
-- * `previewDeposit a = down (net depositFeeBps a * S / A)`
-- * `previewMint s = gross mintFeeBps (up (s * A / S))`
-- * `previewWithdraw a = up (gross withdrawFeeBps a * S / A)`
-- * `previewRedeem s = net redeemFeeBps (down (s * A / S))`
--
-- where `net f x = x - up (x * f / 10000)` and `gross f x` is the least `g`, in
-- steps of 10^-10, with `net f g >= x`.
--
-- Accounts are the token standard's. A vault MUST refuse an account with no
-- owner, which the token standard reserves for the instrument admin. A vault
-- MUST accept the basic account (`Account (Some p) None ""`) of a party it is
-- open to, and MAY refuse accounts with a provider or a non-empty id; its max
-- methods return zero for an account it refuses.
--
-- A vault open only to some parties checks the evidence named in `extraArgs`
-- under `eligibilityKey` before letting a receiver in: `maxDeposit` and
-- `maxMint` MUST return zero for a receiver without evidence it accepts, and
-- `Vault_Deposit`, `Vault_Mint` and `Vault_RequestDeposit` MUST fail for one.
-- Whether an owner without it may still withdraw or redeem is the vault's own,
-- and its max methods say so.
--
-- Choices a vault adds for its own roles, such as filling requests or
-- publishing a price, MUST take their controllers from the vault contract
-- rather than from an argument.
interface Vault where
  viewtype VaultView

  -- | Shares that `assets` units of the underlying are worth, ignoring fees and
  -- limits. Rounds down.
  convertToShares : Decimal -> Update Decimal

  -- | Units of the underlying that `shares` are worth, ignoring fees and limits.
  -- Rounds down.
  convertToAssets : Decimal -> Update Decimal

  -- | Most of the underlying one `Vault_Deposit` may pay in for the receiver
  -- account, after limits, capacity and eligibility. A deposit of no more MUST
  -- NOT fail for the vault's limits, and one of more MUST fail. Zero means the
  -- account cannot be deposited for right now.
  --
  -- A vault cannot look up what an account holds, so the answers below depend
  -- on the holdings named in `extraArgs`. A caller that names none gets the
  -- vault's own limit rather than theirs.
  maxDeposit : Account -> ExtraArgs -> Update Decimal

  -- | Most shares the receiver account may mint in one `Vault_Mint`, with the
  -- fee included in what counts against any limit. Exact, and zero, as for
  -- `maxDeposit`.
  maxMint : Account -> ExtraArgs -> Update Decimal

  -- | Most of the underlying the owner account's named share holdings can
  -- withdraw in one `Vault_Withdraw`, after the fee. A vault whose value can
  -- sit outside its pool, such as one with an attested rate, also caps it at
  -- what it can pay at once, as the contracts named in `extraArgs` show. Exact
  -- as for `maxDeposit`.
  maxWithdraw : Account -> ExtraArgs -> Update Decimal

  -- | The owner account's named share holdings, capped as for `maxWithdraw`.
  -- Exact as for `maxDeposit`.
  maxRedeem : Account -> ExtraArgs -> Update Decimal

  -- | Shares `assets` would mint, including fees: what `Vault_Deposit` issues
  -- if exercised in the same transaction. Rounds down.
  --
  -- A vault that queues deposits MUST fail this method: a queued request is
  -- not priced when it is made.
  previewDeposit : Decimal -> Update Decimal

  -- | Assets required to mint `shares`, including fees: what `Vault_Mint`
  -- takes if exercised in the same transaction. Rounds up.
  --
  -- A vault that queues deposits MUST fail this method.
  previewMint : Decimal -> Update Decimal

  -- | Shares burned to withdraw `assets`, including fees: what
  -- `Vault_Withdraw` burns if exercised in the same transaction. Rounds up.
  --
  -- A vault that queues redemptions MUST fail this method.
  previewWithdraw : Decimal -> Update Decimal

  -- | Assets returned for `shares`, including fees: what `Vault_Redeem` pays
  -- if exercised in the same transaction. Rounds down.
  --
  -- A vault that queues redemptions MUST fail this method.
  previewRedeem : Decimal -> Update Decimal

  vault_depositImpl : ContractId Vault -> Vault_Deposit -> Update VaultActionResult
  vault_mintImpl : ContractId Vault -> Vault_Mint -> Update VaultActionResult
  vault_withdrawImpl : ContractId Vault -> Vault_Withdraw -> Update VaultActionResult
  vault_redeemImpl : ContractId Vault -> Vault_Redeem -> Update VaultActionResult
  vault_publicFetchImpl : ContractId Vault -> Vault_PublicFetch -> Update VaultView
  vault_publicConvertToAssetsImpl : ContractId Vault -> Vault_PublicConvertToAssets -> Update Decimal

  vault_depositExtraObservers : Vault_Deposit -> [Party]
  vault_mintExtraObservers : Vault_Mint -> [Party]
  vault_withdrawExtraObservers : Vault_Withdraw -> [Party]
  vault_redeemExtraObservers : Vault_Redeem -> [Party]

  nonconsuming choice Vault_Deposit : VaultActionResult
    -- ^ Deposit `assets` of the underlying from `sender` and issue shares to
    -- `receiver`.
    --
    -- Implementations MUST move the underlying to the `custodian` account and
    -- issue the shares in the same transaction, and MUST NOT issue shares
    -- against a transfer that is still pending: a registry may answer with a
    -- `TransferInstruction` rather than complete it.
    --
    -- Implementations MUST fail with `vaultSlippageExceeded`, changing
    -- nothing, if fewer than `minSharesOut` shares would be issued.
    with
      assets : Decimal
        -- ^ The units of the underlying to deposit.
      sender : Account
        -- ^ The account the underlying is paid from.
      receiver : Account
        -- ^ The account the shares are issued to.
      minSharesOut : Optional Decimal
        -- ^ The fewest shares the caller accepts, or `None` for any rate.
      actors : [Party]
        -- ^ The parties executing the deposit.
        --
        -- Implementations MUST check these parties against `sender`, to avoid
        -- unauthorized deposits.
      extraArgs : ExtraArgs
        -- ^ Additional context required in order to exercise the choice.
    observer vault_depositExtraObservers this arg
    controller actors
    do vault_depositImpl this self arg

  nonconsuming choice Vault_Mint : VaultActionResult
    -- ^ Issue exactly `shares` to `receiver`, taking the underlying they cost
    -- from `sender`.
    --
    -- Implementations MUST settle as for `Vault_Deposit`, and MUST fail with
    -- `vaultSlippageExceeded`, changing nothing, if more than `maxAssetsIn`
    -- would be taken.
    with
      shares : Decimal
        -- ^ The shares to issue.
      sender : Account
        -- ^ The account the underlying is paid from.
      receiver : Account
        -- ^ The account the shares are issued to.
      maxAssetsIn : Optional Decimal
        -- ^ The most of the underlying the caller pays, or `None` for any rate.
      actors : [Party]
        -- ^ The parties executing the mint.
        --
        -- Implementations MUST check these parties against `sender`, to avoid
        -- unauthorized mints.
      extraArgs : ExtraArgs
        -- ^ Additional context required in order to exercise the choice.
    observer vault_mintExtraObservers this arg
    controller actors
    do vault_mintImpl this self arg

  nonconsuming choice Vault_Withdraw : VaultActionResult
    -- ^ Pay exactly `assets` of the underlying to `receiver` and burn the
    -- shares they cost from `owner`.
    --
    -- Implementations MUST move the underlying from the `custodian` account and
    -- burn the shares in the same transaction, and MUST NOT burn shares against
    -- a transfer that is still pending.
    --
    -- Implementations MUST fail with `vaultSlippageExceeded`, changing
    -- nothing, if more than `maxSharesIn` shares would be burned.
    with
      assets : Decimal
        -- ^ The units of the underlying to withdraw.
      owner : Account
        -- ^ The account whose shares are burned.
      receiver : Account
        -- ^ The account paid the underlying.
      maxSharesIn : Optional Decimal
        -- ^ The most shares the caller gives up, or `None` for any rate.
      actors : [Party]
        -- ^ The parties executing the withdrawal.
        --
        -- Implementations MUST check these parties against `owner`, to avoid
        -- unauthorized withdrawals.
      extraArgs : ExtraArgs
        -- ^ Additional context required in order to exercise the choice.
    observer vault_withdrawExtraObservers this arg
    controller actors
    do vault_withdrawImpl this self arg

  nonconsuming choice Vault_Redeem : VaultActionResult
    -- ^ Burn exactly `shares` from `owner` and pay the underlying they are
    -- worth to `receiver`.
    --
    -- Implementations MUST settle as for `Vault_Withdraw`, and MUST fail with
    -- `vaultSlippageExceeded`, changing nothing, if less than `minAssetsOut`
    -- would be paid.
    with
      shares : Decimal
        -- ^ The shares to burn.
      owner : Account
        -- ^ The account whose shares are burned.
      receiver : Account
        -- ^ The account paid the underlying.
      minAssetsOut : Optional Decimal
        -- ^ The least of the underlying the caller accepts, or `None` for any
        -- rate.
      actors : [Party]
        -- ^ The parties executing the redemption.
        --
        -- Implementations MUST check these parties against `owner`, to avoid
        -- unauthorized redemptions.
      extraArgs : ExtraArgs
        -- ^ Additional context required in order to exercise the choice.
    observer vault_redeemExtraObservers this arg
    controller actors
    do vault_redeemImpl this self arg

  nonconsuming choice Vault_PublicFetch : VaultView
    -- ^ The vault's view, for a party it is disclosed to.
    --
    -- Fetching a vault needs the authority of one of its stakeholders, so a
    -- contract of another party reads it through this choice. The vault MAY
    -- refuse actors it has not chosen to serve; what it returns MUST be its
    -- view.
    with
      actors : [Party]
        -- ^ The parties executing the fetch.
    controller actors
    do vault_publicFetchImpl this self arg

  nonconsuming choice Vault_PublicConvertToAssets : Decimal
    -- ^ `convertToAssets` of `shares`, for a party the vault is disclosed to.
    -- Refused as for `Vault_PublicFetch`. Rounds down.
    with
      shares : Decimal
        -- ^ The shares to convert.
      actors : [Party]
        -- ^ The parties executing the conversion.
    controller actors
    do vault_publicConvertToAssetsImpl this self arg

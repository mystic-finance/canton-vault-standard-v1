-- | Types and interfaces for tokenized vaults, built on CIP-56/112.
--
-- A vault accepts deposits of a single underlying instrument and issues share
-- holdings against them. Shares are ordinary token standard holdings.
--
-- Every vault implements `Vault`. Queued deposits and redemptions are in their
-- own packages, as are the event log and delegated access, and the types they
-- share are defined here.
module Canton.Vault.V1 where

import DA.Time (RelTime)

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2

--
-- Types
---------

-- | Per-second yield model used to accrue a vault's total assets.
data Accrual
  = AccrualSimple with
      ratePerSecond : Decimal
        -- ^ Simple-linear accrual (APR): assets grow by `ratePerSecond` of the
        -- value at `asOf` for every elapsed second.
  | AccrualCompounding with
      ratePerSecond : Decimal
        -- ^ Continuously-compounding accrual (APY).
  deriving (Show, Eq, Serializable)

-- | A price from outside the ledger that a vault's value depends on.
data PriceInput = PriceInput with
    authority : Party
      -- ^ The party that published the price.
    subject : Text
      -- ^ What it prices: an instrument, a position, or the vault as a whole.
    effectiveAt : Time
      -- ^ The time the price was taken.
    attestationId : Text
      -- ^ The authority's identifier for the price.
  deriving (Show, Eq, Serializable)

-- | Share price: `VaultView.totalAssets` over `VaultView.totalShares`, fixed
-- for the period on the view except as the accrual moves it.
data Rate = Rate with
    asOf : Time
      -- ^ When the totals this rate prices were taken.
    accrual : Optional Accrual
      -- ^ The model by which assets accrue after `asOf`. Both the vault and
      -- off-ledger readers accrue `VaultView.totalAssets` forwards using it.
    inputs : [PriceInput]
      -- ^ The prices from outside the ledger the totals depend on. Empty when
      -- they are derived entirely from on-ledger state.
  deriving (Show, Eq, Serializable)

-- | Everything a wallet needs to quote a vault and decide whether to transact.
--
-- Wallets cannot call the read methods, so this view is the whole off-ledger
-- surface. Implementations serve it as a `created_event_blob` from an endpoint
-- published in the CNS metadata of `vaultRegistrar`, and wallets attach it as
-- an explicit disclosure.
data VaultView = VaultView with
    vaultId : Text
      -- ^ The identifier of the vault, unique per registrar and stable across
      -- archives, so wallets key on it rather than on a contract id.
    vaultRegistrar : Party
      -- ^ Admin of the share instrument, and the party that operates the vault.
    custodian : Party
      -- ^ The party holding the vault's assets. A contract cannot own holdings,
      -- so a vault names a party for them.
    underlyingInstrument : InstrumentId
      -- ^ The instrument the vault accepts. There is exactly one per vault.
    shareInstrument : InstrumentId
      -- ^ The instrument the vault issues, administered by `vaultRegistrar`.
    totalShares : Decimal
      -- ^ Shares in issue as of `rateValidFrom`. A snapshot rather than a live
      -- total, since actions are nonconsuming and do not rewrite the vault.
    totalAssets : Decimal
      -- ^ Value of the vault's assets in the underlying as of `rateValidFrom`,
      -- with the same staleness, counting only assets that belong to this
      -- vault. Includes any virtual offset, so that off-ledger math matches
      -- on-ledger.
    rate : Rate
      -- ^ Share price, fixed for the period below. A rate with an accrual still
      -- moves within the period, but its parameters do not.
    depositFeeBps : Int
      -- ^ The fee on `Vault_Deposit`, in basis points of the assets paid in.
    mintFeeBps : Int
      -- ^ The fee on `Vault_Mint`, in basis points of the assets paid in.
    withdrawFeeBps : Int
      -- ^ The fee on `Vault_Withdraw`, in basis points of what the shares are
      -- worth.
    redeemFeeBps : Int
      -- ^ The fee on `Vault_Redeem`, in basis points of what the shares are
      -- worth.
    rateValidFrom : Time
      -- ^ Start of the period this rate applies to.
    rateValidUntil : Time
      -- ^ End of the period. Actions fail at or after this time; the registrar
      -- rolls the period, and bears that cost.
    meta : Metadata
      -- ^ Additional metadata specific to the vault, used for extensibility,
      -- and, for a vault open only to some parties, the evidence it accepts
      -- under `eligibilityKey`.
  deriving (Show, Eq, Serializable)

-- | The key for eligibility: in the `VaultView` metadata, the evidence a vault
-- open only to some parties accepts, such as a credential from an issuer it
-- names or an access contract of its own, as free text; in `extraArgs`, the
-- contracts presented as the receiver's evidence. A vault open to every party
-- omits it.
eligibilityKey : Text
eligibilityKey = "canton-vault/eligibility"

-- | The result of an instant deposit, mint, withdrawal or redemption.
data VaultActionResult = VaultActionResult with
    vaultCid : Optional (ContractId Vault)
      -- ^ Set only when the implementation rewrote the vault.
    assets : Decimal
      -- ^ Units of the underlying that moved.
    shares : Decimal
      -- ^ Shares minted or burned.
    holdingCids : [ContractId Holding]
      -- ^ Holdings created for the receiver, if the registry represents them
      -- on-ledger.
    meta : Metadata
      -- ^ Additional metadata specific to the result of the action, used for
      -- extensibility; e.g., fees charged.
  deriving (Show, Eq, Serializable)

-- | Reported when an action would breach the caller's slippage limit. The
-- action fails and nothing changes.
vaultSlippageExceeded : Text
vaultSlippageExceeded = "VAULT_SLIPPAGE_EXCEEDED"

--
-- Queued requests
-------------------

-- | Identifies a queued deposit or redemption, together with its requester.
--
-- The vault chooses its ids. Requests sharing an id other than `0` are
-- fungible: they are filled at the same time, at the same rate, and when filled
-- in part, in the same proportion. `0` means requests are told apart only by
-- their requester. When and how a request is priced is the vault's own, and it
-- says so on its `AsyncView`.
type RequestId = Int

-- | What a wallet needs to decide whether to queue a request with a vault.
--
-- Served alongside the `VaultView`, as the view of each queued-request
-- interface the vault implements; a vault may set them differently for
-- deposits and redemptions.
data AsyncView = AsyncView with
    executors : [Party]
      -- ^ The parties who settle and cancel requests: the executors of the
      -- token standard settlement every request's allocations carry.
    settlementDeadlineWindow : RelTime
      -- ^ How long after the end of its period a request's escrow stays
      -- committed: the time the executors have to fill it. Until the deadline
      -- only the executors can settle or cancel it; after it, the requester can
      -- withdraw it.
    meta : Metadata
      -- ^ The vault's request pricing, under `requestPricingKey`, and any
      -- extensions specific to the vault.
  deriving (Show, Eq, Serializable)

-- | The `AsyncView` metadata key saying when a request's rate is struck. Free
-- text; recommended values are `"period-close"`, `"fulfilment"` and `"request"`.
requestPricingKey : Text
requestPricingKey = "canton-vault/request-pricing"

--
-- Vault
---------

-- | An interface for depositing into and redeeming from a vault, covering its
-- share accounting, limits and instant actions. Every conformant vault
-- implements it, including vaults whose deposits or redemptions are queued.
--
-- The read methods run on-ledger, and agree with the published view. Every
-- quantity rounds in the vault's favour, in the direction given per method
-- below, and a deposit that would mint zero shares is rejected.
--
-- A vault open only to some parties checks the evidence named in `extraArgs`
-- under `eligibilityKey` before letting a party in: `maxDeposit` and `maxMint`
-- return zero for a receiver without evidence it accepts, and `Vault_Deposit`,
-- `Vault_Mint` and `Vault_RequestDeposit` fail for one. Whether a party without
-- it may still withdraw or redeem is the vault's own, and its max methods say
-- so.
--
-- Choices a vault adds for its own roles, such as filling requests or
-- publishing a price, take their controllers from the vault contract rather
-- than from an argument.
interface Vault where
  viewtype VaultView

  -- | Shares that `assets` units of the underlying are worth, ignoring fees and
  -- limits. Rounds down.
  convertToShares : Decimal -> Update Decimal

  -- | Units of the underlying that `shares` are worth, ignoring fees and limits.
  -- Rounds down.
  convertToAssets : Decimal -> Update Decimal

  -- | Most the party may deposit in one call, after limits, capacity and
  -- eligibility. Zero means they cannot deposit at all right now.
  --
  -- A vault cannot look up what a party holds, so the answers below depend on
  -- the holdings named in `extraArgs`. A caller that names none gets the
  -- vault's own limit rather than theirs.
  maxDeposit : Party -> ExtraArgs -> Update Decimal

  -- | Most the party may mint in one call right now, with the fee included in
  -- what counts against any limit. Zero as for `maxDeposit`.
  maxMint : Party -> ExtraArgs -> Update Decimal

  -- | Most of the underlying the party's named share holdings can withdraw,
  -- after the fee. A vault whose value can sit outside its pool, such as one
  -- with an attested rate, also caps it at what it can pay at once, as the
  -- contracts named in `extraArgs` show.
  maxWithdraw : Party -> ExtraArgs -> Update Decimal

  -- | The party's named share holdings, capped as for `maxWithdraw`.
  maxRedeem : Party -> ExtraArgs -> Update Decimal

  -- | Shares `assets` would mint, including fees. Rounds down.
  --
  -- A vault that queues deposits fails this method: a queued request is
  -- priced at fulfillment.
  previewDeposit : Decimal -> Update Decimal

  -- | Assets required to mint `shares`, including fees. Rounds up.
  --
  -- A vault that queues deposits fails this method.
  previewMint : Decimal -> Update Decimal

  -- | Shares burned to withdraw `assets`, including fees. Rounds up.
  --
  -- A vault that queues redemptions fails this method.
  previewWithdraw : Decimal -> Update Decimal

  -- | Assets returned for `shares`, including fees. Rounds down.
  --
  -- A vault that queues redemptions fails this method.
  previewRedeem : Decimal -> Update Decimal

  vault_depositImpl : ContractId Vault -> Vault_Deposit -> Update VaultActionResult
  vault_mintImpl : ContractId Vault -> Vault_Mint -> Update VaultActionResult
  vault_withdrawImpl : ContractId Vault -> Vault_Withdraw -> Update VaultActionResult
  vault_redeemImpl : ContractId Vault -> Vault_Redeem -> Update VaultActionResult
  vault_publicFetchImpl : ContractId Vault -> Vault_PublicFetch -> Update VaultView
  vault_publicConvertToAssetsImpl : ContractId Vault -> Vault_PublicConvertToAssets -> Update Decimal

  vault_depositExtraObservers : Vault_Deposit -> [Party]
  vault_mintExtraObservers : Vault_Mint -> [Party]
  vault_withdrawExtraObservers : Vault_Withdraw -> [Party]
  vault_redeemExtraObservers : Vault_Redeem -> [Party]

  nonconsuming choice Vault_Deposit : VaultActionResult
    -- ^ Deposit `assets` of the underlying and mint shares to `receiver`.
    --
    -- The underlying moves to the custodian and the shares are minted in the
    -- same transaction. A leg that is still pending never mints: a registry may
    -- answer with a `TransferInstruction` rather than execute.
    with
      assets : Decimal
        -- ^ Units of the underlying to deposit.
      receiver : Party
        -- ^ The party receiving the shares.
      minSharesOut : Optional Decimal
        -- ^ Fewest shares the caller will accept, or `None` for any rate.
      actors : [Party]
        -- ^ Parties executing the deposit.
        --
        -- Implementations MUST check these parties against the account whose
        -- underlying or shares the action moves, to avoid unauthorized
        -- actions.
      extraArgs : ExtraArgs
        -- ^ Additional context required in order to exercise the choice.
    observer vault_depositExtraObservers this arg
    controller actors
    do vault_depositImpl this self arg

  nonconsuming choice Vault_Mint : VaultActionResult
    -- ^ Mint exactly `shares` to `receiver`, taking the assets they cost.
    --
    -- Settlement requirements are as for `Vault_Deposit`.
    with
      shares : Decimal
        -- ^ Shares to mint.
      receiver : Party
        -- ^ The party receiving the shares.
      maxAssetsIn : Optional Decimal
        -- ^ Most of the underlying the caller will pay, or `None` for any rate.
      actors : [Party]
        -- ^ Parties executing the mint. Checked as for `Vault_Deposit`.
      extraArgs : ExtraArgs
        -- ^ Additional context required in order to exercise the choice.
    observer vault_mintExtraObservers this arg
    controller actors
    do vault_mintImpl this self arg

  nonconsuming choice Vault_Withdraw : VaultActionResult
    -- ^ Send exactly `assets` of the underlying to `receiver` and burn the
    -- shares they cost from `owner`.
    --
    -- The underlying moves from the custodian and the shares are burned in the
    -- same transaction. A leg that is still pending never burns.
    with
      assets : Decimal
        -- ^ Units of the underlying to withdraw.
      owner : Party
        -- ^ The party whose shares are burned.
      receiver : Party
        -- ^ The party receiving the underlying.
      maxSharesIn : Optional Decimal
        -- ^ Most shares the caller will give up, or `None` for any rate.
      actors : [Party]
        -- ^ Parties executing the withdrawal. Checked as for `Vault_Deposit`.
      extraArgs : ExtraArgs
        -- ^ Additional context required in order to exercise the choice.
    observer vault_withdrawExtraObservers this arg
    controller actors
    do vault_withdrawImpl this self arg

  nonconsuming choice Vault_Redeem : VaultActionResult
    -- ^ Burn exactly `shares` from `owner` and send the underlying they are
    -- worth to `receiver`.
    --
    -- Settlement requirements are as for `Vault_Withdraw`.
    with
      shares : Decimal
        -- ^ Shares to burn.
      owner : Party
        -- ^ The party whose shares are burned.
      receiver : Party
        -- ^ The party receiving the underlying.
      minAssetsOut : Optional Decimal
        -- ^ Least of the underlying the caller will accept, or `None` for any rate.
      actors : [Party]
        -- ^ Parties executing the redemption. Checked as for `Vault_Deposit`.
      extraArgs : ExtraArgs
        -- ^ Additional context required in order to exercise the choice.
    observer vault_redeemExtraObservers this arg
    controller actors
    do vault_redeemImpl this self arg

  nonconsuming choice Vault_PublicFetch : VaultView
    -- ^ The vault's view, for a party it is disclosed to.
    --
    -- Fetching a vault needs the authority of one of its stakeholders, so a
    -- contract of another party reads it through this choice. The vault may
    -- refuse actors it has not chosen to serve; what it returns is its view.
    with
      actors : [Party]
        -- ^ Parties executing the fetch.
    controller actors
    do vault_publicFetchImpl this self arg

  nonconsuming choice Vault_PublicConvertToAssets : Decimal
    -- ^ `convertToAssets` of `shares`, for a party the vault is disclosed to.
    -- Refused as for `Vault_PublicFetch`. Rounds down.
    with
      shares : Decimal
        -- ^ Shares to convert.
      actors : [Party]
        -- ^ Parties executing the conversion.
    controller actors
    do vault_publicConvertToAssetsImpl this self arg

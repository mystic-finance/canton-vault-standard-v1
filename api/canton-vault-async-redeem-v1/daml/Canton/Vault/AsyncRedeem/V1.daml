-- | Queued redemptions: the holder escrows shares, and is paid the underlying
-- when the vault's executors fulfil the request.
module Canton.Vault.AsyncRedeem.V1 where

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 (Holding)
import Splice.Api.Token.AllocationV2 (Allocation)

import Canton.Vault.V1

-- | An interface for queuing redemptions. A vault implements it alongside
-- `Vault` when redemptions are fulfilled later rather than at once; its
-- `Vault_Withdraw`, `Vault_Redeem`, `previewWithdraw` and `previewRedeem` then
-- fail, and its `maxWithdraw` and `maxRedeem` return zero.
--
-- The request escrows the shares: the vault allocates them from the holdings
-- the holder names, sending `shares` to the registrar's `redemptionAccount`
-- under the settlement id `requestSettlementId` with the leg id
-- `requestLegId`, committed until the end of the request's period plus the
-- vault's `settlementDeadlineWindow`. Each request so has an escrow of its own,
-- which the vault built. The receiver authorizes being paid the underlying by
-- the custodian with an allocation made before requesting, under the same
-- settlement id, with no legs, committed at least as long as the escrow and
-- issued by the underlying's registry. The executors fulfil a request at the
-- rate its `RequestId` says, settling the escrow before its deadline; how they
-- do so is the vault's own. A vault may fill a request in parts over several
-- periods, holding the rest of its shares in the redemption account meanwhile.
interface VaultAsyncRedeem requires Vault where
  viewtype AsyncView

  -- | Shares the party has queued for redemption under the request id, as the
  -- contracts named in `extraArgs` show. A vault cannot look them up, so one not
  -- named does not count, and one named twice counts once; naming one that is
  -- gone fails. A request counts until it is fulfilled, rejected or expires;
  -- the unfilled rest of one filled in part counts until it is filled or
  -- returned.
  pendingRedeemRequest : RequestId -> Party -> ExtraArgs -> Update Decimal

  vault_requestRedeemImpl : ContractId VaultAsyncRedeem -> Vault_RequestRedeem -> Update RequestId
  vault_requestRedeemExtraObservers : Vault_RequestRedeem -> [Party]

  nonconsuming choice Vault_RequestRedeem : RequestId
    -- ^ Queue a redemption of `shares`, paying `receiver` the underlying at a
    -- rate struck after the request is made, so not known when it is.
    with
      label : Text
        -- ^ The holder's label for the request, in its leg ids. Requests that
        -- share a label cannot be fulfilled together.
      shares : Decimal
        -- ^ Shares to redeem.
      receiver : Party
        -- ^ The party to be paid the underlying.
      minAssetsOut : Optional Decimal
        -- ^ The least underlying the receiver accepts; a fulfilment that would
        -- pay less fails rather than fill.
      inputHoldingCids : [ContractId Holding]
        -- ^ The holder's share holdings that fund the escrow.
      underlyingAllocation : ContractId Allocation
        -- ^ The receiver's authorization to be paid the underlying by the
        -- custodian. It has no legs of its own, leaves the settlement open to
        -- further iterations, where the executors add the payout leg, and is
        -- committed as the escrow is.
      actors : [Party]
        -- ^ Parties executing the request: the parties of the account the
        -- escrow is funded from.
      extraArgs : ExtraArgs
        -- ^ The share registry's context for allocating the escrow, and the
        -- funding account, as the instant deposit takes it.
    observer vault_requestRedeemExtraObservers this arg
    controller actors
    do vault_requestRedeemImpl this self arg

-- | Delegated access: an owner lets a delegate act for them in one vault,
-- within allowances and until an expiry.
module Canton.Vault.Delegation.V1
  ( VaultDelegateAuth(..)
  , VaultDelegateAuth_Deposit(..)
  , VaultDelegateAuth_Mint(..)
  , VaultDelegateAuth_Withdraw(..)
  , VaultDelegateAuth_Redeem(..)
  , VaultDelegateAuth_RequestDeposit(..)
  , VaultDelegateAuth_RequestRedeem(..)
  ) where

import DA.Optional (optionalToList)
import DA.Time (isLedgerTimeLT)

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2

import Canton.Vault.V1
import Canton.Vault.AsyncDeposit.V1
import Canton.Vault.AsyncRedeem.V1

-- | An owner's authorization for a delegate to act for them in one vault, as
-- an ERC-7540 operator, within allowances and until an expiry.
--
-- The delegate exercises the vault's own choice, naming this authorization
-- under `delegationKey`, and the vault exercises the matching choice here,
-- passing itself; that choice acts as the owner. Each choice needs both the
-- vault's registrar and the delegate, so only the vault, on the delegate's
-- call, can use it. The delegate pays in only from accounts the owner owns, and
-- chooses the receiver, as with an ERC-4626 allowance; a vault whose registry
-- needs an account's provider to act may refuse it. Each allowance is spent by
-- every action it covers. The owner revokes it by archiving it, which takes
-- effect at once.
template VaultDelegateAuth
  with
    owner : Party
      -- ^ The party the delegate acts for.
    delegate : Party
      -- ^ The party acting.
    vaultRegistrar : Party
      -- ^ The registrar of the vault the authorization is for.
    vaultId : Text
      -- ^ The vault the authorization is for.
    depositAllowance : Optional Decimal
      -- ^ The underlying the delegate may still pay in, across deposits, mints
      -- and deposit requests; `None` if it may not deposit.
    redeemAllowance : Optional Decimal
      -- ^ The shares the delegate may still pay out, across withdrawals,
      -- redemptions and redeem requests; `None` if it may not redeem.
    expiresAt : Time
      -- ^ The time the authorization stops working.
    meta : Metadata
      -- ^ Additional metadata, used for extensibility.
  where
    signatory owner
    observer delegate, vaultRegistrar
    ensure all (>= 0.0) (optionalToList depositAllowance <> optionalToList redeemAllowance)

    choice VaultDelegateAuth_Deposit : (ContractId VaultDelegateAuth, VaultActionResult)
      -- ^ `Vault_Deposit` from the owner's account.
      with
        vaultCid : ContractId Vault
        assets : Decimal
        sender : Account
        receiver : Account
        minSharesOut : Optional Decimal
        extraArgs : ExtraArgs
      controller vaultRegistrar, delegate
      do
        requireVault this vaultCid
        requireOwned this sender
        result <- exercise vaultCid Vault_Deposit with assets; sender; receiver; minSharesOut; actors = [owner]; extraArgs
        left <- spend "deposit" depositAllowance result.assets
        next <- create this with depositAllowance = left
        pure (next, result)

    choice VaultDelegateAuth_Mint : (ContractId VaultDelegateAuth, VaultActionResult)
      -- ^ `Vault_Mint` from the owner's account.
      with
        vaultCid : ContractId Vault
        shares : Decimal
        sender : Account
        receiver : Account
        maxAssetsIn : Optional Decimal
        extraArgs : ExtraArgs
      controller vaultRegistrar, delegate
      do
        requireVault this vaultCid
        requireOwned this sender
        result <- exercise vaultCid Vault_Mint with shares; sender; receiver; maxAssetsIn; actors = [owner]; extraArgs
        left <- spend "deposit" depositAllowance result.assets
        next <- create this with depositAllowance = left
        pure (next, result)

    choice VaultDelegateAuth_Withdraw : (ContractId VaultDelegateAuth, VaultActionResult)
      -- ^ `Vault_Withdraw` of the owner's shares.
      with
        vaultCid : ContractId Vault
        assets : Decimal
        from : Account
        receiver : Account
        maxSharesIn : Optional Decimal
        extraArgs : ExtraArgs
      controller vaultRegistrar, delegate
      do
        requireVault this vaultCid
        requireOwned this from
        result <- exercise vaultCid Vault_Withdraw with assets; owner = from; receiver; maxSharesIn; actors = [owner]; extraArgs
        left <- spend "redeem" redeemAllowance result.shares
        next <- create this with redeemAllowance = left
        pure (next, result)

    choice VaultDelegateAuth_Redeem : (ContractId VaultDelegateAuth, VaultActionResult)
      -- ^ `Vault_Redeem` of the owner's shares.
      with
        vaultCid : ContractId Vault
        shares : Decimal
        from : Account
        receiver : Account
        minAssetsOut : Optional Decimal
        extraArgs : ExtraArgs
      controller vaultRegistrar, delegate
      do
        requireVault this vaultCid
        requireOwned this from
        result <- exercise vaultCid Vault_Redeem with shares; owner = from; receiver; minAssetsOut; actors = [owner]; extraArgs
        left <- spend "redeem" redeemAllowance result.shares
        next <- create this with redeemAllowance = left
        pure (next, result)

    choice VaultDelegateAuth_RequestDeposit : (ContractId VaultDelegateAuth, Vault_RequestDepositResult)
      -- ^ `Vault_RequestDeposit` from the owner's account.
      with
        vaultCid : ContractId VaultAsyncDeposit
        label : Text
        assets : Decimal
        sender : Account
        receiver : Account
        minSharesOut : Optional Decimal
        extraArgs : ExtraArgs
      controller vaultRegistrar, delegate
      do
        requireVault this (toInterfaceContractId vaultCid)
        requireOwned this sender
        left <- spend "deposit" depositAllowance assets
        result <- exercise vaultCid Vault_RequestDeposit with label; assets; sender; receiver; minSharesOut; actors = [owner]; extraArgs
        next <- create this with depositAllowance = left
        pure (next, result)

    choice VaultDelegateAuth_RequestRedeem : (ContractId VaultDelegateAuth, Vault_RequestRedeemResult)
      -- ^ `Vault_RequestRedeem` of the owner's shares.
      with
        vaultCid : ContractId VaultAsyncRedeem
        label : Text
        shares : Decimal
        from : Account
        receiver : Account
        minAssetsOut : Optional Decimal
        extraArgs : ExtraArgs
      controller vaultRegistrar, delegate
      do
        requireVault this (toInterfaceContractId vaultCid)
        requireOwned this from
        left <- spend "redeem" redeemAllowance shares
        result <- exercise vaultCid Vault_RequestRedeem with label; shares; owner = from; receiver; minAssetsOut; actors = [owner]; extraArgs
        next <- create this with redeemAllowance = left
        pure (next, result)

-- | Fails unless the authorization is live and names the vault.
requireVault : VaultDelegateAuth -> ContractId Vault -> Update ()
requireVault auth vaultCid = do
  live <- isLedgerTimeLT auth.expiresAt
  assertMsg "the authorization has expired" live
  v <- view <$> fetch vaultCid
  assertMsg "the authorization is for another vault" (v.vaultId == auth.vaultId && v.vaultRegistrar == auth.vaultRegistrar)

-- | Fails unless the owner owns the account paid in from.
requireOwned : VaultDelegateAuth -> Account -> Update ()
requireOwned auth account =
  assertMsg "the account is not the owner's" (account.owner == Some auth.owner)

-- | What is left of an allowance after spending `amount` of it.
spend : Text -> Optional Decimal -> Decimal -> Update (Optional Decimal)
spend what allowance amount = case allowance of
  None -> fail ("the delegate may not " <> what)
  Some left -> do
    assertMsg ("the " <> what <> " allowance is exceeded") (amount <= left)
    pure (Some (left - amount))

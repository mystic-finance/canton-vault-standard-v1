-- | A minimal token registry standing in for the vault's underlying.
-- Transfers settle immediately. Not a model for a real registry.
module Canton.Vault.Test.MockToken where

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.TransferInstructionV2 qualified as V2
import Splice.TokenStandard.Utils

import Canton.Vault.V1

template MockHolding
  with
    holding : V2.HoldingView
  where
    signatory holding.instrumentId.admin
    observer regularAccountParties holding.account

    ensure holding.amount > 0.0

    interface instance V2.Holding for MockHolding where
      view = holding

template MockRegistry
  with
    admin : Party
  where
    signatory admin

    interface instance V2.TransferFactory for MockRegistry where
      view = V2.TransferFactoryView with
        admin
        meta = emptyMetadata

      transferFactory_publicFetchImpl = publicFetchDefaultImpl this
      transferFactory_transferExtraObservers _arg = []

      transferFactory_transferImpl _self arg = do
        let transfer = arg.transfer
        require "transfer names its input holdings" (transfer.inputHoldingCids /= [])
        funded <- forA transfer.inputHoldingCids $ \cid -> do
          let mockCid : ContractId MockHolding = fromInterfaceContractId cid
          holding <- fetch mockCid
          require' ("input.instrumentId", holding.holding.instrumentId)
            isEqualR ("transfer.instrumentId", transfer.instrumentId)
          require' ("input.account", holding.holding.account)
            isEqualR ("transfer.sender", transfer.sender)
          archive mockCid
          pure holding.holding.amount
        let available = sum funded
        require' ("available", available) isGreaterOrEqualR ("transfer.amount", transfer.amount)
        receiverCid <- create MockHolding with
          holding = V2.HoldingView with
            account = transfer.receiver
            instrumentId = transfer.instrumentId
            amount = transfer.amount
            lock = None
            meta = emptyMetadata
        changeCids <- if available > transfer.amount
          then do
            changeCid <- create MockHolding with
              holding = V2.HoldingView with
                account = transfer.sender
                instrumentId = transfer.instrumentId
                amount = available - transfer.amount
                lock = None
                meta = emptyMetadata
            pure [toInterfaceContractId changeCid]
          else pure []
        pure V2.TransferInstructionResult with
          output = V2.TransferInstructionResult_Completed with
            receiverHoldingCids = [toInterfaceContractId receiverCid]
          senderChangeCids = changeCids
          meta = emptyMetadata

-- | Read methods only run on-ledger and only for a party that can fetch the
-- vault, so a script reaches them through a choice exercised by the registrar.
-- | A registry that never completes a transfer, answering with a pending
-- instruction the way a registry with a compliance step would.
template PendingRegistry
  with
    admin : Party
  where
    signatory admin

    interface instance V2.TransferFactory for PendingRegistry where
      view = V2.TransferFactoryView with
        admin
        meta = emptyMetadata

      transferFactory_publicFetchImpl = publicFetchDefaultImpl this
      transferFactory_transferExtraObservers _arg = []

      transferFactory_transferImpl _self arg = do
        instructionCid <- create PendingInstruction with
          admin
          transfer = arg.transfer
        pure V2.TransferInstructionResult with
          output = V2.TransferInstructionResult_Pending with
            transferInstructionCid = toInterfaceContractId instructionCid
          senderChangeCids = []
          meta = emptyMetadata

template PendingInstruction
  with
    admin : Party
    transfer : V2.Transfer
  where
    signatory admin

    interface instance V2.TransferInstruction for PendingInstruction where
      view = V2.TransferInstructionView with
        originalInstructionCid = None
        transfer
        expiresAt = None
        availableActions = mempty
        meta = emptyMetadata

      transferInstruction_acceptImpl _self _arg = abort "not needed"
      transferInstruction_rejectImpl _self _arg = abort "not needed"
      transferInstruction_withdrawImpl _self _arg = abort "not needed"
      transferInstruction_acceptExtraObservers _arg = []
      transferInstruction_rejectExtraObservers _arg = []
      transferInstruction_withdrawExtraObservers _arg = []

-- | A factory that reports success without moving anything. Anyone can write
-- one; the question is whether a vault will accept it.
template FreeMintRegistry
  with
    admin : Party
  where
    signatory admin

    interface instance V2.TransferFactory for FreeMintRegistry where
      view = V2.TransferFactoryView with
        admin
        meta = emptyMetadata

      transferFactory_publicFetchImpl = publicFetchDefaultImpl this
      transferFactory_transferExtraObservers _arg = []

      transferFactory_transferImpl _self _arg =
        pure V2.TransferInstructionResult with
          output = V2.TransferInstructionResult_Completed with receiverHoldingCids = []
          senderChangeCids = []
          meta = emptyMetadata

template MaxRedeemProbe
  with
    caller : Party
  where
    signatory caller

    choice Probe_MaxMint : Decimal
      with
        vaultCid : ContractId Vault
        party : Party
        extraArgs : ExtraArgs
      controller caller
      do
        vault <- fetch vaultCid
        maxMint vault party extraArgs

    choice Probe_ConvertToAssets : Decimal
      with
        vaultCid : ContractId Vault
        shares : Decimal
      controller caller
      do
        vault <- fetch vaultCid
        convertToAssets vault shares

    choice Probe_Run : Decimal
      with
        vaultCid : ContractId Vault
        party : Party
        extraArgs : ExtraArgs
      controller caller
      do
        vault <- fetch vaultCid
        maxRedeem vault party extraArgs

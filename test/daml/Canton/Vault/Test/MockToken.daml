-- | A minimal registry standing in for the vault's underlying; transfers settle at once.
module Canton.Vault.Test.MockToken where

import DA.TextMap qualified as TextMap

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.TransferInstructionV2 qualified as V2
import Splice.TokenStandard.Utils

import Canton.Vault.V1

template MockHolding
  with
    holding : V2.HoldingView
  where
    signatory holding.instrumentId.admin
    observer regularAccountParties holding.account

    ensure holding.amount > 0.0

    interface instance V2.Holding for MockHolding where
      view = holding

template MockRegistry
  with
    admin : Party
  where
    signatory admin

    interface instance V2.TransferFactory for MockRegistry where
      view = V2.TransferFactoryView with
        admin
        meta = emptyMetadata

      transferFactory_publicFetchImpl = publicFetchDefaultImpl this
      transferFactory_transferExtraObservers _arg = []

      transferFactory_transferImpl _self arg = settleTransfer arg.transfer

-- | Completes a transfer at once, whoever authorizes it.
settleTransfer : V2.Transfer -> Update V2.TransferInstructionResult
settleTransfer transfer = do
  require "transfer names its input holdings" (transfer.inputHoldingCids /= [])
  funded <- forA transfer.inputHoldingCids $ \cid -> do
    let mockCid : ContractId MockHolding = fromInterfaceContractId cid
    holding <- fetch mockCid
    require' ("input.instrumentId", holding.holding.instrumentId)
      isEqualR ("transfer.instrumentId", transfer.instrumentId)
    require' ("input.account", holding.holding.account)
      isEqualR ("transfer.sender", transfer.sender)
    archive mockCid
    pure holding.holding.amount
  let available = sum funded
  require' ("available", available) isGreaterOrEqualR ("transfer.amount", transfer.amount)
  receiverCid <- create MockHolding with
    holding = V2.HoldingView with
      account = transfer.receiver
      instrumentId = transfer.instrumentId
      amount = transfer.amount
      lock = None
      meta = emptyMetadata
  changeCids <- if available > transfer.amount
    then do
      changeCid <- create MockHolding with
        holding = V2.HoldingView with
          account = transfer.sender
          instrumentId = transfer.instrumentId
          amount = available - transfer.amount
          lock = None
          meta = emptyMetadata
      pure [toInterfaceContractId changeCid]
    else pure []
  pure V2.TransferInstructionResult with
    output = V2.TransferInstructionResult_Completed with
      receiverHoldingCids = [toInterfaceContractId receiverCid]
    senderChangeCids = changeCids
    meta = emptyMetadata

-- | A receiver's standing consent to be sent the registry's instrument.
template MockPreapproval
  with
    admin : Party
    receiver : Party
  where
    signatory receiver
    observer admin

preapprovalKey : Text
preapprovalKey = "test/preapproval"

-- | Completes a transfer only when the receiver acts or has a preapproval; otherwise pending.
template StrictRegistry
  with
    admin : Party
  where
    signatory admin

    interface instance V2.TransferFactory for StrictRegistry where
      view = V2.TransferFactoryView with
        admin
        meta = emptyMetadata

      transferFactory_publicFetchImpl = publicFetchDefaultImpl this
      transferFactory_transferExtraObservers _arg = []

      transferFactory_transferImpl _self arg = do
        let receiverParties = regularAccountParties arg.transfer.receiver
        preapproved <- case TextMap.lookup preapprovalKey arg.extraArgs.context.values of
          Some (AV_ContractId cid) -> do
            preapproval <- fetch (fromAnyContractId cid : ContractId MockPreapproval)
            pure (preapproval.admin == admin && preapproval.receiver `elem` receiverParties)
          _ -> pure False
        if preapproved || all (`elem` arg.actors) receiverParties
          then settleTransfer arg.transfer
          else do
            instructionCid <- create PendingInstruction with admin; transfer = arg.transfer
            pure V2.TransferInstructionResult with
              output = V2.TransferInstructionResult_Pending with
                transferInstructionCid = toInterfaceContractId instructionCid
              senderChangeCids = []
              meta = emptyMetadata

-- | A registry that always answers with a pending instruction.
template PendingRegistry
  with
    admin : Party
  where
    signatory admin

    interface instance V2.TransferFactory for PendingRegistry where
      view = V2.TransferFactoryView with
        admin
        meta = emptyMetadata

      transferFactory_publicFetchImpl = publicFetchDefaultImpl this
      transferFactory_transferExtraObservers _arg = []

      transferFactory_transferImpl _self arg = do
        instructionCid <- create PendingInstruction with
          admin
          transfer = arg.transfer
        pure V2.TransferInstructionResult with
          output = V2.TransferInstructionResult_Pending with
            transferInstructionCid = toInterfaceContractId instructionCid
          senderChangeCids = []
          meta = emptyMetadata

template PendingInstruction
  with
    admin : Party
    transfer : V2.Transfer
  where
    signatory admin

    interface instance V2.TransferInstruction for PendingInstruction where
      view = V2.TransferInstructionView with
        originalInstructionCid = None
        transfer
        expiresAt = None
        availableActions = mempty
        meta = emptyMetadata

      transferInstruction_acceptImpl _self _arg = abort "not needed"
      transferInstruction_rejectImpl _self _arg = abort "not needed"
      transferInstruction_withdrawImpl _self _arg = abort "not needed"
      transferInstruction_acceptExtraObservers _arg = []
      transferInstruction_rejectExtraObservers _arg = []
      transferInstruction_withdrawExtraObservers _arg = []

-- | A factory that reports success without moving anything.
template FreeMintRegistry
  with
    admin : Party
  where
    signatory admin

    interface instance V2.TransferFactory for FreeMintRegistry where
      view = V2.TransferFactoryView with
        admin
        meta = emptyMetadata

      transferFactory_publicFetchImpl = publicFetchDefaultImpl this
      transferFactory_transferExtraObservers _arg = []

      transferFactory_transferImpl _self _arg =
        pure V2.TransferInstructionResult with
          output = V2.TransferInstructionResult_Completed with receiverHoldingCids = []
          senderChangeCids = []
          meta = emptyMetadata

-- | A factory claiming another's admin: reports a completed transfer, moving nothing or draining through the real one.
template ForgedFactory
  with
    owner : Party
    claimedAdmin : Party
    drain : Optional (ContractId V2.TransferFactory, [ContractId V2.Holding], Decimal)
  where
    signatory owner

    interface instance V2.TransferFactory for ForgedFactory where
      view = V2.TransferFactoryView with
        admin = claimedAdmin
        meta = emptyMetadata

      transferFactory_publicFetchImpl = publicFetchDefaultImpl this
      transferFactory_transferExtraObservers _arg = []

      transferFactory_transferImpl _self arg = do
        case drain of
          Some (real, pool, amount) -> do
            _ <- exercise real V2.TransferFactory_Transfer with
              transfer = arg.transfer with receiver = basicAccount owner; amount; inputHoldingCids = pool
              actors = arg.actors
              extraArgs = arg.extraArgs
            pure ()
          None -> pure ()
        pure V2.TransferInstructionResult with
          output = V2.TransferInstructionResult_Completed with receiverHoldingCids = []
          senderChangeCids = []
          meta = emptyMetadata

-- | The arguments with a factory named the way callers once named one.
withFactory : ContractId V2.TransferFactory -> ExtraArgs -> ExtraArgs
withFactory factory args = args with
  context = args.context with
    values = TextMap.insert "cantonVaultV1/underlyingTransferFactory" (AV_ContractId (toAnyContractId factory)) args.context.values

-- | Reaches the read methods on-ledger, exercised by the registrar.
template MaxRedeemProbe
  with
    caller : Party
  where
    signatory caller

    choice Probe_MaxMint : Decimal
      with
        vaultCid : ContractId Vault
        party : Party
        extraArgs : ExtraArgs
      controller caller
      do
        vault <- fetch vaultCid
        maxMint vault party extraArgs

    choice Probe_ConvertToAssets : Decimal
      with
        vaultCid : ContractId Vault
        shares : Decimal
      controller caller
      do
        vault <- fetch vaultCid
        convertToAssets vault shares

    choice Probe_Run : Decimal
      with
        vaultCid : ContractId Vault
        party : Party
        extraArgs : ExtraArgs
      controller caller
      do
        vault <- fetch vaultCid
        maxRedeem vault party extraArgs

-- | Every read method's answer at one moment, for conformance tests.
data Quote = Quote with
    toShares : Decimal
    toAssets : Decimal
    depositPreview : Decimal
    mintPreview : Decimal
    withdrawPreview : Decimal
    redeemPreview : Decimal
    depositMax : Decimal
    mintMax : Decimal
    withdrawMax : Decimal
    redeemMax : Decimal
  deriving (Eq, Show, Serializable)

template QuoteProbe
  with
    caller : Party
  where
    signatory caller

    choice Probe_Quote : Quote
      with
        vaultCid : ContractId Vault
        party : Party
        assets : Decimal
        shares : Decimal
        extraArgs : ExtraArgs
      controller caller
      do
        vault <- fetch vaultCid
        toShares <- convertToShares vault assets
        toAssets <- convertToAssets vault shares
        depositPreview <- previewDeposit vault assets
        mintPreview <- previewMint vault shares
        withdrawPreview <- previewWithdraw vault assets
        redeemPreview <- previewRedeem vault shares
        depositMax <- maxDeposit vault party extraArgs
        mintMax <- maxMint vault party extraArgs
        withdrawMax <- maxWithdraw vault party extraArgs
        redeemMax <- maxRedeem vault party extraArgs
        pure Quote with ..

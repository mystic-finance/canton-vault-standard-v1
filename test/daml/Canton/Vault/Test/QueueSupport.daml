-- | What the queued-vault tests share: refusals checked by reason, and allocations no registry issued.
module Canton.Vault.Test.QueueSupport where

import DA.Map qualified as Map
import DA.Text qualified as T
import DA.TextMap qualified as TextMap
import Daml.Script

import Canton.Vault.V1 qualified as V
import Canton.Vault.Reference.V1 (PriceLimits(..))

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.AllocationV2 qualified as V2

-- | Passes only if the submission was refused, and for the given reason.
failsWith : Text -> Either SubmitError a -> Script ()
failsWith reason result = case result of
  Left e | reason `T.isInfixOf` show e -> pure ()
  Left e -> abort ("refused for another reason than '" <> reason <> "': " <> show e)
  Right _ -> abort ("accepted, though it should be refused: " <> reason)

-- | Reads one of a vault's max or preview methods, named by `method`.
template PathProbe
  with
    caller : Party
  where
    signatory caller
    choice Probe_Path : Decimal
      with
        vaultCid : ContractId V.Vault
        method : Text
        amount : Decimal
        party : Party
        extraArgs : ExtraArgs
      controller caller
      do
        vault <- fetch vaultCid
        let methods =
              [ ("maxDeposit", V.maxDeposit vault party extraArgs)
              , ("maxMint", V.maxMint vault party extraArgs)
              , ("maxWithdraw", V.maxWithdraw vault party extraArgs)
              , ("maxRedeem", V.maxRedeem vault party extraArgs)
              , ("previewDeposit", V.previewDeposit vault amount)
              , ("previewMint", V.previewMint vault amount)
              , ("previewWithdraw", V.previewWithdraw vault amount)
              , ("previewRedeem", V.previewRedeem vault amount) ]
        case lookup method methods of
          Some read -> read
          None -> abort ("no such method: " <> method)

-- | An allocation its owner wrote and signed alone, claiming whatever its view says.
template FakeAllocation
  with
    owner : Party
    claimed : V2.AllocationView
  where
    signatory owner
    observer claimed.settlement.executors

    interface instance V2.Allocation for FakeAllocation where
      view = claimed
      allocation_settleImpl _ _ = pure settledNothing
      allocation_cancelImpl _ _ = pure settledNothing
      allocation_withdrawImpl _ _ = pure settledNothing
      allocation_settleExtraObservers _ = []
      allocation_cancelExtraObservers _ = []
      allocation_withdrawExtraObservers _ = []

settledNothing : V2.AllocationResult
settledNothing = V2.AllocationResult with
  output = V2.AllocationResult_Settled with nextIterationAllocationCid = None
  authorizerHoldingCids = TextMap.empty
  meta = emptyMetadata

fakeAllocation : Party -> V2.SettlementInfo -> V2.AllocationSpecification -> Script (ContractId V2.Allocation)
fakeAllocation owner settlement allocation = do
  now <- getTime
  cid <- submit owner do
    createCmd FakeAllocation with
      owner
      claimed = V2.AllocationView with
        originalAllocationCid = None
        settlement
        allocation
        holdingCids = []
        createdAt = now
        numIterations = 0
        expiresAt = None
        availableActions = Map.empty
        meta = emptyMetadata
  pure (toInterfaceContractId cid)

-- | Limits wide enough that no test roll meets them, for tests about something else.
generousLimits : PriceLimits
generousLimits = PriceLimits with maxIncreaseBpsPerYear = 1000000000000000000; maxDecreaseBps = 10000

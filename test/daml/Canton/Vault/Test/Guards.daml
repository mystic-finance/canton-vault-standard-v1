-- | The guards on each path, and what they refuse.
module Canton.Vault.Test.Guards where

import DA.Assert ((===))
import DA.Foldable (forA_)
import DA.Time (addRelTime, days, hours, microseconds, seconds)
import Daml.Script

import Canton.Vault.V1
import Canton.Vault.Reference.V1
import Canton.Vault.Reference.Share
import Splice.Testing.Tokens.TestTokenV2.Holding (Token(..))
import Canton.Vault.Test.Deposit
import Canton.Vault.Test.Limits (failsWith)
import Canton.Vault.Test.MockToken
import Canton.Vault.Test.Periods

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.TokenStandard.Utils

-- Rolling the period
----------------------

-- | A pool holding named twice would double-count the pool.
rollRejectsDuplicatePoolHoldings : Script ()
rollRejectsDuplicatePoolHoldings = script do
  f <- setupVault
  _ <- deposit f f.vaultTemplateCid f.alice 100.0
  pool <- query @MockHolding f.custodian
  ds <- poolDisclosures f
  flows <- query @PeriodFlow f.registrar
  now <- getTime
  let dup = map (toInterfaceContractId . fst) pool
  closed2 <- closePeriod f f.vaultTemplateCid
  submitMustFail (actAs f.registrar <> discloseMany ds) do
    exerciseCmd closed2 ClosedPeriod_Open with
      flowCids = map fst flows
      evidence = PoolHoldings (dup <> dup)
      validUntil = addRelTime now (hours 2)

-- | A sibling vault's flows are readable under a shared registrar, so only the guard refuses them.
rollRejectsFlowsFromAnotherVault : Script ()
rollRejectsFlowsFromAnotherVault = script do
  f <- setupVault
  now <- getTime
  sibling <- submit (actAs [f.registrar, f.custodian]) do
    createCmd ReferenceVault with
      vaultId = "reference-2"
      vaultRegistrar = f.registrar
      custodian = basicAccount f.custodian
      underlyingInstrument = f.underlying
      shareInstrument = f.shares with id = "reference-2"
      totalShares = 0.0
      totalAssets = 0.0
      accrual = None
      depositFeeBps = 0
      redeemFeeBps = 0
      rateValidFrom = now
      rateValidUntil = addRelTime now (hours 1)
      depositCap = None
      paused = False
      underlyingTransferFactory = f.registryCid
      pricing = PoolPricing
      priceLimits = wideLimits

  _ <- deposit f f.vaultTemplateCid f.alice 100.0
  _ <- deposit f sibling f.alice 500.0

  flows <- query @PeriodFlow f.registrar
  pool <- query @MockHolding f.custodian
  ds <- poolDisclosures f
  closed3 <- closePeriod f f.vaultTemplateCid
  submitMustFail (actAs f.registrar <> discloseMany ds) do
    exerciseCmd closed3 ClosedPeriod_Open with
      flowCids = map fst flows
      evidence = PoolHoldings (map (toInterfaceContractId . fst) pool)
      validUntil = addRelTime now (hours 2)

-- | A flow a roll left out is still uncounted, so the next roll folds it in.
aFlowLeftOutOfARollCountsInTheNext : Script ()
aFlowLeftOutOfARollCountsInTheNext = script do
  f <- setupVault
  _ <- deposit f f.vaultTemplateCid f.alice 100.0
  counted <- rollPeriod f f.vaultTemplateCid
  _ <- deposit f counted f.alice 100.0
  stale <- query @PeriodFlow f.registrar
  pool <- query @MockHolding f.custodian
  ds <- poolDisclosures f
  passTime (seconds 1)
  now <- getTime
  closed4 <- closePeriod f counted
  rolled <- submit (actAs f.registrar <> discloseMany ds) do
    exerciseCmd closed4 ClosedPeriod_Open with
      flowCids = []
      evidence = PoolHoldings (map (toInterfaceContractId . fst) pool)
      validUntil = addRelTime now (hours 2)
  Some missed <- queryContractId f.registrar rolled
  missed.totalShares === 100.0

  closed5 <- closePeriod f rolled
  caught <- submit (actAs f.registrar <> discloseMany ds) do
    exerciseCmd closed5 ClosedPeriod_Open with
      flowCids = map fst stale
      evidence = PoolHoldings (map (toInterfaceContractId . fst) pool)
      validUntil = addRelTime now (hours 3)
  Some vault <- queryContractId f.registrar caught
  vault.totalShares === 200.0

-- | A period must end in the future, or the vault opens already closed.
rollRejectsAPeriodEndingInThePast : Script ()
rollRejectsAPeriodEndingInThePast = script do
  f <- setupVault
  pool <- query @MockHolding f.custodian
  ds <- poolDisclosures f
  now <- getTime
  closed6 <- closePeriod f f.vaultTemplateCid
  submitMustFail (actAs f.registrar <> discloseMany ds) do
    exerciseCmd closed6 ClosedPeriod_Open with
      flowCids = []
      evidence = PoolHoldings (map (toInterfaceContractId . fst) pool)
      validUntil = addRelTime now (seconds (-1))

-- Period expiry
-----------------

-- | The period is open up to, not at, its end; past it the vault refuses to transact at a stale rate.
actionsFailAfterThePeriodEnds : Script ()
actionsFailAfterThePeriodEnds = script do
  f <- setupVault
  Some vault <- queryContractId f.registrar f.vaultTemplateCid
  setTime (addRelTime vault.rateValidUntil (microseconds (-1)))
  _ <- deposit f f.vaultTemplateCid f.alice 100.0
  ds <- disclosuresFor f f.vaultTemplateCid
  funds <- fund f f.alice 100.0
  setTime vault.rateValidUntil
  failsWith "rate period is still open" =<< trySubmit (actAs f.alice <> discloseMany ds) do
    exerciseCmd (toInterfaceContractId f.vaultTemplateCid : ContractId Vault) Vault_Deposit with
      sender = basicAccount f.alice
      assets = 100.0
      receiver = basicAccount f.alice
      minSharesOut = None
      actors = [f.alice]
      extraArgs = depositArgs f [funds]

-- Amounts and caps
--------------------

-- | A deposit over the vault's cap is refused.
depositOverTheCapIsRejected : Script ()
depositOverTheCapIsRejected = script do
  f <- setupCappedVault 50.0
  ds <- disclosuresFor f f.vaultTemplateCid
  funds <- fund f f.alice 100.0
  submitMustFail (actAs f.alice <> discloseMany ds) do
    exerciseCmd (toInterfaceContractId f.vaultTemplateCid : ContractId Vault) Vault_Deposit with
      sender = basicAccount f.alice
      assets = 100.0
      receiver = basicAccount f.alice
      minSharesOut = None
      actors = [f.alice]
      extraArgs = depositArgs f [funds]

-- | Zero and negative amounts are refused on every path.
nonPositiveAmountsAreRejected : Script ()
nonPositiveAmountsAreRejected = script do
  f <- setupVault
  ds <- disclosuresFor f f.vaultTemplateCid
  funds <- fund f f.alice 100.0
  let vaultCid : ContractId Vault = toInterfaceContractId f.vaultTemplateCid

  submitMustFail (actAs f.alice <> discloseMany ds) do
    exerciseCmd vaultCid Vault_Mint with
      sender = basicAccount f.alice
      shares = 0.0
      receiver = basicAccount f.alice
      maxAssetsIn = None
      actors = [f.alice]
      extraArgs = depositArgs f [funds]

  submitMustFail (actAs f.alice <> discloseMany ds) do
    exerciseCmd vaultCid Vault_Withdraw with
      assets = 0.0
      owner = basicAccount f.alice
      receiver = basicAccount f.alice
      maxSharesIn = None
      actors = [f.alice]
      extraArgs = depositArgs f [funds]

  submitMustFail (actAs f.alice <> discloseMany ds) do
    exerciseCmd vaultCid Vault_Redeem with
      shares = 0.0
      owner = basicAccount f.alice
      receiver = basicAccount f.alice
      minAssetsOut = None
      actors = [f.alice]
      extraArgs = depositArgs f [funds]

-- | A deposit too small to mint a unit of share is refused.
depositMintingZeroSharesIsRejected : Script ()
depositMintingZeroSharesIsRejected = script do
  -- A pool worth far more per share than the deposit on offer.
  f <- setupVault
  _ <- deposit f f.vaultTemplateCid f.alice 100.0
  _ <- fund f f.custodian 1000000000.0
  passTime (days 1)
  rolled <- rollPeriod f f.vaultTemplateCid
  ds <- disclosuresFor f rolled
  funds <- fund f f.alice 0.0000000001
  submitMustFail (actAs f.alice <> discloseMany ds) do
    exerciseCmd (toInterfaceContractId rolled : ContractId Vault) Vault_Deposit with
      sender = basicAccount f.alice
      assets = 0.0000000001
      receiver = basicAccount f.alice
      minSharesOut = None
      actors = [f.alice]
      extraArgs = depositArgs f [funds]

-- Withdrawal authorization
---------------------------

-- | Withdraw carries the same owner check as redeem.
withdrawRequiresTheOwner : Script ()
withdrawRequiresTheOwner = script do
  f <- setupVault
  mallory <- allocateParty "mallory"
  first <- deposit f f.vaultTemplateCid f.alice 100.0
  rolled <- rollPeriod f f.vaultTemplateCid
  ds <- disclosuresFor f rolled
  pool <- query @MockHolding f.custodian
  poolDs <- poolDisclosures f
  aliceShares <- query @ShareHolding f.alice
  shareDs <- forA aliceShares $ \(cid, _) -> do
    d <- queryDisclosure f.registrar cid
    case d of
      Some d' -> pure d'
      None -> abort "share disclosure not available"

  submitMustFail (actAs mallory <> discloseMany (ds <> poolDs <> shareDs)) do
    exerciseCmd (toInterfaceContractId rolled : ContractId Vault) Vault_Withdraw with
      assets = 50.0
      owner = basicAccount f.alice
      receiver = basicAccount mallory
      maxSharesIn = None
      actors = [mallory]
      extraArgs = redeemArgs f
        (map (toInterfaceContractId . fst) pool)
        (map fst aliceShares)

-- Burning shares
------------------

-- | Redeeming more than the named holdings cover is refused.
redeemBeyondTheNamedHoldingsIsRejected : Script ()
redeemBeyondTheNamedHoldingsIsRejected = script do
  f <- setupVault
  first <- deposit f f.vaultTemplateCid f.alice 100.0
  rolled <- rollPeriod f f.vaultTemplateCid
  ds <- disclosuresFor f rolled
  pool <- query @MockHolding f.custodian
  poolDs <- poolDisclosures f
  aliceShares <- query @ShareHolding f.alice

  submitMustFail (actAs f.alice <> discloseMany (ds <> poolDs)) do
    exerciseCmd (toInterfaceContractId rolled : ContractId Vault) Vault_Redeem with
      shares = first.shares
      owner = basicAccount f.alice
      receiver = basicAccount f.alice
      minAssetsOut = None
      actors = [f.alice]
      -- Names no share holdings at all.
      extraArgs = redeemArgs f (map (toInterfaceContractId . fst) pool) []

-- | A locked share holding cannot be burned.
lockedSharesCannotBeRedeemed : Script ()
lockedSharesCannotBeRedeemed = script do
  f <- setupVault
  first <- deposit f f.vaultTemplateCid f.alice 100.0
  rolled <- rollPeriod f f.vaultTemplateCid
  ds <- disclosuresFor f rolled
  pool <- query @MockHolding f.custodian
  poolDs <- poolDisclosures f

  -- Re-issue Alice's shares locked.
  aliceShares <- query @ShareHolding f.alice
  forA_ aliceShares $ \(cid, _) -> submit (actAs [f.alice, f.registrar]) (archiveCmd cid)
  lockedCid <- submit (actAs [f.alice, f.registrar]) do
    createCmd Token with
      holding = V2.HoldingView with
        account = basicAccount f.alice
        instrumentId = f.shares
        amount = first.shares
        lock = Some V2.Lock with
          holders = [f.registrar]
          expiresAt = None
          expiresAfter = None
          context = None
        meta = emptyMetadata

  submitMustFail (actAs f.alice <> discloseMany (ds <> poolDs)) do
    exerciseCmd (toInterfaceContractId rolled : ContractId Vault) Vault_Redeem with
      shares = first.shares
      owner = basicAccount f.alice
      receiver = basicAccount f.alice
      minAssetsOut = None
      actors = [f.alice]
      extraArgs = redeemArgs f (map (toInterfaceContractId . fst) pool) [lockedCid]

-- | Minting over the cap is refused, as depositing over it is.
mintOverTheCapIsRejected : Script ()
mintOverTheCapIsRejected = script do
  f <- setupCappedVault 50.0
  ds <- disclosuresFor f f.vaultTemplateCid
  funds <- fund f f.alice 100.0
  submitMustFail (actAs f.alice <> discloseMany ds) do
    exerciseCmd (toInterfaceContractId f.vaultTemplateCid : ContractId Vault) Vault_Mint with
      sender = basicAccount f.alice
      shares = 100.0
      receiver = basicAccount f.alice
      maxAssetsIn = None
      actors = [f.alice]
      extraArgs = depositArgs f [funds]

-- | A locked pool holding cannot be counted at a roll.
rollRejectsLockedPoolHoldings : Script ()
rollRejectsLockedPoolHoldings = script do
  f <- setupVault
  _ <- deposit f f.vaultTemplateCid f.alice 100.0

  -- Re-issue the pool locked.
  pool <- query @MockHolding f.custodian
  forA_ pool $ \(cid, _) -> submit (actAs [f.underlyingAdmin, f.custodian]) (archiveCmd cid)
  lockedCid <- submit f.underlyingAdmin do
    createCmd MockHolding with
      holding = V2.HoldingView with
        account = basicAccount f.custodian
        instrumentId = f.underlying
        amount = 100.0
        lock = Some V2.Lock with
          holders = [f.underlyingAdmin]
          expiresAt = None
          expiresAfter = None
          context = None
        meta = emptyMetadata

  lockedDs <- queryDisclosure f.custodian lockedCid
  flows <- query @PeriodFlow f.registrar
  now <- getTime
  closed7 <- closePeriod f f.vaultTemplateCid
  case lockedDs of
    None -> abort "disclosure not available"
    Some d -> submitMustFail (actAs f.registrar <> discloseMany [d]) do
      exerciseCmd closed7 ClosedPeriod_Open with
        flowCids = map fst flows
        evidence = PoolHoldings ([toInterfaceContractId lockedCid])
        validUntil = addRelTime now (hours 2)

-- | Shares of another instrument cannot be burned to fund a redemption.
burningTheWrongInstrumentIsRejected : Script ()
burningTheWrongInstrumentIsRejected = script do
  f <- setupVault
  first <- deposit f f.vaultTemplateCid f.alice 100.0
  rolled <- rollPeriod f f.vaultTemplateCid
  ds <- disclosuresFor f rolled
  poolDs <- poolDisclosures f
  pool <- query @MockHolding f.custodian

  -- Shares of a different instrument, in Alice's own account.
  let other = V2.InstrumentId with admin = f.registrar; id = "vEUR"
  otherCid <- submit (actAs [f.alice, f.registrar]) do
    createCmd Token with
      holding = V2.HoldingView with
        account = basicAccount f.alice
        instrumentId = other
        amount = first.shares
        lock = None
        meta = emptyMetadata

  submitMustFail (actAs f.alice <> discloseMany (ds <> poolDs)) do
    exerciseCmd (toInterfaceContractId rolled : ContractId Vault) Vault_Redeem with
      shares = first.shares
      owner = basicAccount f.alice
      receiver = basicAccount f.alice
      minAssetsOut = None
      actors = [f.alice]
      extraArgs = redeemArgs f (map (toInterfaceContractId . fst) pool) [otherCid]

-- | After a loss, a redemption too small to return anything is refused.
redemptionReturningNothingIsRejected : Script ()
redemptionReturningNothingIsRejected = script do
  f <- setupVault
  _ <- deposit f f.vaultTemplateCid f.alice 1000.0

  -- The pool loses almost everything, so the next roll prices it far below par.
  pool <- query @MockHolding f.custodian
  forA_ pool $ \(cid, _) -> submit (actAs [f.underlyingAdmin, f.custodian]) (archiveCmd cid)
  _ <- submit f.underlyingAdmin do
    createCmd MockHolding with
      holding = V2.HoldingView with
        account = basicAccount f.custodian
        instrumentId = f.underlying
        amount = 0.0000000001
        lock = None
        meta = emptyMetadata

  rolled <- rollPeriod f f.vaultTemplateCid
  ds <- disclosuresFor f rolled
  poolDs <- poolDisclosures f
  shrunk <- query @MockHolding f.custodian
  aliceShares <- query @ShareHolding f.alice

  submitMustFail (actAs f.alice <> discloseMany (ds <> poolDs)) do
    exerciseCmd (toInterfaceContractId rolled : ContractId Vault) Vault_Redeem with
      shares = 0.0000000001
      owner = basicAccount f.alice
      receiver = basicAccount f.alice
      minAssetsOut = None
      actors = [f.alice]
      extraArgs = redeemArgs f
        (map (toInterfaceContractId . fst) shrunk)
        (map fst aliceShares)

-- What a party may redeem
---------------------------
-- These checks sit in `heldShares`, which only the read methods reach.

-- | The same holding named twice would double what the party appears to hold.
maxRedeemRejectsDuplicateShareHoldings : Script ()
maxRedeemRejectsDuplicateShareHoldings = script do
  f <- setupVault
  _ <- deposit f f.vaultTemplateCid f.alice 100.0
  aliceShares <- map fst <$> query @ShareHolding f.alice
  submitMustFail (actAs f.registrar) do
    createAndExerciseCmd (MaxRedeemProbe with caller = f.registrar) (Probe_Run with
      vaultCid = f.vaultCid
      party = f.alice
      extraArgs = redeemArgs f [] (aliceShares <> aliceShares))

-- | Another party's holdings are not the caller's to redeem.
maxRedeemRejectsAnotherPartysHoldings : Script ()
maxRedeemRejectsAnotherPartysHoldings = script do
  f <- setupVault
  bob <- allocateParty "bob"
  _ <- deposit f f.vaultTemplateCid f.alice 100.0
  aliceShares <- map fst <$> query @ShareHolding f.alice
  submitMustFail (actAs f.registrar) do
    createAndExerciseCmd (MaxRedeemProbe with caller = f.registrar) (Probe_Run with
      vaultCid = f.vaultCid
      party = bob
      extraArgs = redeemArgs f [] aliceShares)

-- | Holdings of another instrument do not count towards the share total.
maxRedeemRejectsTheWrongInstrument : Script ()
maxRedeemRejectsTheWrongInstrument = script do
  f <- setupVault
  _ <- deposit f f.vaultTemplateCid f.alice 100.0
  let other = V2.InstrumentId with admin = f.registrar; id = "vEUR"
  otherCid <- submit (actAs [f.alice, f.registrar]) do
    createCmd Token with
      holding = V2.HoldingView with
        account = basicAccount f.alice
        instrumentId = other
        amount = 100.0
        lock = None
        meta = emptyMetadata
  submitMustFail (actAs f.registrar) do
    createAndExerciseCmd (MaxRedeemProbe with caller = f.registrar) (Probe_Run with
      vaultCid = f.vaultCid
      party = f.alice
      extraArgs = redeemArgs f [] [otherCid])

-- | Locked shares are not available to redeem.
maxRedeemRejectsALockedShareHolding : Script ()
maxRedeemRejectsALockedShareHolding = script do
  f <- setupVault
  _ <- deposit f f.vaultTemplateCid f.alice 100.0
  aliceShares <- query @ShareHolding f.alice
  forA_ aliceShares $ \(cid, _) -> submit (actAs [f.alice, f.registrar]) (archiveCmd cid)
  lockedCid <- submit (actAs [f.alice, f.registrar]) do
    createCmd Token with
      holding = V2.HoldingView with
        account = basicAccount f.alice
        instrumentId = f.shares
        amount = 100.0
        lock = Some V2.Lock with
          holders = [f.registrar]
          expiresAt = None
          expiresAfter = None
          context = None
        meta = emptyMetadata
  submitMustFail (actAs f.registrar) do
    createAndExerciseCmd (MaxRedeemProbe with caller = f.registrar) (Probe_Run with
      vaultCid = f.vaultCid
      party = f.alice
      extraArgs = redeemArgs f [] [lockedCid])

-- | Counting a redemption without its funding deposit would make the share count negative.
rollRejectsNegativeShares : Script ()
rollRejectsNegativeShares = script do
  f <- setupVault
  first <- deposit f f.vaultTemplateCid f.alice 100.0

  -- Redeem inside the same period, so both flows are still open at the roll.
  ds <- disclosuresFor f f.vaultTemplateCid
  poolDs <- poolDisclosures f
  pool <- query @MockHolding f.custodian
  aliceShares <- map fst <$> query @ShareHolding f.alice
  _ <- submit (actAs f.alice <> discloseMany (ds <> poolDs)) do
    exerciseCmd (toInterfaceContractId f.vaultTemplateCid : ContractId Vault) Vault_Redeem with
      shares = first.shares
      owner = basicAccount f.alice
      receiver = basicAccount f.alice
      minAssetsOut = None
      actors = [f.alice]
      extraArgs = redeemArgs f (map (toInterfaceContractId . fst) pool) aliceShares

  flows <- query @PeriodFlow f.registrar
  let redemptions = [cid | (cid, flow) <- flows, flow.sharesDelta < 0.0]
  emptied <- query @MockHolding f.custodian
  ds' <- poolDisclosures f
  now <- getTime
  closed8 <- closePeriod f f.vaultTemplateCid
  submitMustFail (actAs f.registrar <> discloseMany ds') do
    exerciseCmd closed8 ClosedPeriod_Open with
      flowCids = redemptions
      evidence = PoolHoldings (map (toInterfaceContractId . fst) emptied)
      validUntil = addRelTime now (hours 2)

-- | The period-open check sits on each of the four actions, not just deposit.
mintWithdrawAndRedeemFailAfterThePeriodEnds : Script ()
mintWithdrawAndRedeemFailAfterThePeriodEnds = script do
  f <- setupVault
  _ <- deposit f f.vaultTemplateCid f.alice 100.0
  rolled <- rollPeriod f f.vaultTemplateCid
  ds <- disclosuresFor f rolled
  poolDs <- poolDisclosures f
  pool <- query @MockHolding f.custodian
  aliceShares <- map fst <$> query @ShareHolding f.alice
  funds <- fund f f.alice 100.0
  let vaultCid : ContractId Vault = toInterfaceContractId rolled
      poolCids = map (toInterfaceContractId . fst) pool
  passTime (hours 2)

  submitMustFail (actAs f.alice <> discloseMany (ds <> poolDs)) do
    exerciseCmd vaultCid Vault_Mint with
      sender = basicAccount f.alice
      shares = 10.0
      receiver = basicAccount f.alice
      maxAssetsIn = None
      actors = [f.alice]
      extraArgs = depositArgs f [funds]

  submitMustFail (actAs f.alice <> discloseMany (ds <> poolDs)) do
    exerciseCmd vaultCid Vault_Withdraw with
      assets = 10.0
      owner = basicAccount f.alice
      receiver = basicAccount f.alice
      maxSharesIn = None
      actors = [f.alice]
      extraArgs = redeemArgs f poolCids aliceShares

  submitMustFail (actAs f.alice <> discloseMany (ds <> poolDs)) do
    exerciseCmd vaultCid Vault_Redeem with
      shares = 10.0
      owner = basicAccount f.alice
      receiver = basicAccount f.alice
      minAssetsOut = None
      actors = [f.alice]
      extraArgs = redeemArgs f poolCids aliceShares

-- | A second account of the custodian's is not the pool; only the guard can refuse it.
rollRejectsPoolHoldingsOutsideTheCustodianAccount : Script ()
rollRejectsPoolHoldingsOutsideTheCustodianAccount = script do
  f <- setupVault
  _ <- deposit f f.vaultTemplateCid f.alice 100.0
  -- Measured first, since the custodian observes both accounts.
  pool <- query @MockHolding f.custodian
  ds <- poolDisclosures f

  let other = V2.Account with owner = Some f.custodian; provider = None; id = "sub"
  outside <- fundAccount f other f.underlying 500.0
  outsideDs <- queryDisclosure f.custodian (fromInterfaceContractId outside : ContractId MockHolding)
  flows <- query @PeriodFlow f.registrar
  now <- getTime
  outsideD <- case outsideDs of
    Some d -> pure d
    None -> abort "holding disclosure not available"
  closed9 <- closePeriod f f.vaultTemplateCid
  submitMustFail (actAs f.registrar <> discloseMany (ds <> [outsideD])) do
    exerciseCmd closed9 ClosedPeriod_Open with
      flowCids = map fst flows
      evidence = PoolHoldings (map (toInterfaceContractId . fst) pool <> [outside])
      validUntil = addRelTime now (hours 2)

-- | A holding its registry never issued, claiming the custodian's account, is not the pool.
rollRejectsAHoldingItsRegistryDidNotSign : Script ()
rollRejectsAHoldingItsRegistryDidNotSign = script do
  f <- setupVault
  _ <- deposit f f.vaultTemplateCid f.alice 100.0
  pool <- query @MockHolding f.custodian
  ds <- poolDisclosures f
  mallory <- allocateParty "mallory"
  (_, sample) :: _ <- pure pool
  forged <- submit mallory $ createCmd ForgedHolding with
    forger = mallory; holding = (sample.holding with amount = 1000000.0); observers = [f.registrar, f.custodian]
  flows <- query @PeriodFlow f.registrar
  now <- getTime
  closed <- closePeriod f f.vaultTemplateCid
  failsWith "pool holding is signed by its registry" =<< trySubmit (actAs f.registrar <> discloseMany ds) do
    exerciseCmd closed ClosedPeriod_Open with
      flowCids = map fst flows
      evidence = PoolHoldings (map (toInterfaceContractId . fst) pool <> [toInterfaceContractId forged])
      validUntil = addRelTime now (hours 2)

-- | A holding anyone can create, claiming whatever account and amount it likes.
template ForgedHolding
  with
    forger : Party
    holding : V2.HoldingView
    observers : [Party]
  where
    signatory forger
    observer observers

    interface instance V2.Holding for ForgedHolding where
      view = holding

-- | The owner's other account is not the one being redeemed; only the guard refuses it.
burningFromAnotherAccountIsRejected : Script ()
burningFromAnotherAccountIsRejected = script do
  f <- setupVault
  first <- deposit f f.vaultTemplateCid f.alice 100.0
  let other = V2.Account with owner = Some f.alice; provider = None; id = "sub"
  otherCid <- submit (actAs [f.alice, f.registrar]) do
    createCmd Token with
      holding = V2.HoldingView with
        account = other
        instrumentId = f.shares
        amount = first.shares
        lock = None
        meta = emptyMetadata

  rolled <- rollPeriod f f.vaultTemplateCid
  ds <- disclosuresFor f rolled
  poolDs <- poolDisclosures f
  pool <- query @MockHolding f.custodian

  submitMustFail (actAs f.alice <> discloseMany (ds <> poolDs)) do
    exerciseCmd (toInterfaceContractId rolled : ContractId Vault) Vault_Redeem with
      shares = 10.0
      owner = basicAccount f.alice
      receiver = basicAccount f.alice
      minAssetsOut = None
      actors = [f.alice]
      extraArgs = redeemArgs f (map (toInterfaceContractId . fst) pool) [otherCid]

-- | A payout takes only the holdings it needs, so a dust redemption leaves the rest of the pool alone.
payoutTakesOnlyTheHoldingsItNeeds : Script ()
payoutTakesOnlyTheHoldingsItNeeds = script do
  f <- setupVault
  bob <- allocateParty "bob"
  _ <- deposit f f.vaultTemplateCid f.alice 100.0
  _ <- deposit f f.vaultTemplateCid bob 100.0
  pool <- query @MockHolding f.custodian
  spare <- case pool of
    [_, (cid, _)] -> pure cid
    _ -> abort "expected two pool holdings"
  ds <- disclosuresFor f f.vaultTemplateCid
  poolDs <- poolDisclosures f
  bobShares <- map fst <$> query @ShareHolding bob
  _ <- submit (actAs bob <> discloseMany (ds <> poolDs)) do
    exerciseCmd (toInterfaceContractId f.vaultTemplateCid : ContractId Vault) Vault_Redeem with
      shares = 1.0
      owner = basicAccount bob
      receiver = basicAccount bob
      minAssetsOut = None
      actors = [bob]
      extraArgs = redeemArgs f (map (toInterfaceContractId . fst) pool) bobShares
  Some _ <- queryContractId f.custodian spare
  pure ()

-- | A factory the caller names is ignored, so one that reports a transfer it never made mints nothing.
callerNamedFactoryCannotFakeADeposit : Script ()
callerNamedFactoryCannotFakeADeposit = script do
  f <- setupVault
  mallory <- allocateParty "mallory"
  ds <- vaultDisclosure f
  forged <- submit mallory do
    createCmd ForgedFactory with owner = mallory; claimedAdmin = f.underlyingAdmin; drain = None
  submitMustFail (actAs mallory <> discloseMany ds) do
    exerciseCmd f.vaultCid Vault_Deposit with
      sender = basicAccount mallory
      assets = 1000.0
      receiver = basicAccount mallory
      minSharesOut = None
      actors = [mallory]
      extraArgs = withFactory (toInterfaceContractId forged) (depositArgs f [])

-- | A factory the caller names is ignored, so a dust redemption cannot lend it the custodian's authority.
callerNamedFactoryCannotDrainThePool : Script ()
callerNamedFactoryCannotDrainThePool = script do
  f <- setupVault
  mallory <- allocateParty "mallory"
  _ <- deposit f f.vaultTemplateCid f.alice 10000.0
  _ <- deposit f f.vaultTemplateCid mallory 1.0
  pool <- query @MockHolding f.custodian
  poolDs <- poolDisclosures f
  let poolCids = map (toInterfaceContractId . fst) pool
  forged <- submit mallory do
    createCmd ForgedFactory with
      owner = mallory
      claimedAdmin = f.underlyingAdmin
      drain = Some (f.registryCid, poolCids, 10001.0)
  ds <- disclosuresFor f f.vaultTemplateCid
  malloryShares <- map fst <$> query @ShareHolding mallory
  _ <- submit (actAs mallory <> discloseMany (ds <> poolDs)) do
    exerciseCmd f.vaultCid Vault_Redeem with
      shares = 0.5
      owner = basicAccount mallory
      receiver = basicAccount mallory
      minAssetsOut = None
      actors = [mallory]
      extraArgs = withFactory (toInterfaceContractId forged) (redeemArgs f poolCids malloryShares)
  left <- map ((.holding.amount) . snd) <$> query @MockHolding f.custodian
  sum left === 10000.5


-- Merging flows
-----------------

-- | Merged flows roll to the same totals as the flows they replace.
mergedFlowsRollTheSame : Script ()
mergedFlowsRollTheSame = script do
  f <- setupVault
  forA_ [100.0, 50.0, 25.0] $ \amount -> deposit f f.vaultTemplateCid f.alice amount
  first :: rest <- map fst <$> query @PeriodFlow f.registrar
  _ <- submit f.registrar (exerciseCmd first PeriodFlow_Merge with flowCids = rest)
  merged <- map snd <$> query @PeriodFlow f.registrar
  map (\flow -> (flow.assetsDelta, flow.sharesDelta)) merged === [(175.0, 175.0)]
  rolled <- rollPeriod f f.vaultTemplateCid
  Some vault <- queryContractId f.registrar rolled
  (vault.totalShares, vault.totalAssets) === (175.0, 175.0)

-- | A sibling vault's flow, readable under a shared registrar, is not merged into this vault's.
mergeRefusesAnotherVaultsFlow : Script ()
mergeRefusesAnotherVaultsFlow = script do
  f <- setupVault
  now <- getTime
  sibling <- submit (actAs [f.registrar, f.custodian]) do
    createCmd ReferenceVault with
      vaultId = "reference-2"
      vaultRegistrar = f.registrar
      custodian = basicAccount f.custodian
      underlyingInstrument = f.underlying
      shareInstrument = f.shares with id = "reference-2"
      totalShares = 0.0
      totalAssets = 0.0
      accrual = None
      depositFeeBps = 0
      redeemFeeBps = 0
      rateValidFrom = now
      rateValidUntil = addRelTime now (hours 1)
      depositCap = None
      paused = False
      underlyingTransferFactory = f.registryCid
      pricing = PoolPricing
      priceLimits = wideLimits
  _ <- deposit f f.vaultTemplateCid f.alice 100.0
  _ <- deposit f sibling f.alice 500.0
  flows <- query @PeriodFlow f.registrar
  [ours] <- pure [cid | (cid, flow) <- flows, flow.vaultId == "reference-1"]
  let theirs = [cid | (cid, flow) <- flows, flow.vaultId == "reference-2"]
  submitMustFail f.registrar do
    exerciseCmd ours PeriodFlow_Merge with flowCids = theirs

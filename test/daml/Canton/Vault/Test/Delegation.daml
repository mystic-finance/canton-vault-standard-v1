-- | A delegate acts for an owner within its authorization: one vault, its allowances and its expiry.
module Canton.Vault.Test.Delegation where

import DA.Assert ((===))
import DA.Optional (fromSome)
import DA.Time (RelTime, addRelTime, days, minutes)
import Daml.Script

import Canton.Vault.V1
import Canton.Vault.Delegation.V1
import Canton.Vault.Reference.Share
import Canton.Vault.Test.Deposit
import Canton.Vault.Test.Limits (failsWith)
import Canton.Vault.Test.MockToken
import Canton.Vault.Test.Periods
import Canton.Vault.Test.QueuedDeposit qualified as Q
import Canton.Vault.Test.QueuedRedeem qualified as R

import Splice.Api.Token.MetadataV1
import Splice.TokenStandard.Utils (basicAccount)

-- | The owner's authorization for the delegate in the vault, until `ttl` from now.
authorize : Party -> Party -> Party -> Text -> Optional Decimal -> Optional Decimal -> RelTime -> Script (ContractId VaultDelegateAuth)
authorize owner delegate vaultRegistrar vaultId depositAllowance redeemAllowance ttl = do
  now <- getTime
  submit owner $ createCmd VaultDelegateAuth with
    owner; delegate; vaultRegistrar; vaultId; depositAllowance; redeemAllowance
    expiresAt = addRelTime now ttl
    meta = emptyMetadata

depositAs : Fixture -> Party -> ContractId VaultDelegateAuth -> Decimal -> Script (Either SubmitError (ContractId VaultDelegateAuth, VaultActionResult))
depositAs f delegate auth amount = do
  funds <- fund f f.alice amount
  fundsD <- fromSome <$> queryDisclosure f.alice (fromInterfaceContractId @MockHolding funds)
  ds <- vaultDisclosure f
  trySubmit (actAs delegate <> discloseMany (fundsD :: ds)) do
    exerciseCmd auth VaultDelegateAuth_Deposit with
      sender = basicAccount f.alice
      vaultCid = f.vaultCid; assets = amount; receiver = basicAccount f.alice; minSharesOut = None
      extraArgs = depositArgs f [funds]

redeemAs : Fixture -> Party -> ContractId VaultDelegateAuth -> Decimal -> Party -> Script (Either SubmitError (ContractId VaultDelegateAuth, VaultActionResult))
redeemAs f delegate auth shares receiver = do
  pool <- query @MockHolding f.custodian
  poolDs <- poolDisclosures f
  owned <- map fst <$> query @ShareHolding f.alice
  ownedDs <- forA owned $ \cid -> fromSome <$> queryDisclosure f.alice cid
  ds <- vaultDisclosure f
  trySubmit (actAs delegate <> discloseMany (ds <> poolDs <> ownedDs)) do
    exerciseCmd auth VaultDelegateAuth_Redeem with
      from = basicAccount f.alice
      vaultCid = f.vaultCid; shares; receiver = basicAccount receiver; minAssetsOut = None
      extraArgs = redeemArgs f (map (toInterfaceContractId . fst) pool) owned

allowances : Party -> ContractId VaultDelegateAuth -> Script (Optional Decimal, Optional Decimal)
allowances owner auth = do
  Some a <- queryContractId owner auth
  pure (a.depositAllowance, a.redeemAllowance)

unitsOf : Party -> Script Decimal
unitsOf party = do
  held <- query @MockHolding party
  pure (sum [h.holding.amount | (_, h) <- held, h.holding.account.owner == Some party])

-- Tests
---------

-- | Bob deposits and redeems for Alice, paying himself, until each allowance runs out across calls.
aDelegateActsForTheOwnerWithinItsAllowances : Script ()
aDelegateActsForTheOwnerWithinItsAllowances = script do
  f <- setupVault
  bob <- allocateParty "bob"
  auth <- authorize f.alice bob f.registrar "reference-1" (Some 100.0) (Some 50.0) (days 1)
  Right (auth, deposited) <- depositAs f bob auth 60.0
  deposited.shares === 60.0
  failsWith "the deposit allowance is exceeded" =<< depositAs f bob auth 50.0
  Right (auth, redeemed) <- redeemAs f bob auth 30.0 bob
  redeemed.assets === 30.0
  unitsOf bob >>= (=== 30.0)
  failsWith "the redeem allowance is exceeded" =<< redeemAs f bob auth 30.0 bob
  allowances f.alice auth >>= (=== (Some 40.0, Some 20.0))

-- | Minting spends the underlying it pays in, and withdrawing the shares it burns.
mintAndWithdrawSpendWhatTheyMove : Script ()
mintAndWithdrawSpendWhatTheyMove = script do
  f <- setupVault
  bob <- allocateParty "bob"
  auth <- authorize f.alice bob f.registrar "reference-1" (Some 100.0) (Some 50.0) (days 1)
  funds <- fund f f.alice 20.0
  fundsD <- fromSome <$> queryDisclosure f.alice (fromInterfaceContractId @MockHolding funds)
  ds <- vaultDisclosure f
  (auth, minted) <- submit (actAs bob <> discloseMany (fundsD :: ds)) do
    exerciseCmd auth VaultDelegateAuth_Mint with
      sender = basicAccount f.alice
      vaultCid = f.vaultCid; shares = 20.0; receiver = basicAccount f.alice; maxAssetsIn = None
      extraArgs = depositArgs f [funds]
  minted.assets === 20.0
  pool <- query @MockHolding f.custodian
  poolDs <- poolDisclosures f
  owned <- map fst <$> query @ShareHolding f.alice
  ownedDs <- forA owned $ \cid -> fromSome <$> queryDisclosure f.alice cid
  (auth, withdrew) <- submit (actAs bob <> discloseMany (ds <> poolDs <> ownedDs)) do
    exerciseCmd auth VaultDelegateAuth_Withdraw with
      from = basicAccount f.alice
      vaultCid = f.vaultCid; assets = 5.0; receiver = basicAccount bob; maxSharesIn = None
      extraArgs = redeemArgs f (map (toInterfaceContractId . fst) pool) owned
  withdrew.shares === 5.0
  allowances f.alice auth >>= (=== (Some 80.0, Some 45.0))

-- | A delegate given no redeem allowance cannot redeem.
aDelegateWithoutARedeemAllowanceCannotRedeem : Script ()
aDelegateWithoutARedeemAllowanceCannotRedeem = script do
  f <- setupVault
  bob <- allocateParty "bob"
  auth <- authorize f.alice bob f.registrar "reference-1" (Some 100.0) None (days 1)
  Right (auth, _) <- depositAs f bob auth 60.0
  failsWith "the delegate may not redeem" =<< redeemAs f bob auth 10.0 bob

-- | An authorization stops working at its expiry.
anExpiredAuthorizationIsRefused : Script ()
anExpiredAuthorizationIsRefused = script do
  f <- setupVault
  bob <- allocateParty "bob"
  auth <- authorize f.alice bob f.registrar "reference-1" (Some 100.0) None (minutes 1)
  passTime (minutes 1)
  failsWith "the authorization has expired" =<< depositAs f bob auth 10.0

-- | An authorization names one vault and works in no other.
anAuthorizationIsForOneVault : Script ()
anAuthorizationIsForOneVault = script do
  f <- setupVault
  bob <- allocateParty "bob"
  other <- authorize f.alice bob f.registrar "reference-2" (Some 100.0) None (days 1)
  failsWith "the authorization is for another vault" =<< depositAs f bob other 10.0
  foreign <- authorize f.alice bob bob "reference-1" (Some 100.0) None (days 1)
  failsWith "the authorization is for another vault" =<< depositAs f bob foreign 10.0

-- | The owner revokes by archiving, and the delegate can act no more.
aRevokedAuthorizationIsRefused : Script ()
aRevokedAuthorizationIsRefused = script do
  f <- setupVault
  bob <- allocateParty "bob"
  auth <- authorize f.alice bob f.registrar "reference-1" (Some 100.0) None (days 1)
  submit f.alice (archiveCmd auth)
  Left _ <- depositAs f bob auth 10.0
  pure ()

-- | Only the delegate acts on the authorization.
onlyTheDelegateActs : Script ()
onlyTheDelegateActs = script do
  f <- setupVault
  bob <- allocateParty "bob"
  carol <- allocateParty "carol"
  auth <- authorize f.alice bob f.registrar "reference-1" (Some 100.0) None (days 1)
  authD <- fromSome <$> queryDisclosure f.alice auth
  funds <- fund f f.alice 10.0
  fundsD <- fromSome <$> queryDisclosure f.alice (fromInterfaceContractId @MockHolding funds)
  ds <- vaultDisclosure f
  failsWith "requires authorizers" =<< trySubmit (actAs carol <> discloseMany (authD :: fundsD :: ds)) do
    exerciseCmd auth VaultDelegateAuth_Deposit with
      sender = basicAccount f.alice
      vaultCid = f.vaultCid; assets = 10.0; receiver = basicAccount f.alice; minSharesOut = None
      extraArgs = depositArgs f [funds]

-- | A delegate queues a deposit as the owner's own request, spending the allowance as it requests.
aDelegateQueuesADepositForTheOwner : Script ()
aDelegateQueuesADepositForTheOwner = script do
  env <- Q.setup
  bob <- allocateParty "bob"
  auth <- authorize env.alice bob env.registrar env.vaultId (Some 100.0) None (days 1)
  vd <- Q.vaultDisclosure env
  let requestAs auth label assets = trySubmit (actAs bob <> discloseMany [vd]) do
        exerciseCmd auth VaultDelegateAuth_RequestDeposit with
          sender = basicAccount env.alice
          vaultCid = toInterfaceContractId env.vaultCid; label; assets; receiver = basicAccount env.alice; minSharesOut = None
          extraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
  Right (auth, rid) <- requestAs auth "r1" 60.0
  (_, r) <- Q.published env env.alice "r1"
  (r.requester, r.amount, rid.requestId) === (env.alice, 60.0, 1)
  failsWith "the deposit allowance is exceeded" =<< requestAs auth "r2" 50.0
  allowances env.alice auth >>= (=== (Some 40.0, None))

-- | A delegate queues a redemption of the owner's shares, spending the allowance as it requests.
aDelegateQueuesARedemptionForTheOwner : Script ()
aDelegateQueuesARedemptionForTheOwner = script do
  env <- R.setup
  bob <- allocateParty "bob"
  auth <- authorize env.alice bob env.registrar env.vaultId None (Some 50.0) (days 1)
  vd <- R.vaultDisclosure env
  let requestAs auth label shares = trySubmit (actAs bob <> discloseMany [vd]) do
        exerciseCmd auth VaultDelegateAuth_RequestRedeem with
          from = basicAccount env.alice
          vaultCid = toInterfaceContractId env.vaultCid; label; shares; receiver = basicAccount bob; minAssetsOut = None
          extraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
  Right (auth, _) <- requestAs auth "r1" 30.0
  (_, r) <- R.published env env.alice "r1"
  (r.requester, r.receiver, r.amount) === (env.alice, bob, 30.0)
  failsWith "the redeem allowance is exceeded" =<< requestAs auth "r2" 30.0
  allowances env.alice auth >>= (=== (None, Some 20.0))

-- | A delegate pays in only from the owner's own accounts, whatever the vault would let through.
aDelegatePaysInOnlyFromTheOwnersAccounts : Script ()
aDelegatePaysInOnlyFromTheOwnersAccounts = script do
  f <- setupVault
  bob <- allocateParty "bob"
  auth <- authorize f.alice bob f.registrar "reference-1" (Some 100.0) (Some 100.0) (days 1)
  funds <- fund f bob 10.0
  fundsD <- fromSome <$> queryDisclosure bob (fromInterfaceContractId @MockHolding funds)
  ds <- vaultDisclosure f
  failsWith "the account is not the owner's" =<< trySubmit (actAs bob <> discloseMany (fundsD :: ds)) do
    exerciseCmd auth VaultDelegateAuth_Deposit with
      vaultCid = f.vaultCid; assets = 10.0; sender = basicAccount bob; receiver = basicAccount bob; minSharesOut = None
      extraArgs = depositArgs f [funds]

-- | The ledger state the endpoint check starts from on a sandbox.
module Canton.Vault.Test.Endpoint where

import Daml.Script

import Canton.Vault.Reference.V1
import Canton.Vault.Test.Deposit
import Canton.Vault.Test.MockToken

import Splice.Api.Token.HoldingV2 qualified as V2

-- | The parties and contracts the check uses.
data EndpointFixture = EndpointFixture with
  registrar : Party
  custodian : Party
  underlyingAdmin : Party
  alice : Party
  vaultCid : ContractId ReferenceVault
  registryCid : ContractId MockRegistry
  funds : ContractId V2.Holding

-- | A vault with nothing deposited, and Alice holding 100 of the underlying.
endpointFixture : Script EndpointFixture
endpointFixture = do
  f <- setupVault
  funds <- fund f f.alice 100.0
  pure EndpointFixture with
    registrar = f.registrar; custodian = f.custodian; underlyingAdmin = f.underlyingAdmin; alice = f.alice
    vaultCid = f.vaultTemplateCid; registryCid = f.registryTemplateCid; funds

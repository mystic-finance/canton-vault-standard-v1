-- | What a wallet that implements only the V1 token standard can do with a vault.
module Canton.Vault.Test.V1Wallet where

import DA.Action (void)
import DA.Assert ((===))
import DA.Optional (fromSome, isNone, isSome)
import DA.Time (addRelTime, hours)
import Daml.Script

import Canton.Vault.Test.CrossAdminSettlement (tokenArgs)
import Canton.Vault.Test.QueueSupport
import Canton.Vault.Test.QueuedDeposit

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV1 qualified as V1
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.AllocationV1 qualified as V1
import Splice.Api.Token.AllocationV2 qualified as V2
import Splice.Api.Token.AllocationInstructionV1 qualified as V1
import Splice.Api.Token.TransferInstructionV1 qualified as V1
import Splice.Testing.Tokens.TestTokenV2.Holding (Token(..))

v1Id : V2.InstrumentId -> V1.InstrumentId
v1Id i = V1.InstrumentId with admin = i.admin; id = i.id

-- | A party's unlocked holdings of the instrument, as a V1 wallet lists them.
v1Holdings : Party -> V2.InstrumentId -> Script [(ContractId V1.Holding, Decimal)]
v1Holdings party instrument = do
  held <- queryInterface @V1.Holding party
  pure [(cid, v.amount) | (cid, Some v) <- held, v.owner == party, v.instrumentId == v1Id instrument, isNone v.lock]

-- | Shares issued by a fill show in a V1 wallet, which moves them with the V1 transfer factory.
aV1WalletSeesAndTransfersShares : Script ()
aV1WalletSeesAndTransfersShares = script do
  env <- setup
  bob <- allocateParty "bob"
  (_, req) <- queueRequest env env.alice "r1" 100.0
  Right () <- fulfilAs env env.venue [req]
  shares <- v1Holdings env.alice (sharesId env)
  map snd shares === [100.0]
  now <- getTime
  result <- submit (actAs env.alice <> discloseMany [env.shares.disclosure]) do
    exerciseCmd (toInterfaceContractId @V1.TransferFactory env.shares.rulesCid) V1.TransferFactory_Transfer with
      expectedAdmin = env.registrar
      transfer = V1.Transfer with
        sender = env.alice
        receiver = bob
        amount = 40.0
        instrumentId = v1Id (sharesId env)
        requestedAt = now
        executeBefore = addRelTime now (hours 1)
        inputHoldingCids = map fst shares
        meta = emptyMetadata
      extraArgs = tokenArgs env.shares
  case result.output of
    V1.TransferInstructionResult_Completed {} -> pure ()
    V1.TransferInstructionResult_Pending with transferInstructionCid -> do
      tokens <- query @Token env.registrar
      locked <- forA [cid | (cid, t) <- tokens, isSome t.holding.lock] $ \cid -> fromSome <$> queryDisclosure env.registrar cid
      void $ submit (actAs bob <> discloseMany (env.shares.disclosure :: locked)) do
        exerciseCmd transferInstructionCid V1.TransferInstruction_Accept with extraArgs = tokenArgs env.shares
    V1.TransferInstructionResult_Failed {} -> abort "the V1 transfer failed"
  map snd <$> v1Holdings bob (sharesId env) >>= (=== [40.0])
  map snd <$> v1Holdings env.alice (sharesId env) >>= (=== [60.0])

-- | A request is funded from holdings found through the V1 interface, the requester signing the V2 allocate call
-- directly; the escrow is still committed, so it cannot be withdrawn before the deadline.
aV1WalletFundsARequestBySigningTheAllocateCall : Script ()
aV1WalletFundsARequestBySigningTheAllocateCall = script do
  env <- setup
  Right _ <- requestTerms env env.alice "r1" 100.0 env.alice None
  (cid, r) <- published env env.alice "r1"
  _ <- usdOf env env.alice 100.0
  usd <- v1Holdings env.alice (usdId env)
  map snd usd === [100.0]
  escrowed <- allocateWith env.usd env.alice r.escrow r.settlement (map (coerceInterfaceContractId . fst) usd)
  receiving <- authorizationAsRequested env r
  Right requestCid <- bindAs env env.venue cid escrowed receiving
  submitMustFail (actAs env.alice <> discloseMany [env.usd.disclosure]) do
    exerciseCmd escrowed V2.Allocation_Withdraw with actors = [env.alice]; extraArgs = tokenArgs env.usd
  Right () <- fulfilAs env env.venue [Req with requestCid; underlyingAllocation = escrowed; shareAllocation = receiving]
  map snd <$> v1Holdings env.alice (sharesId env) >>= (=== [100.0])

-- | An allocation made through the V1 factory is uncommitted, so the vault does not take it as a request's escrow.
aV1AllocationCannotFundARequest : Script ()
aV1AllocationCannotFundARequest = script do
  env <- setup
  Right _ <- requestTerms env env.alice "r1" 100.0 env.alice None
  (cid, r) <- published env env.alice "r1"
  funds <- usdOf env env.alice 100.0
  now <- getTime
  let [side] = r.escrow.transferLegSides
      deadline = fromSome r.escrow.settlementDeadline
      spec = V1.AllocationSpecification with
        settlement = V1.SettlementInfo with
          executor = env.venue
          settlementRef = V1.Reference with id = r.settlement.id; cid = r.settlement.cid
          requestedAt = now
          allocateBefore = deadline
          settleBefore = deadline
          meta = r.settlement.meta
        transferLegId = side.transferLegId
        transferLeg = V1.TransferLeg with
          sender = env.alice
          receiver = env.custodian
          amount = 100.0
          instrumentId = v1Id (usdId env)
          meta = emptyMetadata
  result <- submit (actAs env.alice <> discloseMany [env.usd.disclosure]) do
    exerciseCmd (toInterfaceContractId @V1.AllocationFactory env.usd.rulesCid) V1.AllocationFactory_Allocate with
      expectedAdmin = env.usd.admin
      allocation = spec
      requestedAt = now
      inputHoldingCids = [coerceInterfaceContractId funds]
      extraArgs = tokenArgs env.usd
  allocationCid <- case result.output of
    V1.AllocationInstructionResult_Completed with allocationCid -> pure allocationCid
    _ -> abort "expected a completed V1 allocation"
  Some escrow <- queryInterfaceContractId env.usd.admin (coerceInterfaceContractId allocationCid : ContractId V2.Allocation)
  escrow.allocation === r.escrow with committed = False
  receiving <- authorizationAsRequested env r
  failsWith "'escrow' is not equal to 'requested'" =<< bindAs env env.venue cid (coerceInterfaceContractId allocationCid) receiving

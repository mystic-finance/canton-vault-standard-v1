-- | Deposit and redeem against the reference vault.
module Canton.Vault.Test.Deposit where

import DA.Assert ((===))
import DA.Time (addRelTime, hours)
import DA.Text qualified as T
import DA.TextMap qualified as TextMap
import Daml.Script

import Canton.Vault.V1
import Canton.Vault.EventLog.V1
import Canton.Vault.Reference.V1
import Canton.Vault.Reference.Share
import Canton.Vault.Test.MockToken
import Canton.Vault.Test.Reports

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.TransferInstructionV2 qualified as V2
import Splice.TokenStandard.Utils

data Fixture = Fixture with
  registrar : Party
  custodian : Party
  underlyingAdmin : Party
  alice : Party
  vaultCid : ContractId Vault
  vaultTemplateCid : ContractId ReferenceVault
  registryCid : ContractId V2.TransferFactory
  registryTemplateCid : ContractId MockRegistry
  underlying : V2.InstrumentId
  shares : V2.InstrumentId

setupVault : Script Fixture
setupVault = setupVaultWith 0 None

setupFeeVault : Int -> Script Fixture
setupFeeVault feeBps = setupVaultWith feeBps None

setupCappedVault : Decimal -> Script Fixture
setupCappedVault cap = setupVaultFull 0 None (Some cap)

setupVaultWith : Int -> Optional Accrual -> Script Fixture
setupVaultWith feeBps vaultAccrual = setupVaultFull feeBps vaultAccrual None

setupVaultFull : Int -> Optional Accrual -> Optional Decimal -> Script Fixture
setupVaultFull feeBps = setupVaultFees feeBps feeBps

-- | Limits wide enough that no test roll meets them, for tests about something else.
wideLimits : PriceLimits
wideLimits = PriceLimits with maxIncreaseBpsPerYear = 1000000000000000000; maxDecreaseBps = 10000

setupVaultFees : Int -> Int -> Optional Accrual -> Optional Decimal -> Script Fixture
setupVaultFees = setupVaultLimited wideLimits

setupVaultLimited : PriceLimits -> Int -> Int -> Optional Accrual -> Optional Decimal -> Script Fixture
setupVaultLimited limits depositFeeBps redeemFeeBps vaultAccrual cap = do
  registrar <- allocateParty "registrar"
  custodian <- allocateParty "custodian"
  underlyingAdmin <- allocateParty "underlyingAdmin"
  alice <- allocateParty "alice"

  let underlying = V2.InstrumentId with admin = underlyingAdmin; id = "USD"
      shares = V2.InstrumentId with admin = registrar; id = "reference-1"

  registryTemplateCid <- submit underlyingAdmin do
    createCmd MockRegistry with admin = underlyingAdmin

  now <- getTime
  vaultTemplateCid <- submit (actAs [registrar, custodian]) do
    createCmd ReferenceVault with
      vaultId = "reference-1"
      vaultRegistrar = registrar
      custodian = basicAccount custodian
      underlyingInstrument = underlying
      shareInstrument = shares
      totalShares = 0.0
      totalAssets = 0.0
      accrual = vaultAccrual
      depositFeeBps
      redeemFeeBps
      rateValidFrom = now
      rateValidUntil = addRelTime now (hours 1)
      depositCap = cap
      paused = False
      underlyingTransferFactory = toInterfaceContractId registryTemplateCid
      pricing = PoolPricing
      priceLimits = limits

  pure Fixture with
    registrar; custodian; underlyingAdmin; alice
    vaultCid = toInterfaceContractId vaultTemplateCid
    vaultTemplateCid
    registryCid = toInterfaceContractId registryTemplateCid
    registryTemplateCid
    underlying; shares

-- | The vault and registry, disclosed, since a depositor sees neither.
-- | The fixture with the vault pinned to another factory, disclosed to the registrar.
repin : Fixture -> ContractId V2.TransferFactory -> Disclosure -> Script Fixture
repin f factory factoryD = do
  vaultTemplateCid <- submit (actAs f.registrar <> discloseMany [factoryD]) do
    exerciseCmd f.vaultTemplateCid ReferenceVault_SetTransferFactory with factory
  pure f with vaultTemplateCid; vaultCid = toInterfaceContractId vaultTemplateCid; registryCid = factory

-- | End the vault's period, so the next can be opened from its final flows.
closePeriod : Fixture -> ContractId ReferenceVault -> Script (ContractId ClosedPeriod)
closePeriod f vaultCid = submit f.registrar (exerciseCmd vaultCid ReferenceVault_ClosePeriod)

vaultDisclosure : Fixture -> Script [Disclosure]
vaultDisclosure f = do
  vault <- queryDisclosure f.registrar f.vaultTemplateCid
  registry <- queryDisclosure f.underlyingAdmin f.registryTemplateCid
  case (vault, registry) of
    (Some v, Some r) -> pure [v, r]
    _ -> abort "disclosures not available"

fund : Fixture -> Party -> Decimal -> Script (ContractId V2.Holding)
fund f party = fundInstrument f party f.underlying

fundInstrument : Fixture -> Party -> V2.InstrumentId -> Decimal -> Script (ContractId V2.Holding)
fundInstrument f party = fundAccount f (basicAccount party)

fundAccount : Fixture -> V2.Account -> V2.InstrumentId -> Decimal -> Script (ContractId V2.Holding)
fundAccount f account instrumentId amount = do
  cid <- submit f.underlyingAdmin do
    createCmd MockHolding with
      holding = V2.HoldingView with
        account
        instrumentId
        amount
        lock = None
        meta = emptyMetadata
  pure (toInterfaceContractId cid)

depositArgs : Fixture -> [ContractId V2.Holding] -> ExtraArgs
depositArgs _f holdingCids = ExtraArgs with
  context = ChoiceContext with
    values = TextMap.fromList
      [(underlyingHoldingsKey, AV_List (map (AV_ContractId . toAnyContractId) holdingCids))]
  meta = emptyMetadata

redeemArgs : Fixture -> [ContractId V2.Holding] -> [ContractId ShareHolding] -> ExtraArgs
redeemArgs _f underlyingCids shareCids = ExtraArgs with
  context = ChoiceContext with
    values = TextMap.fromList
      [ (underlyingHoldingsKey, AV_List (map (AV_ContractId . toAnyContractId) underlyingCids))
      , (shareHoldingsKey, AV_List (map (AV_ContractId . toAnyContractId) shareCids))
      ]
  meta = emptyMetadata

-- | The first deposit into an empty vault mints one share per unit.
firstDepositMintsAtPar : Script ()
firstDepositMintsAtPar = script do
  f <- setupVault
  holdingCid <- fund f f.alice 100.0

  disclosures <- vaultDisclosure f
  result <- submit (actAs f.alice <> discloseMany disclosures) do
    exerciseCmd f.vaultCid Vault_Deposit with
      sender = basicAccount f.alice
      assets = 100.0
      receiver = basicAccount f.alice
      minSharesOut = Some 100.0
      actors = [f.alice]
      extraArgs = depositArgs f [holdingCid]

  result.assets === 100.0
  result.shares === 100.0
  -- Nonconsuming: a deposit does not rewrite the vault.
  result.vaultCid === None
  pure ()

-- | A deposit minting fewer shares than asked for is rejected.
slippageLimitIsEnforced : Script ()
slippageLimitIsEnforced = script do
  f <- setupVault
  holdingCid <- fund f f.alice 100.0

  disclosures <- vaultDisclosure f
  submitMustFail (actAs f.alice <> discloseMany disclosures) do
    exerciseCmd f.vaultCid Vault_Deposit with
      sender = basicAccount f.alice
      assets = 100.0
      receiver = basicAccount f.alice
      minSharesOut = Some 101.0
      actors = [f.alice]
      extraArgs = depositArgs f [holdingCid]

-- | Shares redeem back into the underlying.
redeemReturnsUnderlying : Script ()
redeemReturnsUnderlying = script do
  f <- setupVault
  holdingCid <- fund f f.alice 100.0

  disclosures <- vaultDisclosure f
  depositResult <- submit (actAs f.alice <> discloseMany disclosures) do
    exerciseCmd f.vaultCid Vault_Deposit with
      sender = basicAccount f.alice
      assets = 100.0
      receiver = basicAccount f.alice
      minSharesOut = None
      actors = [f.alice]
      extraArgs = depositArgs f [holdingCid]

  custodianHoldings <- query @MockHolding f.custodian
  let custodianCids = map (toInterfaceContractId . fst) custodianHoldings
      shareCids = map fromInterfaceContractId depositResult.holdingCids
  -- The pool belongs to the custodian, who discloses it for the payout leg.
  poolDisclosures <- forA custodianHoldings $ \(cid, _) -> do
    d <- queryDisclosure f.custodian cid
    case d of
      Some d' -> pure d'
      None -> abort "pool holding disclosure not available"

  redeemResult <- submit (actAs f.alice <> discloseMany (disclosures <> poolDisclosures)) do
    exerciseCmd f.vaultCid Vault_Redeem with
      shares = 100.0
      owner = basicAccount f.alice
      receiver = basicAccount f.alice
      minAssetsOut = Some 100.0
      actors = [f.alice]
      extraArgs = redeemArgs f custodianCids shareCids

  redeemResult.shares === 100.0
  redeemResult.assets === 100.0
  pure ()

-- | A party cannot redeem shares they do not own, even holding the cids.
redeemRequiresTheOwner : Script ()
redeemRequiresTheOwner = script do
  f <- setupVault
  mallory <- allocateParty "mallory"
  holdingCid <- fund f f.alice 100.0
  disclosures <- vaultDisclosure f

  depositResult <- submit (actAs f.alice <> discloseMany disclosures) do
    exerciseCmd f.vaultCid Vault_Deposit with
      sender = basicAccount f.alice
      assets = 100.0
      receiver = basicAccount f.alice
      minSharesOut = None
      actors = [f.alice]
      extraArgs = depositArgs f [holdingCid]

  custodianHoldings <- query @MockHolding f.custodian
  poolDisclosures <- forA custodianHoldings $ \(cid, _) -> do
    d <- queryDisclosure f.custodian cid
    case d of
      Some d' -> pure d'
      None -> abort "pool holding disclosure not available"
  shareDisclosures <- forA depositResult.holdingCids $ \cid -> do
    d <- queryDisclosure f.registrar (fromInterfaceContractId cid : ContractId ShareHolding)
    case d of
      Some d' -> pure d'
      None -> abort "share holding disclosure not available"

  submitMustFail (actAs mallory <> discloseMany (disclosures <> poolDisclosures <> shareDisclosures)) do
    exerciseCmd f.vaultCid Vault_Redeem with
      shares = 100.0
      owner = basicAccount f.alice
      receiver = basicAccount mallory
      minAssetsOut = None
      actors = [mallory]
      extraArgs = redeemArgs f
        (map (toInterfaceContractId . fst) custodianHoldings)
        (map fromInterfaceContractId depositResult.holdingCids)

-- | Deposits in one period price the same, and the roll folds them in with the yield.
periodRollCarriesTotals : Script ()
periodRollCarriesTotals = script do
  f <- setupVault
  disclosures <- vaultDisclosure f
  bob <- allocateParty "bob"

  aliceFunds <- fund f f.alice 100.0
  bobFunds <- fund f bob 100.0

  aliceResult <- submit (actAs f.alice <> discloseMany disclosures) do
    exerciseCmd f.vaultCid Vault_Deposit with
      sender = basicAccount f.alice
      assets = 100.0
      receiver = basicAccount f.alice
      minSharesOut = None
      actors = [f.alice]
      extraArgs = depositArgs f [aliceFunds]

  bobResult <- submit (actAs bob <> discloseMany disclosures) do
    exerciseCmd f.vaultCid Vault_Deposit with
      sender = basicAccount bob
      assets = 100.0
      receiver = basicAccount bob
      minSharesOut = None
      actors = [bob]
      extraArgs = depositArgs f [bobFunds]

  -- The rate is fixed for the period, so the second deposit prices like the first.
  aliceResult.shares === bobResult.shares

  flows <- query @PeriodFlow f.registrar
  length flows === 2

  -- Yield arrives in the pool, where the roll must find it.
  _ <- fund f f.custodian 10.0
  custodianHoldings <- query @MockHolding f.custodian
  poolDisclosures <- forA custodianHoldings $ \(cid, _) -> do
    d <- queryDisclosure f.custodian cid
    case d of
      Some d' -> pure d'
      None -> abort "pool holding disclosure not available"

  now <- getTime
  closed10 <- closePeriod f f.vaultTemplateCid
  rolledCid <- submit (actAs f.registrar <> discloseMany poolDisclosures) do
    exerciseCmd closed10 ClosedPeriod_Open with
      flowCids = map fst flows
      evidence = PoolHoldings (map (toInterfaceContractId . fst) custodianHoldings)
      validUntil = addRelTime now (hours 2)

  Some rolled <- queryContractId f.registrar rolledCid
  rolled.totalShares === aliceResult.shares + bobResult.shares
  rolled.totalAssets === 210.0

  remaining <- query @PeriodFlow f.registrar
  length remaining === 0

-- | Holdings of another instrument cannot inflate the pool, even the custodian's.
rollRejectsWrongInstrument : Script ()
rollRejectsWrongInstrument = script do
  f <- setupVault
  disclosures <- vaultDisclosure f
  holdingCid <- fund f f.alice 100.0

  _ <- submit (actAs f.alice <> discloseMany disclosures) do
    exerciseCmd f.vaultCid Vault_Deposit with
      sender = basicAccount f.alice
      assets = 100.0
      receiver = basicAccount f.alice
      minSharesOut = None
      actors = [f.alice]
      extraArgs = depositArgs f [holdingCid]

  -- The custodian also holds a different instrument. It is not the pool.
  let other = V2.InstrumentId with admin = f.underlyingAdmin; id = "EUR"
  _ <- fundInstrument f f.custodian other 500.0

  custodianHoldings <- query @MockHolding f.custodian
  poolDisclosures <- forA custodianHoldings $ \(cid, _) -> do
    d <- queryDisclosure f.custodian cid
    case d of
      Some d' -> pure d'
      None -> abort "pool holding disclosure not available"

  flows <- query @PeriodFlow f.registrar
  now <- getTime
  closed11 <- closePeriod f f.vaultTemplateCid
  submitMustFail (actAs f.registrar <> discloseMany poolDisclosures) do
    exerciseCmd closed11 ClosedPeriod_Open with
      flowCids = map fst flows
      evidence = PoolHoldings (map (toInterfaceContractId . fst) custodianHoldings)
      validUntil = addRelTime now (hours 2)

-- | An account's provider can fund a deposit alongside its owner, which is reported as the owner's.
providerCanDepositForOwner : Script ()
providerCanDepositForOwner = script do
  f <- setupVault
  provider <- allocateParty "provider"
  disclosures <- vaultDisclosure f

  let account = V2.Account with
        owner = Some f.alice
        provider = Some provider
        id = ""
  holdingCid <- fundAccount f account f.underlying 100.0

  let args = ExtraArgs with
        context = (depositArgs f [holdingCid]).context
        meta = accountToMeta "sender" account emptyMetadata

  tree <- submitTree (actAs [f.alice, provider] <> discloseMany disclosures) do
    exerciseCmd f.vaultCid Vault_Deposit with
      sender = account
      assets = 100.0
      receiver = basicAccount f.alice
      minSharesOut = None
      actors = [f.alice, provider]
      extraArgs = args

  [(r.event, r.owner, r.actors) | r <- vaultReports tree]
    === [((Deposited with assets = 100.0; shares = 100.0; fromRequest = None), account, [f.alice, provider])]

-- | The actors must be exactly the funding account's parties; only the vault's check refuses this.
actorsMustMatchTheFundingAccount : Script ()
actorsMustMatchTheFundingAccount = script do
  f <- setupVault
  provider <- allocateParty "provider"
  disclosures <- vaultDisclosure f

  let account = V2.Account with
        owner = Some f.alice
        provider = Some provider
        id = ""
  holdingCid <- fundAccount f account f.underlying 100.0

  let args = ExtraArgs with
        context = (depositArgs f [holdingCid]).context
        meta = accountToMeta "sender" account emptyMetadata

  Left refused <- trySubmit (actAs [f.alice, provider] <> discloseMany disclosures) do
    exerciseCmd f.vaultCid Vault_Deposit with
      sender = account
      assets = 100.0
      receiver = basicAccount f.alice
      minSharesOut = None
      actors = [f.alice]
      extraArgs = args
  assertMsg ("refused by the vault's actors check: " <> show refused) ("allowed actors" `T.isInfixOf` show refused)

-- | The max methods answer for the party's own holdings, not the whole pool.
maxRedeemCountsOnlyTheParty : Script ()
maxRedeemCountsOnlyTheParty = script do
  f <- setupVault
  bob <- allocateParty "bob"
  disclosures <- vaultDisclosure f

  aliceFunds <- fund f f.alice 100.0
  bobFunds <- fund f bob 900.0

  aliceResult <- submit (actAs f.alice <> discloseMany disclosures) do
    exerciseCmd f.vaultCid Vault_Deposit with
      sender = basicAccount f.alice
      assets = 100.0
      receiver = basicAccount f.alice
      minSharesOut = None
      actors = [f.alice]
      extraArgs = depositArgs f [aliceFunds]

  _ <- submit (actAs bob <> discloseMany disclosures) do
    exerciseCmd f.vaultCid Vault_Deposit with
      sender = basicAccount bob
      assets = 900.0
      receiver = basicAccount bob
      minSharesOut = None
      actors = [bob]
      extraArgs = depositArgs f [bobFunds]

  -- Alice holds a tenth of the pool, so that is all she may redeem.
  let aliceShares : [ContractId ShareHolding] =
        map fromInterfaceContractId aliceResult.holdingCids
  limit <- submit f.registrar do
    createAndExerciseCmd (MaxRedeemProbe with caller = f.registrar) (Probe_Run with
      vaultCid = f.vaultCid
      party = f.alice
      extraArgs = redeemArgs f [] aliceShares)

  limit === aliceResult.shares

-- | Naming no holdings reports nothing available, not the whole pool.
maxRedeemWithoutEvidenceIsZero : Script ()
maxRedeemWithoutEvidenceIsZero = script do
  f <- setupVault
  disclosures <- vaultDisclosure f
  holdingCid <- fund f f.alice 100.0

  _ <- submit (actAs f.alice <> discloseMany disclosures) do
    exerciseCmd f.vaultCid Vault_Deposit with
      sender = basicAccount f.alice
      assets = 100.0
      receiver = basicAccount f.alice
      minSharesOut = None
      actors = [f.alice]
      extraArgs = depositArgs f [holdingCid]

  limit <- submit f.registrar do
    createAndExerciseCmd (MaxRedeemProbe with caller = f.registrar) (Probe_Run with
      vaultCid = f.vaultCid
      party = f.alice
      extraArgs = redeemArgs f [] [])

  limit === 0.0

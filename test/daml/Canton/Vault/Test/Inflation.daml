-- | The first-depositor inflation attack, and the offset that blunts it.
module Canton.Vault.Test.Inflation where

import DA.Assert ((===))
import DA.Time (addRelTime, hours)
import Daml.Script

import Canton.Vault.V1
import Canton.Vault.Reference.V1
import Canton.Vault.Test.Deposit
import Canton.Vault.Test.MockToken

-- | A donation after the attacker's first share still leaves the victim's deposit whole.
donationBeforeTheFirstDepositDoesNotRobTheNext : Script ()
donationBeforeTheFirstDepositDoesNotRobTheNext = script do
  f <- setupVault
  victim <- allocateParty "victim"
  disclosures <- vaultDisclosure f

  -- The smallest deposit the vault will take.
  attackerFunds <- fund f f.alice 0.0000000001
  attackerResult <- submit (actAs f.alice <> discloseMany disclosures) do
    exerciseCmd f.vaultCid Vault_Deposit with
      assets = 0.0000000001
      receiver = f.alice
      minSharesOut = None
      actors = [f.alice]
      extraArgs = depositArgs f [attackerFunds]

  -- Straight into the custodian's account, bypassing the vault entirely.
  _ <- fund f f.custodian 1000.0

  flows <- query @PeriodFlow f.registrar
  pool <- query @MockHolding f.custodian
  poolDisclosures <- forA pool $ \(cid, _) -> do
    d <- queryDisclosure f.custodian cid
    case d of
      Some d' -> pure d'
      None -> abort "pool holding disclosure not available"
  now <- getTime
  closed12 <- closePeriod f f.vaultTemplateCid
  rolledCid <- submit (actAs f.registrar <> discloseMany poolDisclosures) do
    exerciseCmd closed12 ClosedPeriod_Open with
      flowCids = map fst flows
      poolHoldingCids = map (toInterfaceContractId . fst) pool
      validUntil = addRelTime now (hours 2)

  -- The donation is now priced into the pool.
  Some rolled <- queryContractId f.registrar rolledCid
  rolled.totalAssets === 1000.0000000001

  rolledDisclosure <- queryDisclosure f.registrar rolledCid
  registry <- queryDisclosure f.underlyingAdmin f.registryTemplateCid
  rolledDisclosures <- case (rolledDisclosure, registry) of
    (Some v, Some r) -> pure [v, r]
    _ -> abort "disclosures not available"

  victimFunds <- fund f victim 100.0
  victimResult <- submit (actAs victim <> discloseMany rolledDisclosures) do
    exerciseCmd (toInterfaceContractId rolledCid : ContractId Vault) Vault_Deposit with
      assets = 100.0
      receiver = victim
      minSharesOut = None
      actors = [victim]
      extraArgs = depositArgs f [victimFunds]

  -- What the victim can get back must be close to what they paid in.
  worth <- submit f.registrar do
    createAndExerciseCmd (MaxRedeemProbe with caller = f.registrar) (Probe_Run with
      vaultCid = toInterfaceContractId rolledCid
      party = victim
      extraArgs = redeemArgs f [] (map fromInterfaceContractId victimResult.holdingCids))
  worth === victimResult.shares

  backing <- submit f.registrar do
    createAndExerciseCmd (MaxRedeemProbe with caller = f.registrar) (Probe_ConvertToAssets with
      vaultCid = toInterfaceContractId rolledCid
      shares = victimResult.shares)
  assertMsg
    ("victim paid 100.0, shares are worth " <> show backing)
    (backing >= 99.9)

  -- The attacker cannot recover the donation.
  attackerBacking <- submit f.registrar do
    createAndExerciseCmd (MaxRedeemProbe with caller = f.registrar) (Probe_ConvertToAssets with
      vaultCid = toInterfaceContractId rolledCid
      shares = attackerResult.shares)
  assertMsg
    ("attacker donated 1000.0, their shares are worth " <> show attackerBacking)
    (attackerBacking < 1.0)

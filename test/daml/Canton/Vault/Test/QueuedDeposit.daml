-- | Queued deposits: request, fulfilment, and what each refuses.
module Canton.Vault.Test.QueuedDeposit where

import DA.Assert ((===), assertMsg)
import DA.Action (void)
import DA.Foldable (forA_)
import DA.Optional (fromSome)
import DA.TextMap qualified as TextMap
import DA.Time (RelTime, addRelTime, days, hours, microseconds, minutes)
import Daml.Script

import Canton.Vault.V1
import Canton.Vault.AsyncDeposit.V1
import Canton.Vault.Reference.QueuedDeposit qualified as Q
import Canton.Vault.Reference.Queue qualified as Q
import Canton.Vault.Reference.V1 (PeriodFlow(..), PriceEvidence(..), PriceLimits(..), Pricing(..), shareHoldingsKey, underlyingHoldingsKey)
import Canton.Vault.Test.CrossAdminSettlement (Registry(..), setupTokenRegistry, tokenArgs, lockedTokens)
import Canton.Vault.Test.QueueSupport
import Canton.Vault.Test.Reports

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.AllocationV2 qualified as V2
import Splice.Api.Token.AllocationInstructionV2 qualified as V2
import Splice.Api.Token.AllocationRequestV2 qualified as AR
import Splice.Api.Token.TransferInstructionV2 qualified as V2
import Splice.TokenStandard.Utils
import Splice.Testing.Tokens.TestTokenV2 (TokenRules(..))
import Splice.Testing.Tokens.TestTokenV2.Allocation (TokenAllocationV2)
import Splice.Testing.Tokens.TestTokenV2.AccountConfig (AccountConfig(..), PartyConfig(..), accountConfigsContextKey)
import Splice.Testing.Tokens.TestTokenV2.Holding (Token(..))

data Env = Env with
  usd : Registry
  shares : Registry
  registrar : Party
  custodian : Party
  venue : Party
  alice : Party
  vaultCid : ContractId Q.ReferenceQueuedDepositVault
  vaultId : Text

window : RelTime
window = days 1

factoriesOf : Registry -> Q.Factories
factoriesOf r = Q.Factories with
  allocationFactory = toInterfaceContractId r.rulesCid
  settlementFactory = toInterfaceContractId r.rulesCid

setup : Script Env
setup = do
  usd <- setupTokenRegistry "usdAdmin"
  shares <- setupTokenRegistry "registrar"
  let registrar = shares.admin
  custodian <- allocateParty "custodian"
  venue <- allocateParty "venue"
  alice <- allocateParty "alice"
  now <- getTime
  let vaultId = "queued-1"
  vaultCid <- submitMulti [registrar, custodian] [] do
    createCmd Q.ReferenceQueuedDepositVault with
      vaultId
      vaultRegistrar = registrar
      custodian
      underlyingInstrument = V2.InstrumentId with admin = usd.admin; id = "USD"
      shareInstrument = V2.InstrumentId with admin = registrar; id = vaultId
      totalShares = 0.0
      totalAssets = 0.0
      accrual = None
      depositFeeBps = 0
      redeemFeeBps = 0
      rateValidFrom = now
      rateValidUntil = addRelTime now (hours 1)
      epoch = 0
      executors = [venue]
      settlementDeadlineWindow = window
      paused = False
      underlyingTransferFactory = toInterfaceContractId usd.rulesCid
      underlyingFactories = factoriesOf usd
      shareFactories = factoriesOf shares
      pricing = PoolPricing
      priceLimits = generousLimits
  pure Env with usd; shares; registrar; custodian; venue; alice; vaultCid; vaultId

usdOf : Env -> Party -> Decimal -> Script (ContractId V2.Holding)
usdOf env party amount = do
  cid <- submitMulti [party, env.usd.admin] [] do
    createCmd Token with
      holding = V2.HoldingView with
        account = basicAccount party
        instrumentId = (V2.InstrumentId with admin = env.usd.admin; id = "USD")
        amount
        lock = None
        meta = emptyMetadata
  pure (toInterfaceContractId cid)

settlementOf : Env -> V2.SettlementInfo
settlementOf env = V2.SettlementInfo with
  executors = [env.venue]
  id = requestSettlementId env.vaultId
  cid = None
  meta = emptyMetadata

allocateWith : Registry -> Party -> V2.AllocationSpecification -> V2.SettlementInfo -> [ContractId V2.Holding] -> Script (ContractId V2.Allocation)
allocateWith registry party spec settlement inputs = do
  now <- getTime
  result <- submit (actAs party <> discloseMany [registry.disclosure]) do
    exerciseCmd (toInterfaceContractId registry.rulesCid : ContractId V2.AllocationFactory)
      V2.AllocationFactory_Allocate with
        settlement
        allocation = spec
        requestedAt = now
        inputHoldingCids = inputs
        extraArgs = tokenArgs registry
        actors = [party]
  case result.output of
    V2.AllocationInstructionResult_Completed with allocationCid -> pure allocationCid
    other -> abort ("expected a completed allocation, got " <> show other)

-- | The receiver's committed authorization to be issued shares, the amount left to fulfilment.
shareSpec : Env -> Party -> Time -> V2.AllocationSpecification
shareSpec env party now = V2.AllocationSpecification with
  admin = env.registrar
  authorizer = basicAccount party
  transferLegSides = []
  settlementDeadline = Some (addRelTime now (window + hours 1))
  nextIterationFunding = Some TextMap.empty
  committed = True
  meta = emptyMetadata

-- | The vault as it stands, found by its id since every roll replaces the contract.
current : Env -> Script Env
current env = do
  vaults <- query @Q.ReferenceQueuedDepositVault env.registrar
  case [cid | (cid, v) <- vaults, v.vaultId == env.vaultId] of
    cid :: _ -> pure env with vaultCid = cid
    [] -> pure env

vaultDisclosure : Env -> Script Disclosure
vaultDisclosure env = do
  now <- current env
  fromSome <$> queryDisclosure env.registrar now.vaultCid

-- | A request on the party's behalf, naming its terms; the vault publishes the allocations it needs.
requestCmd : Env -> Party -> Text -> Decimal -> Party -> Optional Decimal -> Commands RequestId
requestCmd env party label assets receiver minSharesOut =
  exerciseCmd (toInterfaceContractId env.vaultCid : ContractId VaultAsyncDeposit) Vault_RequestDeposit with
    label; assets; receiver; minSharesOut
    actors = [party]
    extraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata

requestTerms : Env -> Party -> Text -> Decimal -> Party -> Optional Decimal -> Script (Either SubmitError RequestId)
requestTerms env party label assets receiver minSharesOut = do
  now <- current env
  vd <- vaultDisclosure now
  trySubmit (actAs party <> discloseMany [vd]) (requestCmd now party label assets receiver minSharesOut)

-- | The allocation request the vault published for the party's request under the label.
published : Env -> Party -> Text -> Script (ContractId Q.RequestAllocations, Q.RequestAllocations)
published env party label = do
  open <- query @Q.RequestAllocations party
  case [(cid, r) | (cid, r) <- open, r.vaultId == env.vaultId, r.label == label] of
    found :: _ -> pure found
    [] -> abort ("no allocation request under " <> label)

-- | The escrow, allocated exactly as requested from the requester's USD.
escrowAsRequested : Env -> Q.RequestAllocations -> Script (ContractId V2.Allocation)
escrowAsRequested env r = do
  funds <- usdOf env r.requester r.amount
  allocateWith env.usd r.requester r.escrow r.settlement [funds]

-- | The receiver's authorization, allocated exactly as requested.
authorizationAsRequested : Env -> Q.RequestAllocations -> Script (ContractId V2.Allocation)
authorizationAsRequested env r = allocateWith env.shares r.receiver r.authorization r.settlement []

bindAs : Env -> Party -> ContractId Q.RequestAllocations -> ContractId V2.Allocation -> ContractId V2.Allocation -> Script (Either SubmitError (ContractId Q.QueuedDepositRequest))
bindAs env party requestCid underlyingAllocation shareAllocation = do
  now <- current env
  vd <- vaultDisclosure now
  trySubmit (actAs party <> discloseMany [vd, env.usd.disclosure, env.shares.disclosure]) do
    exerciseCmd now.vaultCid Q.ReferenceQueuedDepositVault_Bind with requestCid; underlyingAllocation; shareAllocation

-- | A request the vault recorded, with the allocations it binds.
data Req = Req with
  requestCid : ContractId Q.QueuedDepositRequest
  underlyingAllocation : ContractId V2.Allocation
  shareAllocation : ContractId V2.Allocation

-- | The request the party made under the label, as the vault recorded it.
requestOf : Env -> Party -> Text -> Script Req
requestOf env party label = do
  held <- query @Q.QueuedDepositRequest party
  case [(cid, r) | (cid, r) <- held, r.vaultId == env.vaultId, r.label == label] of
    (cid, r) :: _ -> pure Req with requestCid = cid; underlyingAllocation = r.underlyingAllocation; shareAllocation = r.shareAllocation
    [] -> abort ("no request recorded under " <> label)

-- | A request made, allocated exactly as requested and bound, as requester, receiver and executors would.
requestFor : Env -> Party -> Party -> Text -> Decimal -> Optional Decimal -> Script (RequestId, Req)
requestFor env party receiver label assets minSharesOut = do
  Right rid <- requestTerms env party label assets receiver minSharesOut
  (cid, r) <- published env party label
  escrowed <- escrowAsRequested env r
  receiving <- authorizationAsRequested env r
  Right _ <- bindAs env env.venue cid escrowed receiving
  req <- requestOf env party label
  pure (rid, req)

request : Env -> Party -> Text -> Decimal -> Script (RequestId, Req)
request env party label assets = requestFor env party party label assets None

fulfilCmd : Env -> [Req] -> [ContractId Q.PeriodPrice] -> Commands ()
fulfilCmd env requests prices = exerciseCmd env.vaultCid Q.ReferenceQueuedDepositVault_Fulfil with
  requestCids = map (.requestCid) requests
  priceCids = prices
  underlyingExtraArgs = tokenArgs env.usd
  shareExtraArgs = tokenArgs env.shares

-- | Every price the vault has struck.
pricesOf : Env -> Script [ContractId Q.PeriodPrice]
pricesOf env = do
  prices <- query @Q.PeriodPrice env.registrar
  pure [cid | (cid, p) <- prices, p.vaultId == env.vaultId]

-- | Rolls the vault into the next period.
nextPeriod : Env -> Script Env
nextPeriod env = do
  now <- current env
  closeQueued now >>= openQueued now

-- | The vault ready to fill the requests: rolled on if any was made in the period now open.
readyToFill : Env -> [Req] -> Script Env
readyToFill env requests = do
  vaults <- query @Q.ReferenceQueuedDepositVault env.registrar
  case [(cid, v) | (cid, v) <- vaults, v.vaultId == env.vaultId] of
    [] -> pure env
    (cid, v) :: _ -> do
      epochs <- forA requests $ \r -> fmap (.epoch) <$> queryContractId env.registrar r.requestCid
      if any (>= Some v.epoch) epochs then nextPeriod (env with vaultCid = cid) else pure env with vaultCid = cid

-- | Fulfils the requests in the period now open, with every struck price, and returns what was reported.
fulfilNowTree : Env -> Party -> [Req] -> Script (Either SubmitError TransactionTree)
fulfilNowTree env party requests = fulfilAtTree env party requests =<< pricesOf env

-- | Fulfils the requests in the period now open, naming only the prices given.
fulfilAtTree : Env -> Party -> [Req] -> [ContractId Q.PeriodPrice] -> Script (Either SubmitError TransactionTree)
fulfilAtTree env party requests prices = do
  now <- current env
  locked <- lockedTokens env.usd (map (.underlyingAllocation) requests)
  trySubmitTree (actAs party <> discloseMany ([env.usd.disclosure, env.shares.disclosure] <> locked)) (fulfilCmd now requests prices)

fulfilNow : Env -> Party -> [Req] -> Script (Either SubmitError ())
fulfilNow env party requests = fmap (const ()) <$> fulfilNowTree env party requests

-- | Rolls on if the requests' period is still open, then fulfils them.
fulfilAs : Env -> Party -> [Req] -> Script (Either SubmitError ())
fulfilAs env party requests = do
  ready <- readyToFill env requests
  fulfilNow ready party requests

-- | What a transaction reported about queued requests.
reported : TransactionTree -> [Q.QueuedEvent]
reported tree = map (.event) (exercisesOf @Q.QueueLog @Q.QueueLog_Report tree)

tokens : Env -> V2.InstrumentId -> Party -> Script Decimal
tokens env instrument party = do
  held <- query @Token party
  pure (sum [h.holding.amount | (_, h) <- held, h.holding.instrumentId == instrument, h.holding.account.owner == Some party])

usdId, sharesId : Env -> V2.InstrumentId
usdId env = V2.InstrumentId with admin = env.usd.admin; id = "USD"
sharesId env = V2.InstrumentId with admin = env.registrar; id = env.vaultId

-- | Reads what is still queued, as a party able to see the escrow.
template PendingProbe
  with
    caller : Party
  where
    signatory caller
    choice Probe_Pending : Decimal
      with
        vaultCid : ContractId VaultAsyncDeposit
        requestId : RequestId
        party : Party
        requests : [ContractId Q.QueuedDepositRequest]
      controller caller
      do
        vault <- fetch vaultCid
        pendingDepositRequest vault requestId party ExtraArgs with
          context = ChoiceContext with
            values = TextMap.fromList
              [(Q.depositRequestsKey, AV_List (map (AV_ContractId . toAnyContractId) requests))]
          meta = emptyMetadata

pending : Env -> RequestId -> Party -> [ContractId Q.QueuedDepositRequest] -> Script Decimal
pending env rid party requests = do
  now <- current env
  submit env.venue do
    createAndExerciseCmd (PendingProbe with caller = env.venue) Probe_Pending with
      vaultCid = toInterfaceContractId now.vaultCid
      requestId = rid
      party
      requests

-- Requests and fulfilment
---------------------------

requestThenFulfil : Script ()
requestThenFulfil = script do
  env <- setup
  (rid, req) <- request env env.alice "r1" 100.0
  rid === 0
  pending env rid env.alice [req.requestCid] >>= (=== 100.0)
  result <- fulfilAs env env.venue [req]
  case result of
    Right () -> pure ()
    Left e -> abort ("fulfilment failed: " <> show e)
  tokens env (sharesId env) env.alice >>= (=== 100.0)
  tokens env (usdId env) env.custodian >>= (=== 100.0)

-- | Requests made in one period share its id, so what a requester has pending under it is all of them together.
requestsAggregateUnderOneId : Script ()
requestsAggregateUnderOneId = script do
  env <- setup
  (r1, a) <- request env env.alice "r1" 100.0
  (r2, b) <- request env env.alice "r2" 50.0
  r1 === r2
  pending env 0 env.alice [a.requestCid, b.requestCid] >>= (=== 150.0)
  pending env 1 env.alice [a.requestCid, b.requestCid] >>= (=== 0.0)
  Right () <- fulfilAs env env.venue [a, b]
  tokens env (sharesId env) env.alice >>= (=== 150.0)

-- What a queued-deposit vault refuses
---------------------------------------

instantDepositIsRefused : Script ()
instantDepositIsRefused = script do
  env <- setup
  funds <- usdOf env env.alice 100.0
  vd <- vaultDisclosure env
  submitMustFail (actAs env.alice <> discloseMany [vd]) do
    exerciseCmd (toInterfaceContractId env.vaultCid : ContractId Vault) Vault_Deposit with
      assets = 100.0
      receiver = env.alice
      minSharesOut = None
      actors = [env.alice]
      extraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata

fulfilmentByAnotherPartyIsRefused : Script ()
fulfilmentByAnotherPartyIsRefused = script do
  env <- setup
  (_, req) <- request env env.alice "r1" 100.0
  vd <- vaultDisclosure env
  locked <- lockedTokens env.usd [req.underlyingAllocation]
  failsWith "requires authorizers" =<<
    trySubmit (actAs env.alice <> discloseMany ([vd, env.usd.disclosure, env.shares.disclosure] <> locked)) (fulfilCmd env [req] [])
  tokens env (sharesId env) env.alice >>= (=== 0.0)

-- | A share batch that fails after the underlying batch settled takes the underlying back with it.
fulfilmentIsAtomic : Script ()
fulfilmentIsAtomic = script do
  env <- setup
  (_, req) <- request env env.alice "r1" 100.0
  doomed <- submit env.registrar (createCmd TokenRules with admin = env.registrar)
  vaultCid <- submit (actAs env.registrar <> discloseMany [env.usd.disclosure, env.shares.disclosure]) do
    exerciseCmd env.vaultCid Q.ReferenceQueuedDepositVault_SetFactories with
      transferFactory = toInterfaceContractId env.usd.rulesCid
      underlying = factoriesOf env.usd
      shares = (factoriesOf env.shares) with settlementFactory = toInterfaceContractId doomed
  submit env.registrar (archiveCmd doomed)
  failsWith "NotActive" =<< fulfilAs (env with vaultCid) env.venue [req]
  tokens env (usdId env) env.custodian >>= (=== 0.0)
  tokens env (sharesId env) env.alice >>= (=== 0.0)

-- | The receiver cannot pull their authorization from under the executors before its deadline.
shareAuthorizationCannotBeWithdrawnBeforeTheDeadline : Script ()
shareAuthorizationCannotBeWithdrawnBeforeTheDeadline = script do
  env <- setup
  (_, req) <- request env env.alice "r1" 100.0
  submitMustFail (actAs env.alice <> discloseMany [env.shares.disclosure]) do
    exerciseCmd req.shareAllocation V2.Allocation_Withdraw with actors = [env.alice]; extraArgs = tokenArgs env.shares

-- | Past the deadline, the requester recovers their escrow without the executors.
requesterRecoversAfterTheDeadline : Script ()
requesterRecoversAfterTheDeadline = script do
  env <- setup
  (_, req) <- request env env.alice "r1" 100.0
  passTime (window + hours 2)
  _ <- submit (actAs env.alice <> discloseMany [env.usd.disclosure]) do
    exerciseCmd req.underlyingAllocation V2.Allocation_Withdraw with actors = [env.alice]; extraArgs = tokenArgs env.usd
  held <- query @Token env.alice
  sum [h.holding.amount | (_, h) <- held, h.holding.instrumentId == usdId env, h.holding.lock == None] === 100.0

-- | A committed escrow cannot be withdrawn before its deadline, which is what holds it for the executors.
escrowCannotBeWithdrawnBeforeTheDeadline : Script ()
escrowCannotBeWithdrawnBeforeTheDeadline = script do
  env <- setup
  (_, req) <- request env env.alice "r1" 100.0
  submitMustFail (actAs env.alice <> discloseMany [env.usd.disclosure]) do
    exerciseCmd req.underlyingAllocation V2.Allocation_Withdraw with actors = [env.alice]; extraArgs = tokenArgs env.usd

-- | Before the deadline, the executors cancel a request and the escrow returns to the requester.
executorsCancelBeforeTheDeadline : Script ()
executorsCancelBeforeTheDeadline = script do
  env <- setup
  (_, req) <- request env env.alice "r1" 100.0
  locked <- lockedTokens env.usd [req.underlyingAllocation]
  _ <- submit (actAs env.venue <> discloseMany (env.usd.disclosure :: locked)) do
    exerciseCmd req.underlyingAllocation V2.Allocation_Cancel with actors = [env.venue]; extraArgs = tokenArgs env.usd
  _ <- submit (actAs env.venue <> discloseMany [env.shares.disclosure]) do
    exerciseCmd req.shareAllocation V2.Allocation_Cancel with actors = [env.venue]; extraArgs = tokenArgs env.shares
  held <- query @Token env.alice
  sum [h.holding.amount | (_, h) <- held, h.holding.instrumentId == usdId env, h.holding.lock == None] === 100.0

-- | The funding account is Alice's, so only Alice may request from it, not Alice and a stranger.
requestWithAStrangerIsRefused : Script ()
requestWithAStrangerIsRefused = script do
  env <- setup
  carol <- allocateParty "carol"
  vd <- vaultDisclosure env
  submitMustFail (actAs [env.alice, carol] <> discloseMany [vd]) do
    exerciseCmd (toInterfaceContractId env.vaultCid : ContractId VaultAsyncDeposit) Vault_RequestDeposit with
      label = "r1"; assets = 100.0; receiver = env.alice; minSharesOut = None
      actors = [env.alice, carol]; extraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata

requestAfterThePeriodEndsIsRefused : Script ()
requestAfterThePeriodEndsIsRefused = script do
  env <- setup
  passTime (hours 2)
  failsWith "rate period is still open" =<< requestTerms env env.alice "r1" 100.0 env.alice None

fulfilmentAfterThePeriodEndsIsRefused : Script ()
fulfilmentAfterThePeriodEndsIsRefused = script do
  env <- setup
  (_, req) <- request env env.alice "r1" 100.0
  next <- nextPeriod env
  passTime (hours 2)
  failsWith "rate period is still open" =<< fulfilNow next env.venue [req]
  tokens env (sharesId env) env.alice >>= (=== 0.0)

-- Closing a period
--------------------

closeQueued : Env -> Script (ContractId Q.ClosedQueuedPeriod)
closeQueued env = do
  now <- current env
  submit env.registrar (exerciseCmd now.vaultCid Q.ReferenceQueuedDepositVault_ClosePeriod)

-- | Opens the next period from the closed one's flows and the custodian's USD.
openQueued : Env -> ContractId Q.ClosedQueuedPeriod -> Script Env
openQueued env closed = do
  flows <- query @PeriodFlow env.registrar
  pool <- query @Token env.custodian
  now <- getTime
  vaultCid <- submit (actAs env.registrar <> readAs env.custodian) do
    exerciseCmd closed Q.ClosedQueuedPeriod_Open with
      flowCids = [cid | (cid, flow) <- flows, flow.vaultId == env.vaultId]
      evidence = PoolHoldings ([toInterfaceContractId cid | (cid, t) <- pool, t.holding.instrumentId == usdId env
                                                   , t.holding.account.owner == Some env.custodian])
      validUntil = addRelTime now (hours 1)
  pure env with vaultCid

-- | Nothing lands in a closed period: neither a new request nor a fulfilment.
closedPeriodRefusesRequestsAndFulfilment : Script ()
closedPeriodRefusesRequestsAndFulfilment = script do
  env <- setup
  (_, req) <- request env env.alice "r1" 100.0
  vd <- vaultDisclosure env
  _ <- closeQueued env
  submitMustFail (actAs env.alice <> discloseMany [vd]) (requestCmd env env.alice "r2" 100.0 env.alice None)
  Left _ <- fulfilAs env env.venue [req]
  pure ()

-- | The next period counts the shares fulfilled in the closed one.
nextPeriodCountsFulfilments : Script ()
nextPeriodCountsFulfilments = script do
  env <- setup
  (_, req) <- request env env.alice "r1" 100.0
  Right () <- fulfilAs env env.venue [req]
  closed <- closeQueued env
  next <- openQueued env closed
  Some vault <- queryContractId env.registrar next.vaultCid
  vault.totalShares === 100.0
  vault.totalAssets === 100.0

-- | A close can be undone: the vault comes back as it was, taking requests and fulfilments as before.
reopenRestoresTheQueuedVault : Script ()
reopenRestoresTheQueuedVault = script do
  env <- setup
  (_, first) <- request env env.alice "r1" 100.0
  closed <- closeQueued env
  reopened <- submit env.registrar (exerciseCmd closed Q.ClosedQueuedPeriod_Reopen)
  let env' = env with vaultCid = reopened
  (_, second) <- request env' env.alice "r2" 50.0
  Right () <- fulfilAs env' env.venue [first, second]
  tokens env (sharesId env) env.alice >>= (=== 150.0)

-- | A request is recorded for its requester while pending, and its fulfilment once fulfilled.
requestIsRecordedAndItsFulfilmentReported : Script ()
requestIsRecordedAndItsFulfilmentReported = script do
  env <- setup
  (_, req) <- request env env.alice "r1" 100.0
  pendingNow <- map snd <$> query @Q.QueuedDepositRequest env.alice
  map (\r -> (r.label, r.assets, r.receiver)) pendingNow === [("r1", 100.0, env.alice)]
  ready <- readyToFill env [req]
  Right tree <- fulfilNowTree ready env.venue [req]
  query @Q.QueuedDepositRequest env.alice >>= (=== []) . map snd
  map (\e -> (e.label, e.requested, e.outcome)) (reported tree) === [("r1", 100.0, Q.Fulfilled with received = 100.0)]
  map (.observers) (exercisesOf @Q.QueueLog @Q.QueueLog_Report tree) === [[env.alice]]
  query @Q.QueueLog env.registrar >>= (=== []) . map snd

-- Pausing
-----------

setPaused : Env -> Bool -> Script Env
setPaused env flag = do
  now <- current env
  vaultCid <- submit env.registrar (exerciseCmd now.vaultCid Q.ReferenceQueuedDepositVault_SetPaused with pause = flag)
  pure env with vaultCid

-- | A paused vault takes no requests and fulfils none, but still redeems; resumed, it fulfils again.
pauseStopsRequestsAndFulfilmentNotRedemption : Script ()
pauseStopsRequestsAndFulfilmentNotRedemption = script do
  env <- setup
  (_, first) <- request env env.alice "r1" 100.0
  Right () <- fulfilAs env env.venue [first]
  (_, waiting) <- request env env.alice "r2" 50.0
  paused <- setPaused env True

  failsWith "vault is not paused" =<< requestTerms paused env.alice "r3" 10.0 env.alice None
  Left _ <- fulfilAs paused env.venue [waiting]

  shares <- query @Token env.alice
  pool <- query @Token env.custodian
  let shareCids = [cid | (cid, t) <- shares, t.holding.instrumentId == sharesId env]
      poolCids = [cid | (cid, t) <- pool, t.holding.instrumentId == usdId env]
      ids cids = AV_List [AV_ContractId (toAnyContractId c) | c <- cids]
      args = (tokenArgs env.usd) with
        context = (tokenArgs env.usd).context with
          values = TextMap.union (TextMap.fromList [(underlyingHoldingsKey, ids poolCids), (shareHoldingsKey, ids shareCids)])
            (tokenArgs env.usd).context.values
  poolDs <- forA poolCids $ \cid -> fromSome <$> queryDisclosure env.custodian cid
  stillPaused <- current paused
  vd' <- vaultDisclosure stillPaused
  _ <- submit (actAs env.alice <> discloseMany ([vd', env.usd.disclosure] <> poolDs)) do
    exerciseCmd (toInterfaceContractId stillPaused.vaultCid : ContractId Vault) Vault_Redeem with
      shares = 40.0; owner = env.alice; receiver = env.alice; minAssetsOut = None
      actors = [env.alice]; extraArgs = args
  tokens env (sharesId env) env.alice >>= (=== 60.0)
  held <- query @Token env.alice
  sum [h.holding.amount | (_, h) <- held, h.holding.instrumentId == usdId env, h.holding.lock == None] === 40.0

  resumed <- setPaused paused False
  Right () <- fulfilAs resumed env.venue [waiting]
  tokens env (sharesId env) env.alice >>= (=== 110.0)

-- Pinned factories
--------------------

-- | Fulfilment goes through the factories the vault pins, so re-pinning moves it.
repinnedFactoriesCarryFulfilment : Script ()
repinnedFactoriesCarryFulfilment = script do
  env <- setup
  (_, req) <- request env env.alice "r1" 100.0
  rulesCid <- submit env.usd.admin (createCmd TokenRules with admin = env.usd.admin)
  Some disclosure <- queryDisclosure env.usd.admin rulesCid
  let usd' = env.usd with rulesCid; disclosure
  vaultCid <- submit (actAs env.registrar <> discloseMany [disclosure, env.shares.disclosure]) do
    exerciseCmd env.vaultCid Q.ReferenceQueuedDepositVault_SetFactories with
      transferFactory = toInterfaceContractId rulesCid
      underlying = factoriesOf usd'
      shares = factoriesOf env.shares
  -- The old factory is gone, so only the re-pinned one can settle.
  submit env.usd.admin (archiveCmd env.usd.rulesCid)
  Right () <- fulfilAs (env with usd = usd'; vaultCid) env.venue [req]
  tokens env (sharesId env) env.alice >>= (=== 100.0)

repinRefused : Env -> ContractId V2.TransferFactory -> Q.Factories -> Q.Factories -> [Disclosure] -> Script ()
repinRefused env transferFactory underlying shares ds =
  submitMustFail (actAs env.registrar <> discloseMany ds) do
    exerciseCmd env.vaultCid Q.ReferenceQueuedDepositVault_SetFactories with transferFactory; underlying; shares

-- | Each pinned factory must belong to its registry, which catches pinning the wrong one.
repinToAnotherRegistrysFactoriesIsRefused : Script ()
repinToAnotherRegistrysFactoriesIsRefused = script do
  env <- setup
  let ds = [env.usd.disclosure, env.shares.disclosure]
      usdFactory = toInterfaceContractId env.usd.rulesCid
      shareFactory = toInterfaceContractId env.shares.rulesCid
  repinRefused env shareFactory (factoriesOf env.usd) (factoriesOf env.shares) ds
  repinRefused env usdFactory (factoriesOf env.shares) (factoriesOf env.shares) ds
  repinRefused env usdFactory (factoriesOf env.usd) (factoriesOf env.usd) ds
  failsWith "settlement factory admin" =<< trySubmit (actAs env.registrar <> discloseMany ds) do
    exerciseCmd env.vaultCid Q.ReferenceQueuedDepositVault_SetFactories with
      transferFactory = usdFactory; shares = factoriesOf env.shares
      underlying = (factoriesOf env.usd) with settlementFactory = toInterfaceContractId env.shares.rulesCid
  _ <- submit (actAs env.registrar <> discloseMany ds) do
    exerciseCmd env.vaultCid Q.ReferenceQueuedDepositVault_SetFactories with
      transferFactory = usdFactory; underlying = factoriesOf env.usd; shares = factoriesOf env.shares
  pure ()

-- | One fulfilment settles a large queue: thirty requests in a single batch per registry.
fulfilsALargeQueueInOneBatch : Script ()
fulfilsALargeQueueInOneBatch = script do
  env <- setup
  requests <- forA [1 .. 30] $ \i -> snd <$> request env env.alice ("r" <> show i) 10.0
  Right () <- fulfilAs env env.venue requests
  tokens env (sharesId env) env.alice >>= (=== 300.0)
  tokens env (usdId env) env.custodian >>= (=== 300.0)

-- Accounts with a provider
----------------------------

-- | An account Alice holds with a provider who must approve every allocation from it.
providerAccount : Registry -> Party -> Party -> Script (V2.Account, ExtraArgs, Disclosure)
providerAccount registry owner provider = do
  let account = V2.Account with owner = Some owner; provider = Some provider; id = "custody"
  cfg <- submitMulti [owner, provider] [] do
    createCmd AccountConfig with
      admin = registry.admin; account
      ownerConfig = PartyConfig with canInitiate = True; mustApprove = False
      providerConfig = PartyConfig with canInitiate = True; mustApprove = True
  cfgD <- fromSome <$> queryDisclosure registry.admin cfg
  let args = (tokenArgs registry) with
        context = (tokenArgs registry).context with
          values = TextMap.insert accountConfigsContextKey (AV_List [AV_ContractId (toAnyContractId cfg)])
            (tokenArgs registry).context.values
  pure (account, args, cfgD)

-- | Allocates from a provider account: the owner initiates, it goes pending, the provider approves.
allocateApproved : Registry -> Party -> Party -> ExtraArgs -> Disclosure -> V2.AllocationSpecification -> V2.SettlementInfo -> [ContractId V2.Holding] -> Script (ContractId V2.Allocation)
allocateApproved registry owner provider args cfgD spec settlement inputs = do
  now <- getTime
  result <- submit (actAs owner <> discloseMany [registry.disclosure, cfgD]) do
    exerciseCmd (toInterfaceContractId registry.rulesCid : ContractId V2.AllocationFactory) V2.AllocationFactory_Allocate with
      settlement; allocation = spec; requestedAt = now; inputHoldingCids = inputs; extraArgs = args; actors = [owner]
  instruction <- case result.output of
    V2.AllocationInstructionResult_Pending with allocationInstructionCid -> pure allocationInstructionCid
    other -> abort ("expected the allocation to wait for the provider, got " <> show other)
  approved <- submit (actAs provider <> discloseMany [registry.disclosure, cfgD]) do
    exerciseCmd instruction V2.AllocationInstruction_Accept with actors = [provider]; extraArgs = args
  case approved.output of
    V2.AllocationInstructionResult_Completed with allocationCid -> pure allocationCid
    other -> abort ("expected the allocation once approved, got " <> show other)

-- | A request funded from a provider account, approved by the provider, is fulfilled from that account.
providerAccountEscrowIsFulfilled : Script ()
providerAccountEscrowIsFulfilled = script do
  env <- setup
  bank <- allocateParty "bank"
  (account, args, cfgD) <- providerAccount env.usd env.alice bank
  funds <- submitMulti [env.alice, bank, env.usd.admin] [] do
    createCmd Token with holding = V2.HoldingView with account; instrumentId = usdId env; amount = 100.0; lock = None; meta = emptyMetadata
  vd <- vaultDisclosure env
  _ <- submit (actAs [env.alice, bank] <> discloseMany [vd]) do
    exerciseCmd (toInterfaceContractId env.vaultCid : ContractId VaultAsyncDeposit) Vault_RequestDeposit with
      label = "r1"; assets = 100.0; receiver = env.alice; minSharesOut = None
      actors = [env.alice, bank]; extraArgs = ExtraArgs with context = emptyChoiceContext; meta = accountToMeta "sender" account emptyMetadata
  (cid, r) <- published env env.alice "r1"
  escrowed <- allocateApproved env.usd env.alice bank args cfgD r.escrow r.settlement [toInterfaceContractId funds]
  receiving <- authorizationAsRequested env r
  Right _ <- bindAs env env.venue cid escrowed receiving
  req <- requestOf env env.alice "r1"
  next <- nextPeriod env
  locked <- lockedTokens env.usd [req.underlyingAllocation]
  Right () <- trySubmit (actAs env.venue <> discloseMany ([env.usd.disclosure, env.shares.disclosure, cfgD] <> locked)) do
    exerciseCmd next.vaultCid Q.ReferenceQueuedDepositVault_Fulfil with
      requestCids = [req.requestCid]; priceCids = []
      underlyingExtraArgs = args; shareExtraArgs = tokenArgs env.shares
  tokens env (sharesId env) env.alice >>= (=== 100.0)
  tokens env (usdId env) env.custodian >>= (=== 100.0)

-- | A receiver who names a provider account, and authorizes shares into it with the provider's approval, is issued them there.
providerAccountReceiverIsIssuedShares : Script ()
providerAccountReceiverIsIssuedShares = script do
  env <- setup
  bank <- allocateParty "bank"
  (account, args, cfgD) <- providerAccount env.shares env.alice bank
  vd <- vaultDisclosure env
  _ <- submit (actAs env.alice <> discloseMany [vd]) do
    exerciseCmd (toInterfaceContractId env.vaultCid : ContractId VaultAsyncDeposit) Vault_RequestDeposit with
      label = "r1"; assets = 100.0; receiver = env.alice; minSharesOut = None
      actors = [env.alice]; extraArgs = ExtraArgs with context = emptyChoiceContext; meta = accountToMeta "receiver" account emptyMetadata
  (cid, r) <- published env env.alice "r1"
  escrowed <- escrowAsRequested env r
  receiving <- allocateApproved env.shares env.alice bank args cfgD r.authorization r.settlement []
  Right _ <- bindAs env env.venue cid escrowed receiving
  req <- requestOf env env.alice "r1"
  next <- nextPeriod env
  locked <- lockedTokens env.usd [req.underlyingAllocation]
  Right () <- trySubmit (actAs env.venue <> discloseMany ([env.usd.disclosure, env.shares.disclosure, cfgD] <> locked)) do
    exerciseCmd next.vaultCid Q.ReferenceQueuedDepositVault_Fulfil with
      requestCids = [req.requestCid]; priceCids = []
      underlyingExtraArgs = tokenArgs env.usd; shareExtraArgs = args
  held <- query @Token env.alice
  sum [h.holding.amount | (_, h) <- held, h.holding.account == account, h.holding.instrumentId == sharesId env] === 100.0

-- Request records
-------------------

-- | Only the registrar records a request, so no executor can pair one requester's escrow with another's authorization.
executorCannotForgeARequest : Script ()
executorCannotForgeARequest = script do
  env <- setup
  (_, req) <- request env env.alice "r1" 100.0
  bob <- allocateParty "bob"
  forgedAt <- getTime
  bobs <- allocateWith env.shares bob (shareSpec env bob forgedAt) (settlementOf env) []
  submitMustFail env.venue do
    createCmd Q.QueuedDepositRequest with
      vaultId = env.vaultId; vaultRegistrar = env.registrar; executors = [env.venue]
      requester = env.alice; receiver = bob; label = "r1"; assets = 100.0; anchor = coerceContractId req.requestCid
      underlyingAllocation = req.underlyingAllocation; shareAllocation = bobs
      expiresAt = forgedAt; epoch = 0; minSharesOut = None

-- | A copy of the vault under another id and its own custodian, with the same registrar and executors.
anotherVault : Env -> Text -> Script Env
anotherVault env vaultId = do
  now <- current env
  Some vault <- queryContractId env.registrar now.vaultCid
  custodian <- allocateParty "otherCustodian"
  vaultCid <- submitMulti [env.registrar, custodian] [] do
    createCmd vault with vaultId; custodian; shareInstrument = vault.shareInstrument with id = vaultId
  pure env with vaultCid; vaultId; custodian

-- | Executors shared between vaults cannot fulfil one vault's request through another.
requestOfAnotherVaultIsRefused : Script ()
requestOfAnotherVaultIsRefused = script do
  env <- setup
  other <- anotherVault env "queued-2"
  (_, req) <- request other env.alice "r1" 100.0
  Left _ <- fulfilAs env env.venue [req]
  Right () <- fulfilAs other env.venue [req]
  tokens other (sharesId other) env.alice >>= (=== 100.0)

requesterAndExecutorsArchiveRequests : Script ()
requesterAndExecutorsArchiveRequests = script do
  env <- setup
  (_, r1) <- request env env.alice "r1" 100.0
  (_, r2) <- request env env.alice "r2" 50.0
  submit env.alice (exerciseCmd r1.requestCid Q.QueuedDepositRequest_Archive with actor = env.alice)
  submit env.venue (exerciseCmd r2.requestCid Q.QueuedDepositRequest_Archive with actor = env.venue)
  query @Q.QueuedDepositRequest env.alice >>= (=== []) . map snd

-- | A party shown a request cannot drop it.
strangerCannotArchiveARequest : Script ()
strangerCannotArchiveARequest = script do
  env <- setup
  (_, req) <- request env env.alice "r1" 100.0
  carol <- allocateParty "carol"
  rd <- fromSome <$> queryDisclosure env.registrar req.requestCid
  submitMustFail (actAs carol <> discloseMany [rd]) do
    exerciseCmd req.requestCid Q.QueuedDepositRequest_Archive with actor = carol

-- | A request record the executor signed itself, naming itself as registrar, is not the vault's.
executorCannotSignARequestAsRegistrar : Script ()
executorCannotSignARequestAsRegistrar = script do
  env <- setup
  (_, req) <- request env env.alice "r1" 100.0
  forgedAt <- getTime
  venues <- allocateWith env.shares env.venue (shareSpec env env.venue forgedAt) (settlementOf env) []
  forged <- submit env.venue do
    createCmd Q.QueuedDepositRequest with
      vaultId = env.vaultId; vaultRegistrar = env.venue; executors = [env.venue]
      requester = env.alice; receiver = env.venue; label = "r1"; assets = 100.0; anchor = coerceContractId req.requestCid
      underlyingAllocation = req.underlyingAllocation; shareAllocation = venues
      expiresAt = forgedAt; epoch = 0; minSharesOut = None
  failsWith "request.vaultRegistrar" =<<
    fulfilAs env env.venue [req with requestCid = forged; shareAllocation = venues]
  tokens env (sharesId env) env.venue >>= (=== 0.0)

-- Allocations the registries did not issue
--------------------------------------------

-- Batches
-----------

-- | Requests the party made under the label, as the vault recorded them.
requestsOf : Env -> Party -> Text -> Script [Req]
requestsOf env party label = do
  held <- query @Q.QueuedDepositRequest party
  pure [ Req with requestCid = cid; underlyingAllocation = r.underlyingAllocation; shareAllocation = r.shareAllocation
       | (cid, r) <- held, r.vaultId == env.vaultId, r.label == label ]

-- | Two requests under one label would collide when settled, so a batch holding both is refused; apart, each goes through.
aBatchRepeatingALabelIsRefused : Script ()
aBatchRepeatingALabelIsRefused = script do
  env <- setup
  _ <- request env env.alice "same" 10.0
  _ <- request env env.alice "same" 20.0
  [a, b] <- requestsOf env env.alice "same"
  failsWith "each request in the batch has its own label" =<< fulfilAs env env.venue [a, b]
  Right () <- fulfilAs env env.venue [a]
  Right () <- fulfilAs env env.venue [b]
  tokens env (sharesId env) env.alice >>= (=== 30.0)

emptyFulfilmentIsRefused : Script ()
emptyFulfilmentIsRefused = script do
  env <- setup
  failsWith "fulfils at least one request" =<< fulfilAs env env.venue []

-- Dust
--------

-- | The vault after a roll that finds a unit of yield in the pool, so a share costs two units.
withYield : Env -> Script Env
withYield env = do
  _ <- usdOf env env.custodian 1.0
  closeQueued env >>= openQueued env

-- | A deposit worth no share at the current rate is refused when requested.
dustRequestIsRefused : Script ()
dustRequestIsRefused = script do
  env <- withYield =<< setup
  failsWith "the deposit is worth shares at the current rate" =<< requestTerms env env.alice "r1" 0.0000000001 env.alice None

-- | A request worth a share when made but none at fulfilment is refused, and names itself.
requestWorthNothingAtFulfilmentIsRefused : Script ()
requestWorthNothingAtFulfilmentIsRefused = script do
  env <- setup
  (_, req) <- request env env.alice "r1" 0.0000000001
  next <- withYield env
  failsWith "each request mints a positive number of shares" =<< fulfilAs next env.venue [req]

-- Pending
-----------

-- | A party's pending deposits under a period's id: each of their live requests from that period, once. Not another
-- party's, another period's, another vault's, an expired one, or a record the registrar did not sign.
pendingCountsTheirRequestsOfThatPeriodOnce : Script ()
pendingCountsTheirRequestsOfThatPeriodOnce = script do
  env <- setup
  (first, r1) <- request env env.alice "r1" 100.0
  (_, r2) <- request env env.alice "r2" 20.0
  bob <- allocateParty "bob"
  (_, bobs) <- request env bob "b1" 50.0
  forgedAt <- getTime
  forged <- submit env.venue do
    createCmd Q.QueuedDepositRequest with
      vaultId = env.vaultId; vaultRegistrar = env.venue; executors = [env.venue]
      requester = env.alice; receiver = env.alice; label = "f1"; assets = 1000.0; anchor = coerceContractId r1.requestCid
      underlyingAllocation = r1.underlyingAllocation; shareAllocation = r1.shareAllocation
      expiresAt = addRelTime forgedAt (days 1); epoch = 0; minSharesOut = None
  other <- anotherVault env "queued-2"
  (_, elsewhere) <- request other env.alice "o1" 30.0
  next <- nextPeriod env
  (second, r3) <- request next env.alice "r3" 7.0
  (first, second) === (0, 1)
  let named = [r1.requestCid, r1.requestCid, r2.requestCid, bobs.requestCid, forged, elsewhere.requestCid, r3.requestCid]
  pending next first env.alice named >>= (=== 120.0)
  pending next second env.alice named >>= (=== 7.0)
  passTime (window + hours 2)
  pending next first env.alice named >>= (=== 0.0)

-- Cleanup
-----------

-- | Once a request's allocations have lapsed it can never be fulfilled, so the registrar may drop it.
registrarDropsAnExpiredRequest : Script ()
registrarDropsAnExpiredRequest = script do
  env <- setup
  (_, req) <- request env env.alice "r1" 10.0
  passTime (window + hours 2)
  submit env.registrar (exerciseCmd req.requestCid Q.QueuedDepositRequest_Archive with actor = env.registrar)
  query @Q.QueuedDepositRequest env.alice >>= (=== []) . map snd

-- | Until then the request is live, and the registrar cannot drop it; from its expiry, it can.
registrarCannotDropALiveRequest : Script ()
registrarCannotDropALiveRequest = script do
  env <- setup
  (_, req) <- request env env.alice "r1" 10.0
  Some r <- queryContractId env.registrar req.requestCid
  setTime (addRelTime r.expiresAt (microseconds (-1)))
  failsWith "or the registrar once it has expired" =<<
    trySubmit env.registrar (exerciseCmd req.requestCid Q.QueuedDepositRequest_Archive with actor = env.registrar)
  setTime r.expiresAt
  submit env.registrar (exerciseCmd req.requestCid Q.QueuedDepositRequest_Archive with actor = env.registrar)

-- | A request counts as pending up to, not at, its expiry.
pendingEndsAtExpiry : Script ()
pendingEndsAtExpiry = script do
  env <- setup
  (rid, req) <- request env env.alice "r1" 10.0
  Some r <- queryContractId env.registrar req.requestCid
  setTime (addRelTime r.expiresAt (microseconds (-1)))
  pending env rid env.alice [req.requestCid] >>= (=== 10.0)
  setTime r.expiresAt
  pending env rid env.alice [req.requestCid] >>= (=== 0.0)

-- | A request expires with its escrow, and the registrar may then drop it.
requestExpiresWithItsEscrow : Script ()
requestExpiresWithItsEscrow = script do
  env <- setup
  (_, req) <- request env env.alice "r1" 10.0
  passTime (window + hours 2)
  submit env.registrar (exerciseCmd req.requestCid Q.QueuedDepositRequest_Archive with actor = env.registrar)

-- Rejecting
-------------

rejectAs : Env -> Party -> [Req] -> Text -> Script (Either SubmitError ())
rejectAs env party requests reason = fmap (const ()) <$> rejectTreeAs env party requests reason

rejectTreeAs : Env -> Party -> [Req] -> Text -> Script (Either SubmitError TransactionTree)
rejectTreeAs env party requests reason = do
  now <- current env
  vd <- vaultDisclosure now
  locked <- lockedTokens env.usd (map (.underlyingAllocation) requests)
  trySubmitTree (actAs party <> discloseMany ([vd, env.usd.disclosure] <> locked)) do
    exerciseCmd now.vaultCid Q.ReferenceQueuedDepositVault_Reject with
      requestCids = map (.requestCid) requests
      reason
      underlyingExtraArgs = tokenArgs env.usd

unlockedUsd : Env -> Party -> Script Decimal
unlockedUsd env party = do
  held <- query @Token party
  pure (sum [h.holding.amount | (_, h) <- held, h.holding.instrumentId == usdId env, h.holding.lock == None])

-- | A rejected request returns its escrow and leaves a record of why.
rejectReturnsTheEscrow : Script ()
rejectReturnsTheEscrow = script do
  env <- setup
  (_, req) <- request env env.alice "r1" 100.0
  Right tree <- rejectTreeAs env env.venue [req] "receiver blocked"
  unlockedUsd env env.alice >>= (=== 100.0)
  query @Q.QueuedDepositRequest env.alice >>= (=== []) . map snd
  map (\e -> (e.label, e.requested, e.outcome)) (reported tree) === [("r1", 100.0, Q.Rejected with reason = "receiver blocked")]

rejectionByAnotherPartyIsRefused : Script ()
rejectionByAnotherPartyIsRefused = script do
  env <- setup
  (_, req) <- request env env.alice "r1" 100.0
  failsWith "requires authorizers" =<< rejectAs env env.alice [req] "changed my mind"

-- | Only the registrar's request records are rejected, so an executor cannot sign a rejection in its name.
rejectRefusesARecordTheRegistrarDidNotSign : Script ()
rejectRefusesARecordTheRegistrarDidNotSign = script do
  env <- setup
  (_, req) <- request env env.alice "r1" 100.0
  forgedAt <- getTime
  forged <- submit env.venue do
    createCmd Q.QueuedDepositRequest with
      vaultId = env.vaultId; vaultRegistrar = env.venue; executors = [env.venue]
      requester = env.alice; receiver = env.alice; label = "r1"; assets = 100.0; anchor = coerceContractId req.requestCid
      underlyingAllocation = req.underlyingAllocation; shareAllocation = req.shareAllocation
      expiresAt = forgedAt; epoch = 0; minSharesOut = None
  failsWith "request.vaultRegistrar" =<< rejectAs env env.venue [req with requestCid = forged] "forged"
  unlockedUsd env env.alice >>= (=== 0.0)

-- | One request that cannot settle fails its batch; the executors settle the rest and reject it.
aPoisonedRequestIsSplitOffAndRejected : Script ()
aPoisonedRequestIsSplitOffAndRejected = script do
  env <- setup
  (_, a) <- request env env.alice "a" 10.0
  (_, b) <- request env env.alice "b" 20.0
  (_, c) <- request env env.alice "c" 30.0
  _ <- submit (actAs env.venue <> discloseMany [env.shares.disclosure]) do
    exerciseCmd b.shareAllocation V2.Allocation_Cancel with actors = [env.venue]; extraArgs = tokenArgs env.shares
  Left _ <- fulfilAs env env.venue [a, b, c]
  Right () <- fulfilAs env env.venue [a, c]
  Right () <- rejectAs env env.venue [b] "share authorization withdrawn"
  tokens env (sharesId env) env.alice >>= (=== 40.0)
  unlockedUsd env env.alice >>= (=== 20.0)

-- Pricing by period
---------------------

-- | A request is filled only once the period it was made in has closed; its id is that period.
aRequestIsNotFilledInItsOwnPeriod : Script ()
aRequestIsNotFilledInItsOwnPeriod = script do
  env <- setup
  (first, req) <- request env env.alice "r1" 100.0
  failsWith "a request is filled after the period it was made in" =<< fulfilNow env env.venue [req]
  next <- nextPeriod env
  (second, _) <- request next env.alice "r2" 10.0
  (first, second) === (0, 1)
  Right () <- fulfilNow next env.venue [req]
  tokens env (sharesId env) env.alice >>= (=== 100.0)

-- | Adds yield to the pool, or takes the given amount out of it.
moveUsdPool : Env -> Decimal -> Script ()
moveUsdPool env delta
  | delta >= 0.0 = void (usdOf env env.custodian delta)
  | otherwise = do
      held <- query @Token env.custodian
      let pool = [(cid, h.holding.amount) | (cid, h) <- held, h.holding.instrumentId == usdId env, h.holding.lock == None]
      forA_ pool $ \(cid, _) -> submitMulti [env.custodian, env.usd.admin] [] (archiveCmd cid)
      void (usdOf env env.custodian (sum (map snd pool) + delta))

-- | Requests from one period fill at one price, however the executors order them and whatever lands in between.
requestsFromOnePeriodShareOnePrice : Script ()
requestsFromOnePeriodShareOnePrice = script do
  env <- setup
  bob <- allocateParty "bob"
  (_, a) <- request env env.alice "a" 100.0
  (_, b) <- request env bob "b" 50.0
  moveUsdPool env 1.0
  next <- nextPeriod env
  Right () <- fulfilNow next env.venue [a]
  moveUsdPool env 10.0
  Right () <- fulfilNow next env.venue [b]
  tokens env (sharesId env) env.alice >>= (=== 50.0)
  tokens env (sharesId env) bob >>= (=== 25.0)

-- | A vault holding 100 with 100 shares, and a 50 deposit requested in the period now open, priced at par when it closes.
withAPendingDeposit : Script (Env, Req)
withAPendingDeposit = do
  env <- setup
  (_, r0) <- request env env.alice "r0" 100.0
  Right () <- fulfilAs env env.venue [r0]
  (_, r1) <- request env env.alice "r1" 50.0
  next <- nextPeriod env
  pure (next, r1)

-- | Filled a period late after the price rose, a deposit gets the current price, not the cheaper struck one.
aLateFillAfterARiseGetsTheCurrentPrice : Script ()
aLateFillAfterARiseGetsTheCurrentPrice = script do
  (env, r1) <- withAPendingDeposit
  moveUsdPool env 101.0
  late <- nextPeriod env
  Right () <- fulfilNow late env.venue [r1]
  tokens env (sharesId env) env.alice >>= (=== 125.0)

-- | Filled a period late after the price fell, a deposit gets the struck price, not the cheaper current one.
aLateFillAfterAFallGetsTheStruckPrice : Script ()
aLateFillAfterAFallGetsTheStruckPrice = script do
  (env, r1) <- withAPendingDeposit
  moveUsdPool env (-50.5)
  late <- nextPeriod env
  Right () <- fulfilNow late env.venue [r1]
  tokens env (sharesId env) env.alice >>= (=== 150.0)

-- | A late fill needs the price struck for it, signed by the vault's registrar for this vault.
aLateFillNeedsItsOwnStruckPrice : Script ()
aLateFillNeedsItsOwnStruckPrice = script do
  (env, r1) <- withAPendingDeposit
  late <- nextPeriod env
  failsWith "no price struck for period 2" =<< fulfilAtTree late env.venue [r1] []
  forgedAt <- getTime
  forged <- submit env.venue do
    createCmd Q.PeriodPrice with
      vaultId = env.vaultId; vaultRegistrar = env.venue; executors = [env.venue]
      epoch = 2; totalShares = 100.0; totalAssets = 1.0; allotments = []
  failsWith "price.vaultRegistrar" =<< fulfilAtTree late env.venue [r1] [forged]
  other <- anotherVault env "queued-2"
  _ <- nextPeriod other
  _ <- nextPeriod other
  theirs <- pricesOf other
  failsWith "price.vaultId" =<< fulfilAtTree late env.venue [r1] theirs
  Right _ <- fulfilNowTree late env.venue [r1]
  pure ()

-- | Below its minimum a request is not filled, and the failure names it so the executors can reject it.
aRequestBelowItsMinimumIsNotFilled : Script ()
aRequestBelowItsMinimumIsNotFilled = script do
  env <- setup
  vd <- vaultDisclosure env
  forA_ [("high", 100.0), ("low", 40.0)] $ \(label, minimum) ->
    requestFor env env.alice env.alice label 100.0 (Some minimum)
  high <- requestOf env env.alice "high"
  low <- requestOf env env.alice "low"
  moveUsdPool env 1.0
  next <- nextPeriod env
  failsWith "VAULT_SLIPPAGE_EXCEEDED: request high" =<< fulfilNow next env.venue [high, low]
  Right () <- fulfilNow next env.venue [low]
  tokens env (sharesId env) env.alice >>= (=== 50.0)

-- | The queued vault holds its price limits: beyond them a roll needs the custodian, and still strikes its price.
aQueuedRollBeyondTheLimitsNeedsTheCustodian : Script ()
aQueuedRollBeyondTheLimitsNeedsTheCustodian = script do
  env <- setup
  vaultCid <- submit (actAs [env.registrar, env.custodian]) do
    exerciseCmd env.vaultCid Q.ReferenceQueuedDepositVault_SetPriceLimits with
      limits = PriceLimits with maxIncreaseBpsPerYear = 1000; maxDecreaseBps = 500
  let limited = env with vaultCid
  failsWith "requires authorizers" =<< trySubmit (actAs env.registrar) do
    exerciseCmd vaultCid Q.ReferenceQueuedDepositVault_SetPriceLimits with limits = PriceLimits with maxIncreaseBpsPerYear = 1; maxDecreaseBps = 1
  submitMustFail (actAs [env.registrar, env.custodian]) do
    exerciseCmd vaultCid Q.ReferenceQueuedDepositVault_SetPriceLimits with limits = PriceLimits with maxIncreaseBpsPerYear = 1; maxDecreaseBps = 10001
  moveUsdPool env 10.0
  closed <- closeQueued limited
  flows <- query @PeriodFlow env.registrar
  pool <- query @Token env.custodian
  now <- getTime
  let open beyond parties = trySubmit (actAs parties <> readAs env.custodian) $
        if beyond
          then exerciseCmd closed Q.ClosedQueuedPeriod_OpenBeyondLimits with
            flowCids = map fst flows; evidence = PoolHoldings ([toInterfaceContractId cid | (cid, t) <- pool, t.holding.instrumentId == usdId env])
            validUntil = addRelTime now (hours 1)
          else exerciseCmd closed Q.ClosedQueuedPeriod_Open with
            flowCids = map fst flows; evidence = PoolHoldings ([toInterfaceContractId cid | (cid, t) <- pool, t.holding.instrumentId == usdId env])
            validUntil = addRelTime now (hours 1)
  failsWith "the price rises within the vault's limit" =<< open False [env.registrar]
  failsWith "requires authorizers" =<< open True [env.registrar]
  Right opened <- open True [env.registrar, env.custodian]
  Some vault <- queryContractId env.registrar opened
  (vault.epoch, vault.totalAssets) === (1, 10.0)
  prices <- map snd <$> query @Q.PeriodPrice env.registrar
  map (\p -> (p.epoch, p.totalAssets)) prices === [(1, 10.0)]

-- | A fulfilment is reported to the requester and to the receiver they named.
fulfilmentIsReportedToRequesterAndReceiver : Script ()
fulfilmentIsReportedToRequesterAndReceiver = script do
  env <- setup
  bob <- allocateParty "bob"
  (_, req) <- requestFor env env.alice bob "r1" 100.0 None
  next <- nextPeriod env
  Right tree <- fulfilNowTree next env.venue [req]
  map (.observers) (exercisesOf @Q.QueueLog @Q.QueueLog_Report tree) === [[env.alice, bob]]
  tokens env (sharesId env) bob >>= (=== 100.0)


-- Allocation requests
-----------------------

-- | A request publishes, as the token standard's allocation request, exactly the allocations it needs: under its own
-- settlement, committed until the period's end plus the window.
requestPublishesTheAllocationsItNeeds : Script ()
requestPublishesTheAllocationsItNeeds = script do
  env <- setup
  Some vault <- queryContractId env.registrar env.vaultCid
  passTime (minutes 30)
  Right _ <- requestTerms env env.alice "r1" 10.0 env.alice None
  Right _ <- requestTerms env env.alice "r2" 10.0 env.alice None
  (cid, r) <- published env env.alice "r1"
  (_, other) <- published env env.alice "r2"
  assertMsg "each request has a settlement of its own" (r.settlement /= other.settlement)
  r.settlement === (settlementOf env) with cid = Some (toAnyContractId r.anchor)
  let deadline = Some (addRelTime vault.rateValidUntil window)
  Some v <- queryInterfaceContractId @AR.AllocationRequest env.alice (toInterfaceContractId @AR.AllocationRequest cid)
  (v.settlement, v.settleAt) === (r.settlement, Some vault.rateValidUntil)
  v.allocations ===
    [ V2.AllocationSpecification with
        admin = env.usd.admin; authorizer = basicAccount env.alice
        transferLegSides = [V2.TransferLegSide with
          transferLegId = requestLegId env.alice "r1" "underlying"; side = V2.SenderSide
          otherside = basicAccount env.custodian; amount = 10.0; instrumentId = "USD"; meta = emptyMetadata]
        settlementDeadline = deadline; nextIterationFunding = None; committed = True; meta = emptyMetadata
    , V2.AllocationSpecification with
        admin = env.registrar; authorizer = basicAccount env.alice; transferLegSides = []
        settlementDeadline = deadline; nextIterationFunding = Some TextMap.empty; committed = True; meta = emptyMetadata ]

-- | Only allocations made exactly as requested bind: the whole leg, metadata and all, the deadline, and the request's
-- own settlement, so an allocation made for one request binds no other.
onlyTheRequestedAllocationsBind : Script ()
onlyTheRequestedAllocationsBind = script do
  env <- setup
  Right _ <- requestTerms env env.alice "r1" 10.0 env.alice None
  Right _ <- requestTerms env env.alice "r2" 10.0 env.alice None
  (cid, r) <- published env env.alice "r1"
  (_, other) <- published env env.alice "r2"
  receiving <- authorizationAsRequested env r
  let funded spec settlement = do
        funds <- usdOf env env.alice 10.0
        allocateWith env.usd env.alice spec settlement [funds]
      tagged = Metadata with values = TextMap.fromList [("x", "y")]
  withMeta <- funded (r.escrow with transferLegSides = [leg with meta = tagged | leg <- r.escrow.transferLegSides]) r.settlement
  failsWith "'escrow' is not equal to 'requested'" =<< bindAs env env.venue cid withMeta receiving
  later <- funded (r.escrow with settlementDeadline = fmap (\d -> addRelTime d (days 1)) r.escrow.settlementDeadline) r.settlement
  failsWith "'escrow' is not equal to 'requested'" =<< bindAs env env.venue cid later receiving
  forOther <- funded other.escrow other.settlement
  failsWith "escrow.settlement" =<< bindAs env env.venue cid forOther receiving
  exact <- funded r.escrow r.settlement
  Right _ <- bindAs env env.venue cid exact receiving
  pure ()

-- | Allocations bind up to, not at, the end of the request's period, so none is made knowing the price.
allocationsBindBeforeThePeriodEnds : Script ()
allocationsBindBeforeThePeriodEnds = script do
  env <- setup
  Right _ <- requestTerms env env.alice "r1" 10.0 env.alice None
  Right _ <- requestTerms env env.alice "r2" 10.0 env.alice None
  (c1, r1) <- published env env.alice "r1"
  (c2, r2) <- published env env.alice "r2"
  e1 <- escrowAsRequested env r1; a1 <- authorizationAsRequested env r1
  e2 <- escrowAsRequested env r2; a2 <- authorizationAsRequested env r2
  setTime (addRelTime r1.fundBy (microseconds (-1)))
  Right _ <- bindAs env env.venue c1 e1 a1
  setTime r1.fundBy
  failsWith "rate period is still open" =<< bindAs env env.venue c2 e2 a2

-- | Only the executors bind, and only allocations their registries signed.
onlyExecutorsBindSignedAllocations : Script ()
onlyExecutorsBindSignedAllocations = script do
  env <- setup
  Right _ <- requestTerms env env.alice "r1" 10.0 env.alice None
  (cid, r) <- published env env.alice "r1"
  escrowed <- escrowAsRequested env r
  receiving <- authorizationAsRequested env r
  failsWith "requires authorizers" =<< bindAs env env.alice cid escrowed receiving
  fake <- fakeAllocation env.alice r.settlement r.escrow
  failsWith "escrow is signed by its registry" =<< bindAs env env.venue cid fake receiving

-- | A request left unfunded is dropped by the registrar once its period has ended, and not before.
unfundedRequestIsDroppedAfterItsPeriod : Script ()
unfundedRequestIsDroppedAfterItsPeriod = script do
  env <- setup
  Right _ <- requestTerms env env.alice "r1" 10.0 env.alice None
  (cid, r) <- published env env.alice "r1"
  setTime (addRelTime r.fundBy (microseconds (-1)))
  failsWith "the request's period has ended" =<< trySubmit env.registrar (exerciseCmd cid Q.RequestAllocations_Expire)
  setTime r.fundBy
  Right tree <- trySubmitTree env.registrar (exerciseCmd cid Q.RequestAllocations_Expire)
  map (.outcome) (reported tree) === [Q.Rejected with reason = "not funded in its period"]
  query @Q.RequestAnchor env.registrar >>= (=== []) . map snd

-- | The requester or the receiver may decline through the allocation request, and the executors withdraw it; a
-- stranger may do neither, and accepting only signals.
allocationRequestChoicesEndOrSignal : Script ()
allocationRequestChoicesEndOrSignal = script do
  env <- setup
  carol <- allocateParty "carol"
  let none = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
      ar cid = toInterfaceContractId @AR.AllocationRequest cid
  Right _ <- requestTerms env env.alice "r1" 10.0 env.alice None
  (c1, r1) <- published env env.alice "r1"
  _ <- submit env.alice (exerciseCmd (ar c1) AR.AllocationRequest_Accept with actors = [env.alice]; extraArgs = none)
  Some _ <- queryContractId env.alice c1
  failsWith "the requester or the receiver declines" =<< trySubmit (actAs [env.alice, carol]) do
    exerciseCmd (ar c1) AR.AllocationRequest_Reject with actors = [env.alice, carol]; extraArgs = none
  _ <- submit env.alice (exerciseCmd (ar c1) AR.AllocationRequest_Reject with actors = [env.alice]; extraArgs = none)
  queryContractId env.alice c1 >>= (=== None)
  Right _ <- requestTerms env env.alice "r2" 10.0 env.alice None
  (c2, _) <- published env env.alice "r2"
  failsWith "the executors withdraw" =<< trySubmit env.alice do
    exerciseCmd (ar c2) AR.AllocationRequest_Withdraw with actors = [env.alice]; extraArgs = none
  _ <- submit env.venue (exerciseCmd (ar c2) AR.AllocationRequest_Withdraw with actors = [env.venue]; extraArgs = none)
  queryContractId env.alice c2 >>= (=== None)
  query @Q.RequestAnchor env.registrar >>= (=== []) . map snd

-- | However a request ends, its settlement reference goes with it.
anchorsGoWithTheirRequests : Script ()
anchorsGoWithTheirRequests = script do
  env <- setup
  (_, filled) <- request env env.alice "r1" 10.0
  (_, rejected) <- request env env.alice "r2" 10.0
  (_, dropped) <- request env env.alice "r3" 10.0
  ready <- readyToFill env [filled]
  Right () <- fulfilNow ready env.venue [filled]
  Right () <- rejectAs ready env.venue [rejected] "receiver blocked"
  submit env.alice (exerciseCmd dropped.requestCid Q.QueuedDepositRequest_Archive with actor = env.alice)
  query @Q.RequestAnchor env.registrar >>= (=== []) . map snd

-- | A period rolled early has struck the next price, so allocations are no longer bound to its requests.
allocationsAreNotBoundAfterAnEarlyRoll : Script ()
allocationsAreNotBoundAfterAnEarlyRoll = script do
  env <- setup
  Right _ <- requestTerms env env.alice "r1" 10.0 env.alice None
  (cid, r) <- published env env.alice "r1"
  escrowed <- escrowAsRequested env r
  receiving <- authorizationAsRequested env r
  next <- nextPeriod env
  failsWith "allocations are bound in the request's own period" =<< bindAs next env.venue cid escrowed receiving
